#!/usr/bin/env python3
"""agentbox — the native (non-NixOS) configuration layer. Issue #154, Phase 4.

On NixOS the module renders units, sudoers, tmpfiles and the Caddyfile from
one option tree and nixos-rebuild switches to them atomically. On a stock
Ubuntu/RHEL host there is no such tree, so this CLI owns that layer:

    agentbox apply [--config /etc/agent-box/config.yaml]

reads the config and renders the same host state, idempotently — nothing is
rewritten when it already matches, so a re-apply is silent and safe. The
software itself comes from the Nix profile built by nix/runtime.nix, which
is also where the shared assets (the %i template units, the Caddyfile
fragments, the guides) are read from. Two hard rules from the design in
issue #154:

  * `agentbox apply` NEVER calls apt or dnf. The distro package manager
    stays responsible for base-OS security patching only.
  * The shared assets are installed byte-for-byte. Anything host-specific
    goes in a generated env file or a drop-in, never in the unit text.

`agentbox apply --first-boot` additionally absorbs what the CloudFormation
templates used to do inline: settle the public IP, derive the sslip.io
hostname, hash the web password, and signal the stack's WaitCondition.

    agentbox update

is the native half of the self-update path (issue #358). NixOS rewrites a
pin file and runs nixos-rebuild; here the software IS the Nix profile, so
updating means fast-forwarding that profile to a newer rev of this repo and
re-applying. It is what agent-box-update.service runs, which is in turn what
the agents' sudo rule and the settings page's Update button trigger.

Render to a tree instead of the live host with `--root DIR` (implies no
useradd/systemctl); that is what tests/test_agentbox.py diffs against a
committed expectation, and it is the native half of the Phase 5 spec
comparison.
"""

import argparse
import contextlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

# --------------------------------------------------------------------------
# Config
# --------------------------------------------------------------------------

USER_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
# ttyd ports are assigned in sorted user order, exactly as the module does,
# so a user added later cannot renumber an existing user's port.
TTYD_PORT_BASE = 7681

DEFAULT_CONFIG = "/etc/agent-box/config.yaml"

# The self-update unit (issue #358). `agentbox apply` renders it but never
# enables or starts it: it is on-demand only, triggered through the sudo
# rule below or by the settings page's Update button. The trigger command
# is spelled ONCE here because three places have to agree on it byte for
# byte — the sudoers line, the AGENT_BOX_UPDATE_CMD the settings daemon
# execs, and the paragraph the shipped guide tells the agent to run. A
# mismatch between any two of them is issue #353 all over again (a grant
# that does not match the command asks for a password instead).
UPDATE_UNIT = "agent-box-update.service"
SYSTEMCTL = "/usr/bin/systemctl"
UPDATE_TRIGGER = f"{SYSTEMCTL} start --no-block {UPDATE_UNIT}"
# Store housekeeping (issue #394). A full root wedges the whole box —
# no journal, no profile swap, and an agent that cannot write — and on a
# native box nobody is around to run `nix-collect-garbage` by hand. The
# NixOS deployments get this from their host configuration (aws/template.yaml
# sets nix.gc + min-free/max-free); a native box has no such layer, so the
# renderer owns it. Same policy as that config, deliberately: a store that
# behaves differently depending on how the box was deployed is a support
# question nobody can answer from the outside.
GENERATED_HEADER = "# Generated by `agentbox apply` — do not edit.\n"
CLAUDE_SETTINGS = "/etc/agent-box/claude-hook-settings.json"
# Memory protection (issue #62, #394 gap 9). Names match the module's
# pieces, prefixed because these are OUR units on a distro that may have
# its own: Ubuntu ships systemd-oomd enabled, and two OOM daemons racing
# under pressure is worse than either alone.
ZRAM_UNIT = "agent-box-zram.service"
EARLYOOM_UNIT = "agent-box-earlyoom.service"
ZRAM_HELPER = "/etc/agent-box/bin/agent-box-zram"
MEMORY_SYSCTL = "/etc/sysctl.d/60-agent-box-memory.conf"
# systemd-oomd is the DISTRO's OOM daemon, not ours, and it races earlyoom.
OOMD_UNIT = "systemd-oomd.service"
# Written only when apply itself disabled an oomd that was enabled, so
# turning protectMemory back off can hand the box back the daemon it had —
# and touch nothing on a box where an admin had already disabled or masked
# it themselves.
OOMD_STAMP = "/etc/agent-box/oomd-disabled-by-agentbox"
# NixOS's earlyoom module defaults, so both backends kill at the same
# thresholds: -m/-s are percentages of free RAM/swap, -r the report
# interval. The patterns are the module's own extraArgs — comm names,
# truncated by the kernel to 15 chars, hence "amazon-ssm-agen".
EARLYOOM_ARGS = [
    "-m", "10", "-s", "10", "-r", "3600",
    "--avoid",
    "^(sshd|systemd|systemd-.*|caddy|ttyd|tmux.*|amazon-ssm-agen|ssm-.*"
    "|nix-daemon)$",
    "--prefer", "^(node|claude|codex)$",
]
FAIL2BAN_UNIT = "agent-box-fail2ban.service"
FAIL2BAN_DIR = "/etc/agent-box/fail2ban"
FAIL2BAN_JAIL = "agent-web-auth"
NIX_GC_UNIT = "agent-box-nix-gc.service"
NIX_GC_TIMER = "agent-box-nix-gc.timer"
NIX_GC_AGE = "7d"
NIX_PROFILE_BIN = "/nix/var/nix/profiles/default/bin"
# Base-OS patching, unattended and reboot-free. `agentbox apply` still never
# CALLS apt — the distro keeps owning its own packages — but on this box
# nobody is there to answer the two questions an unattended patch run asks:
# "may I restart this service?" and "may I reboot?". There is no operator at
# a console, an agent has no reboot grant, and on a Spot/Lightsail box the
# only human who could reboot is wherever the cloud console is. Leaving both
# unanswered is the worst outcome: the patch is installed, the vulnerable
# code keeps running in a daemon nobody restarted, and /var/run/reboot-
# required grows a file nobody reads. So the answers are written down.
#
# 52-, so it sorts after Ubuntu's own 20auto-upgrades and
# 50unattended-upgrades and wins on the keys it repeats. Allowed-Origins is
# deliberately NOT among them: which pockets are security pockets is the
# distro's call (Ubuntu's own file lists -security plus the two ESM ones),
# and an apt list assignment appends rather than replaces, so restating it
# here could only duplicate or — with a #clear — silently narrow it.
APT_CONF = "/etc/apt/apt.conf.d/52-agent-box-unattended"
NEEDRESTART_CONF = "/etc/needrestart/conf.d/50-agent-box.conf"
# HH:MM, the only form unattended-upgrades' Automatic-Reboot-Time accepts
# besides "now" (which reboots the moment a patch lands — never what a box
# running an agent's work wants).
REBOOT_TIME_RE = re.compile(r"^([01][0-9]|2[0-3]):[0-5][0-9]$")
# The flake output the runtime profile is installed from, and the element
# name `nix profile` records it under.
RUNTIME_ATTR = "runtime"
GITHUB_API = "https://api.github.com"
REV_RE = re.compile(r"^[0-9a-f]{40}$")


class ConfigError(Exception):
    pass


def load_config(path):
    """Load config.yaml (or .json).

    YAML needs PyYAML, which the runtime profile ships. JSON needs nothing,
    so a box can be configured from cloud-init with no parser question at
    all; both spell the same structure.
    """
    text = Path(path).read_text()
    if path.endswith(".json"):
        return json.loads(text)
    try:
        import yaml
    except ImportError:
        raise ConfigError(
            f"{path} is YAML but PyYAML is not importable. Install the "
            "runtime profile (which ships it), or use a .json config."
        )
    data = yaml.safe_load(text)
    if not isinstance(data, dict):
        raise ConfigError(f"{path}: top level must be a mapping")
    return data


def profile_manifest(profile):
    """What the installed runtime profile records about its own origin.

    A Nix profile generation is a store path containing manifest.json, so
    this is a plain file read — no `nix` invocation, no daemon, and it works
    inside `--root` renders and tests. Returns None when there is no
    manifest (a plain-directory install, or a test fixture).
    """
    try:
        data = json.loads((Path(profile) / "manifest.json").read_text())
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def manifest_element(manifest, attr=RUNTIME_ATTR):
    """(name, element) for the runtime entry in a profile manifest.

    Two shapes in the wild: nix >= 2.20 keys `elements` by name, older
    versions make it a list addressed by index. `nix profile remove` takes
    exactly that name-or-index, so both are returned as a string usable as
    an argument.
    """
    if not manifest:
        return None, None
    elements = manifest.get("elements")
    if isinstance(elements, dict):
        items = list(elements.items())
    elif isinstance(elements, list):
        items = [(str(i), e) for i, e in enumerate(elements)]
    else:
        return None, None
    for name, element in items:
        if not isinstance(element, dict):
            continue
        if name == attr or str(element.get("attrPath", "")).endswith(
                f".{attr}"):
            return name, element
    # A single-element profile that names itself something else is still
    # unambiguous — this profile only ever holds the runtime.
    if len(items) == 1 and isinstance(items[0][1], dict):
        return items[0]
    return None, None


def parse_flake_url(url):
    """github:owner/repo[/ref] -> ("owner/repo", "<40-hex rev>" or None).

    Only a locked URL carries a rev; `originalUrl` on a branch-tracking box
    is the bare `github:owner/repo` (or a branch name, which is a ref and
    not a rev). Anything that is not a github: flake yields (None, None) —
    the caller then asks for --repo rather than guessing.
    """
    if not url or not url.startswith("github:"):
        return None, None
    parts = url[len("github:"):].split("/")
    if len(parts) < 2 or not parts[0] or not parts[1]:
        return None, None
    repo = f"{parts[0]}/{parts[1]}"
    rev = parts[2] if len(parts) > 2 and REV_RE.match(parts[2]) else None
    return repo, rev


# Where nix/runtime.nix installs the pinned local-webhook, and the pin it was
# fetched with (issue #425). Both are profile-relative, so they follow a
# profile update the way every other native payload does.
WEBHOOK_ASSET_DIR = ("share", "agent-box", "local-webhook")


def profile_webhook_script(profile):
    """The pinned webhook.py inside the profile, or "" if this profile has
    none (a pre-#425 profile was built with no pin, so it shipped no webhook
    payloads at all — claiming a script that is not there would render a
    receiver unit around a missing file)."""
    if not profile:
        return ""
    path = Path(profile).joinpath(*WEBHOOK_ASSET_DIR, "webhook.py")
    return str(path) if path.exists() else ""


def profile_webhook_pin(profile):
    """The pin that script was fetched with: {repo, rev, sha256}.

    The supervisor needs the MARKETPLACE repo to pin claude's local-webhook
    plugin, and this renderer cannot evaluate Nix — so runtime.nix ships the
    pin as data beside the script, and nix/webhook-pin.nix stays its one home.
    """
    if not profile:
        return {}
    path = Path(profile).joinpath(*WEBHOOK_ASSET_DIR, "pin.json")
    try:
        with path.open(encoding="utf-8") as fh:
            pin = json.load(fh)
    except (OSError, ValueError):
        return {}
    return pin if isinstance(pin, dict) else {}


def profile_origin(profile):
    """(repo, rev) the runtime profile was actually installed from.

    The profile is the ground truth for "what rev is this box running", and
    the reason `Spec` does not need a `repo:`/`rev:` config field for it
    (issue #358's second open question). config.yaml as written by
    aws/lightsail-template.yaml sets neither, so before this the
    settings page advertised the placeholder defaults — a repo that happened
    to be right and a rev of forty zeroes — on every native box.
    """
    name, element = manifest_element(profile_manifest(profile))
    if not element:
        return None, None
    repo, rev = parse_flake_url(element.get("url") or element.get("uri"))
    if not repo:
        repo, _ = parse_flake_url(
            element.get("originalUrl") or element.get("originalUri"))
    return repo, rev


class Spec:
    """The validated, defaulted view of config.yaml the renderer reads."""

    def __init__(self, data, profile):
        self.profile = profile
        self.domain = data.get("domain") or ""
        self.host_label = data.get("hostLabel") or self.domain or "agent-box"
        # Whether the label was pinned in config, or fell back to the domain
        # above. first_boot resolves an "auto"/"" domain AFTER the spec is
        # built, so a derived label has to be carried forward with the
        # resolved domain — otherwise it stays frozen at the placeholder.
        self.host_label_from_domain = not data.get("hostLabel")
        self.agents = list(data.get("agents") or ["claude"])
        self.default_agent = data.get("defaultAgent") or self.agents[0]
        # Where this box's software came from. The profile's own manifest
        # wins over the config: a `repo:`/`rev:` key can disagree with what
        # is actually installed (and on a template-launched box there is no
        # such key at all), while the manifest cannot — `agentbox update`
        # rewrites it as part of switching.
        origin_repo, origin_rev = profile_origin(profile)
        self.repo = origin_repo or data.get("repo") or "defangdevs/agent-box"
        self.rev = origin_rev or data.get("rev") or "0" * 40
        # Webhooks (issue #425). The profile ships the pinned webhook.py and
        # the pin it came from, so a box needs NO webhook config at all: the
        # script is the profile's copy, the marketplace repo comes from the
        # pin beside it, and `enable` defaults true exactly as the module's
        # option does. Before this, `webhook.repo` + `webhook.script` had to
        # be declared by hand — the Lightsail template declares neither, so
        # every box it launched had webhooks silently off while the NixOS
        # template had them on.
        #
        # A config value still wins, for a box pinned to its own copy. An
        # older profile with no asset leaves the script empty, and webhooks
        # stay off rather than rendering units around a missing file.
        wh = data.get("webhook") or {}
        webhook_enable = wh.get("enable", True)
        # A quoted "false" would otherwise pass bool()'s truthiness check
        # and enable webhooks anyway — same trap as codexFullAccess above
        # (issue #404 review). null still means off, same as bool(None).
        if webhook_enable is not None and not isinstance(
                webhook_enable, bool):
            raise ConfigError(
                "webhook.enable must be true, false or null, got "
                f"{webhook_enable!r}")
        pin = profile_webhook_pin(profile)
        self.webhook_repo = wh.get("repo") or pin.get("repo") or ""
        self.webhook_script = (wh.get("script")
                               or profile_webhook_script(profile) or "")
        self._webhook_enable = bool(webhook_enable)
        web = data.get("web") or {}
        web_enable = web.get("enable", True)
        # Same trap, same fix (CodeRabbit finding on PR #431): web.enable
        # now gates webhook_enable too, so a quoted "false" here would
        # silently turn webhooks loose as well. null still means off.
        if web_enable is not None and not isinstance(web_enable, bool):
            raise ConfigError(
                f"web.enable must be true, false or null, got {web_enable!r}")
        self.web_enable = bool(web_enable)
        self.protect_memory = bool(data.get("protectMemory", True))
        # Base-OS patching (see APT_CONF). Default on, because the failure
        # it prevents is silent: an unattended patch run that installs a
        # fix and restarts nothing looks exactly like one that worked.
        # Written as apt + needrestart policy, so a host whose package
        # manager is neither (RHEL, and its own dnf-automatic) should set
        # `osUpdates: {enable: false}` rather than collect two inert files.
        # `or {}` would be the trap in its most direct form: it folds
        # `osUpdates: false` — the obvious way to write "off" — into an
        # empty mapping, whose `enable` then defaults to TRUE, so the one
        # spelling that means "do not touch my box's patching" is the one
        # that turns it on (CodeRabbit on PR #453). Only an absent key is
        # absent; anything else has to be a mapping, and the message names
        # the spelling that works.
        os_updates = data.get("osUpdates")
        if os_updates is None:
            os_updates = {}
        if not isinstance(os_updates, dict):
            raise ConfigError(
                f"osUpdates must be a mapping, got {os_updates!r} — to turn "
                "base-OS patch policy off, write `osUpdates: {enable: false}`")
        os_updates_enable = os_updates.get("enable", True)
        # The quoted-"false" trap the other booleans here already guard
        # against (issue #404 review): a string is truthy, so `enable:
        # "false"` would turn the thing ON. null still means off.
        if os_updates_enable is not None and not isinstance(
                os_updates_enable, bool):
            raise ConfigError(
                "osUpdates.enable must be true, false or null, got "
                f"{os_updates_enable!r}")
        self.os_updates_enable = bool(os_updates_enable)
        # Off by default: nobody on this box can perform a reboot, but a
        # box that reboots ITSELF at an arbitrary moment is worse — it
        # takes every live agent session with it. A deployment that would
        # rather have a current kernel than a long-lived session gives a
        # time, and gets a reboot only at that time.
        reboot = os_updates.get("automaticReboot", False)
        if reboot is True:
            raise ConfigError(
                "osUpdates.automaticReboot must be a \"HH:MM\" time, not "
                "true — `true` alone means unattended-upgrades' \"now\", "
                "which reboots the moment a kernel patch lands")
        if reboot not in (False, None) and not (
                isinstance(reboot, str) and REBOOT_TIME_RE.match(reboot)):
            raise ConfigError(
                "osUpdates.automaticReboot must be false or a \"HH:MM\" "
                f"time, got {reboot!r}")
        self.os_updates_reboot = reboot or ""
        # Codex autonomy for the WHOLE box (issue 234). Default true, as
        # the module's option is: the box IS the sandbox, and an agent that
        # stops to ask a human is a stalled agent. Meaningless without
        # codex installed, so it follows the agent list.
        # Extra agent-CLI arguments for the hook-* sessions a standing
        # watch spawns — the classic use is a cheaper model for triage
        # (issue #216). Same shape as the module's option: a list of
        # strings, exported as JSON because webhook-spawn.sh parses it with
        # jq and a value may contain spaces.
        webhook_cfg = data.get("webhook") or {}
        hook_session_args = webhook_cfg.get("hookSessionArgs")
        # A string here would otherwise pass straight through list() as
        # one character per element — jq would parse each as its own
        # argument, silently garbling the hook session's command line
        # (issue #404 review).
        if hook_session_args is not None and not (
                isinstance(hook_session_args, list)
                and all(isinstance(a, str) for a in hook_session_args)):
            raise ConfigError(
                "webhook.hookSessionArgs must be a list of strings, got "
                f"{hook_session_args!r}")
        self.hook_session_args = list(hook_session_args or [])
        codex_full_access = data.get("codexFullAccess", True)
        # A quoted "false" would otherwise pass bool()'s truthiness check
        # and turn codex loose with danger-full-access — a string typo
        # silently granting the one thing this knob exists to gate
        # (issue #404 review). null still means off, same as bool(None):
        # only a type this config format has no business carrying is
        # rejected.
        if codex_full_access is not None and not isinstance(
                codex_full_access, bool):
            raise ConfigError(
                "codexFullAccess must be true, false or null, got "
                f"{codex_full_access!r}")
        self.codex_full_access = (
            bool(codex_full_access) and "codex" in self.agents)
        self.sudo_allowlist = list(data.get("sudoAllowlist") or [])
        # Where a lazily installed harness comes from (issue #416). The
        # NixOS module reuses selfUpdate.agentNixpkgs — the pin its update
        # service already maintains — so both halves stay on one revision;
        # a native box has no such pin, so the channel that pin tracks is
        # the default and `jitNixpkgs:` overrides it. Deliberately NOT the
        # flake registry's `nixpkgs`, which follows nixpkgs-unstable and was
        # measured resolving gh 2.98.0 on a box shipping 2.97.0.
        self.jit_nixpkgs = (
            data.get("jitNixpkgs")
            or "https://channels.nixos.org/nixos-unstable/nixexprs.tar.xz")

        if self.default_agent not in self.agents:
            raise ConfigError(
                f"defaultAgent {self.default_agent!r} is not in agents "
                f"{self.agents!r}"
            )

        users = data.get("users") or {}
        if not users:
            raise ConfigError("config must define at least one user")
        self.users = []
        for name in sorted(users):
            if not USER_RE.match(name):
                raise ConfigError(f"invalid user name {name!r}")
            self.users.append(User(name, users[name] or {}, self))
        # The settings page / root vhost belongs to exactly one user: the one
        # flagged root, else the first in sorted order (same rule as the
        # module's rootUser).
        flagged = [u for u in self.users if u.want_root]
        if len(flagged) > 1:
            raise ConfigError(
                "at most one user may set root: true, got "
                + ", ".join(u.name for u in flagged)
            )
        self.root_user = flagged[0] if flagged else self.users[0]
        for i, u in enumerate(self.users):
            if u.ttyd_port is None:
                u.ttyd_port = TTYD_PORT_BASE + i

    @property
    def webhook_enable(self):
        return bool(self._webhook_enable and self.web_enable
                    and self.webhook_repo and self.webhook_script)


class User:
    def __init__(self, name, data, spec):
        self.name = name
        self.spec = spec
        self.home = data.get("home") or f"/home/{name}"
        self.agent = data.get("agent") or spec.default_agent
        self.ttyd_port = data.get("ttydPort")
        self.want_root = bool(data.get("root"))
        self.environment = dict(data.get("environment") or {})
        self.environment_files = list(data.get("environmentFiles") or [])
        sessions = data.get("sessions")
        if sessions is None:
            # Seed nothing when this user has a WEB FRONT DOOR (issue #416):
            # the settings page is where a session is started, which is what
            # lets the agent CLIs be fetched on demand instead of shipped.
            # Without a front door "main" is seeded as before, because a box
            # with neither a settings page nor a session has no way in but
            # the console. `seedMainSession:` overrides either way; an
            # explicit `sessions:` (including {}) always wins outright.
            # Mirrors seedMain in modules/agent-box.nix.in — the two
            # backends must answer this the same way.
            seed_main = data.get("seedMainSession")
            if seed_main is not None and not isinstance(seed_main, bool):
                raise ConfigError(
                    "seedMainSession must be true, false or null, got "
                    f"{seed_main!r}")
            if seed_main is None:
                # spec.web_enable alone IS the native equivalent of the
                # module's `cfg.web.enable && u.web.passwordHashFile != null`.
                # Native has no per-user opt-out to mirror: `web` is a
                # box-level setting, there is no per-user passwordHashFile
                # field, and user_env provisions AGENT_BOX_PASSWORD_CMD for
                # EVERY user once the box's web is on. So the module's
                # condition degenerates to cfg.web.enable for every config
                # native can express, and testing more here would be testing
                # a state the schema cannot reach.
                seed_main = not spec.web_enable
            sessions = {"main": {"agent": self.agent}} if seed_main else {}
        self.sessions = sessions
        for sname, s in sorted(self.sessions.items()):
            agent = (s or {}).get("agent") or self.agent
            if agent not in spec.agents:
                raise ConfigError(
                    f"user {name}: session {sname!r} uses agent {agent!r}, "
                    f"which is not in agents {spec.agents!r}"
                )

    @property
    def url(self):
        return f"https://{self.spec.domain}/{self.name}/"

    @property
    def env_key(self):
        """The suffix caddy env placeholders use: uppercase, _ for -."""
        return self.name.upper().replace("-", "_")


# --------------------------------------------------------------------------
# Rendering
# --------------------------------------------------------------------------

class Tree:
    """Files, directories and symlinks to put on the host.

    Collected first and written second so a render can be inspected
    (`--dry-run`), diffed in a test (`--root`), and applied atomically per
    file, with "what actually changed" reported rather than guessed.
    """

    def __init__(self):
        self.files = {}      # path -> (text, mode)
        self.dirs = []       # (path, mode, owner, group)
        self.links = []      # (link, target)
        # Paths a PREVIOUS render owned and this one does not. apply
        # deletes only files still carrying our generated header.
        self.remove = []
        self.units = []      # unit names to enable
        self.disable = []    # unit names to disable

    def file(self, path, text, mode=0o644):
        self.files[str(path)] = (text, mode)

    def dir(self, path, mode=0o755, owner="root", group="root"):
        self.dirs.append((str(path), mode, owner, group))

    def link(self, link, target):
        self.links.append((str(link), str(target)))

    def gone(self, path):
        self.remove.append(str(path))


def env_file(pairs):
    """Render an EnvironmentFile. Keys sorted for a stable diff."""
    return "".join(f"{k}={v}\n" for k, v in pairs if v not in (None, ""))


def dropin(section_lines):
    return "[Unit]\n\n[Service]\n" + "".join(f"{l}\n" for l in section_lines)


class Renderer:
    def __init__(self, spec, profile, root=Path("/"), config=DEFAULT_CONFIG):
        self.spec = spec
        self.profile = Path(profile)
        self.root = Path(root)
        self.bin = self.profile / "bin"
        self.share = self.profile / "share" / "agent-box"
        # Carried into agent-box-update.service's ExecStart: an update
        # re-applies the SAME config this apply was driven by, so a box
        # configured from a non-default path keeps working after it.
        # Absolute, because a unit runs with WorkingDirectory=/ — a relative
        # `--config config.yaml` on the apply command line would render an
        # ExecStart that only fails when someone finally triggers an update.
        self.config = os.path.abspath(str(config))
        # Things the render decided NOT to do, and why. A renderer that
        # skips a file to avoid clobbering someone's edit has to SAY so:
        # a silently-skipped setting looks identical to one that was never
        # implemented, which is how nobody notices for a year.
        self.notes = []

    def p(self, *parts):
        """A path inside the render root (so --root DIR renders a tree)."""
        return self.root / Path(*parts).relative_to("/")

    def render(self):
        t = Tree()
        self.dirs(t)
        self.shared_units(t)
        self.update_unit(t)
        self.nix_gc(t)
        if self.spec.os_updates_enable:
            self.os_updates(t)
        else:
            self.os_updates_off(t)
        self.per_user(t)
        self.sudoers(t)
        self.tmpfiles(t)
        self.target_wants(t)
        self.interactive_clis(t)
        self.agent_defaults(t)
        if self.spec.protect_memory:
            self.memory_protection(t)
        else:
            self.memory_protection_off(t)
        if self.spec.web_enable:
            self.caddy(t)
            self.fail2ban(t)
        return t

    # -- agent defaults ------------------------------------------------------

    def agent_defaults(self, t):
        """The two files the agent CLIs themselves read (issue #394).

        claude: a settings file carrying the SessionStart hook, which is how
        a respawned session finds the segment-rotation record (issue #223).
        supervisor.sh passes it with --settings, and only when
        AGENT_BOX_CLAUDE_SETTINGS names one — so on a native box that hook
        never fired.

        codex: /etc/codex/config.toml, codex's SYSTEM layer, below the
        user's own ~/.codex/config.toml. It is the only way to reach the
        app-server daemon serving remote-controlled sessions, which is
        spawned with a fixed argv and never sees the supervisor's -c
        overrides. Both keys are required: sandbox_mode alone opens the
        filesystem and network but leaves approval_policy at "on-request".
        """
        if "claude" in self.spec.agents:
            hook = self.bin / "agent-box-claude-session-start-hook"
            settings = {"hooks": {"SessionStart": [
                {"hooks": [{"type": "command", "command": str(hook)}]}]}}
            t.file(self.p(CLAUDE_SETTINGS),
                   json.dumps(settings, indent=2, sort_keys=True) + "\n")
        codex_conf = self.p("/etc/codex/config.toml")
        if self.spec.codex_full_access:
            t.dir(self.p("/etc/codex"), 0o755)
            t.file(codex_conf,
                   GENERATED_HEADER
                   + 'approval_policy = "never"\n'
                   'sandbox_mode = "danger-full-access"\n')
        else:
            # Turning the option OFF has to take the file with it. apply
            # never deletes what a render stops emitting, so without this
            # a box flipped from true to false kept
            # sandbox_mode = "danger-full-access" on disk while
            # AGENT_BOX_CODEX_FULL_ACCESS disappeared — full access still
            # in force, and the flag a session uses to pin the restricted
            # values back gone with it. Exactly the contract this pair
            # exists to keep, inverted.
            t.gone(codex_conf)

    # -- memory protection ---------------------------------------------------

    def memory_protection(self, t):
        """zram, earlyoom and the sysctls that make them work (#394 gap 9).

        The incident this exists for (issue #62): a swapless box under
        agent memory pressure never OOM-killed. It thrashed the page cache
        instead — every fault reading pages straight back off disk — and
        the whole userspace froze for hours while the health checks stayed
        green. Nothing was out of memory; everything was too slow to say
        so.

        Natively this was one knob of the three: OOMScoreAdjust told the
        kernel WHICH process to kill in a situation the kernel was never
        going to notice. The module has had all of it since #62; the
        binary for the missing part has been sitting in the runtime
        profile unused.

        zram gives reclaim somewhere to go that is not the disk. earlyoom
        acts where the kernel OOM killer would not — free RAM and free
        swap both under 10% — and prefers the agent CLIs, whose unit
        restarts them, over the management plane and the tmux server that
        every session lives in.
        """
        t.dir(self.p("/etc/agent-box/bin"), 0o755)
        t.file(self.p(ZRAM_HELPER), "".join(line + "\n" for line in [
            "#!/bin/sh",
            "# Generated by `agentbox apply` — do not edit.",
            "# A script, not an ExecStart one-liner: the device name is",
            "# discovered at setup and has to be found again at teardown.",
            "set -eu",
            'dev_file=/run/agent-box-zram.device',
            'case "${1:-start}" in',
            "  start)",
            "    modprobe zram",
            # memoryPercent 100, as the module sets: the cap is on
            # UNCOMPRESSED bytes, and at zstd's ~3:1 a full device costs
            # about a third of RAM, so this doubles headroom rather than
            # spending it.
            "    size=$(awk '/^MemTotal:/ {print $2 * 1024}' /proc/meminfo)",
            '    dev=$(zramctl --find --size "$size" --algorithm zstd)',
            '    printf %s "$dev" > "$dev_file"',
            '    mkswap "$dev" >/dev/null',
            # Priority above any disk swap the deployment made (the
            # Lightsail template writes a 2 GiB file): compressed RAM
            # first, disk only when that fills.
            '    swapon --priority 100 "$dev"',
            "    ;;",
            "  stop)",
            '    [ -r "$dev_file" ] || exit 0',
            '    dev=$(cat "$dev_file")',
            # No `|| true`: `set -e` is what makes this safe. A failed
            # swapoff or reset stops the script before the rm below, so
            # the device stays on record — deleting it on a teardown that
            # did not actually happen is how a still-active zram swap
            # loses the only file naming which device it is (issue #404
            # review).
            '    swapoff "$dev"',
            '    zramctl --reset "$dev"',
            '    rm -f "$dev_file"',
            "    ;;",
            "esac",
        ]), 0o755)
        path = ":".join([str(self.bin), "/usr/sbin", "/usr/bin",
                         "/sbin", "/bin"])
        t.file(self.p("/etc/systemd/system", ZRAM_UNIT), "".join(
            line + "\n" for line in [
                "# Generated by `agentbox apply` — do not edit.",
                "[Unit]",
                "Description=agent-box: compressed swap in RAM (zram)",
                "After=systemd-modules-load.service",
                "",
                "[Service]",
                "Type=oneshot",
                "RemainAfterExit=yes",
                f"Environment=PATH={path}",
                f"ExecStart={ZRAM_HELPER} start",
                f"ExecStop={ZRAM_HELPER} stop",
                "",
                "[Install]",
                "WantedBy=multi-user.target",
            ]))
        t.units.append(ZRAM_UNIT)
        t.file(self.p("/etc/systemd/system", EARLYOOM_UNIT), "".join(
            line + "\n" for line in [
                "# Generated by `agentbox apply` — do not edit.",
                "[Unit]",
                "Description=agent-box: early OOM daemon",
                # After zram, so its first look at free swap sees the
                # device this box actually runs with.
                f"After={ZRAM_UNIT}",
                "",
                "[Service]",
                "Type=simple",
                f"ExecStart={self.bin}/earlyoom "
                + " ".join(shlex.quote(a) for a in EARLYOOM_ARGS),
                "Restart=always",
                "RestartSec=5s",
                # It must survive what it is there to arbitrate.
                "OOMScoreAdjust=-100",
                "",
                "[Install]",
                "WantedBy=multi-user.target",
            ]))
        t.units.append(EARLYOOM_UNIT)
        t.dir(self.p("/etc/sysctl.d"), 0o755)
        t.file(self.p(MEMORY_SYSCTL),
               "# Generated by `agentbox apply` — do not edit.\n"
               # Swap early and eagerly: compressed swap is far cheaper
               # than dropping hot page cache, which is what the #62 box
               # was doing instead of admitting it was out of memory.
               "vm.swappiness = 180\n"
               # No readahead on swap faults — meaningless on a RAM
               # -backed device.
               "vm.page-cluster = 0\n")

    def memory_protection_off(self, t):
        """And turning it off has to take all three back down again.

        apply never deletes what a render stops emitting, so a box
        applied once with protectMemory: true and then false kept the
        zram device swapped in and earlyoom RUNNING — a daemon whose
        whole job is to kill the agent CLIs, still doing it, with nothing
        left in the config that mentions it. The same shape as
        codexFullAccess above, with a live daemon on the other end
        instead of a stale file on disk.

        The two units are disabled BEFORE their files are removed (see
        cmd_apply): `systemctl disable` needs the unit file to find the
        multi-user.target.wants symlink it has to drop, so removing the
        file first would leave the box enabling a unit that is gone.

        Not undone here: the live sysctl values. Removing the file stops
        vm.swappiness = 180 applying at the NEXT boot, but the running
        kernel keeps whatever was last written to it — there is no
        "default" for apply to restore that would not be a guess at what
        the admin wanted. cmd_apply says so out loud when it removes the
        file. The module has the same limitation on a switch, so the two
        backends at least behave alike.
        """
        t.gone(self.p(ZRAM_HELPER))
        # earlyoom before zram: `disable --now` runs in this order, and
        # earlyoom is the one that kills — leaving it running while zram's
        # swapoff copies the compressed device back to RAM (a real memory
        # spike) is exactly the moment it might pick an agent CLI.
        for unit in (EARLYOOM_UNIT, ZRAM_UNIT):
            path = self.p("/etc/systemd/system", unit)
            t.gone(path)
            # Only a unit that is still OURS. Existence alone queued an
            # administrator's own edited copy for disable-and-stop even
            # though remove_if_ours would go on to leave that same file
            # in place — stopping a service whose file survives. Same
            # shebang-aware header check remove_if_ours uses, so the two
            # agree on what "ours" means.
            if generated_by_us(path):
                t.disable.append(unit)
        t.gone(self.p(MEMORY_SYSCTL))

    # -- brute force ---------------------------------------------------------

    def fail2ban(self, t):
        """Jail repeated 401s against the browser terminal.

        The terminal is one password on the public internet, so the module
        has always put a fail2ban jail in front of it (web.fail2ban) — and
        the native backend shipped the fail2ban BINARY in its runtime
        profile without ever configuring or starting it, which is the
        worst of the three states to be in. Same policy as the module's
        jail, deliberately: 5 failures in 10 minutes, banned for an hour.

        The config directory is ours, not /etc/fail2ban, so a distro
        fail2ban installed later keeps its own configuration and its own
        service. action.d is a symlink into the profile rather than 40
        copied files: the ban actions are the package's, we add none.

        `fail2ban-server -t` accepts a jail with no filter and no action
        (it warns and carries on), so the flake check runs the rendered
        config through -t AND fail2ban-regex against a real Caddy 401
        line. A jail that parses but matches nothing is the failure mode
        worth testing for — nobody notices a lock that never clicks.
        """
        action_dir = self.p(FAIL2BAN_DIR, "action.d")
        action_target = self.profile / "etc" / "fail2ban" / "action.d"
        if action_dir.exists() and not action_dir.is_symlink():
            # Same "left alone, not ours" case link_if_changed already
            # handles for an existing symlink pointing elsewhere — but here
            # it is a real directory, so apply would otherwise start the
            # jail against whatever is in it. banaction = nftables-multiport
            # needs that action file specifically; without it the jail logs
            # bans that never actually happen.
            if not (action_dir / "nftables-multiport.conf").exists():
                self.notes.append(
                    f"{action_dir}: exists and is not a symlink, and has no "
                    f"nftables-multiport.conf — fail2ban jail NOT installed; "
                    f"remove it so agentbox can link the packaged actions, "
                    f"or add nftables-multiport.conf yourself")
                return
        t.dir(self.p(FAIL2BAN_DIR), 0o755)
        t.dir(self.p(FAIL2BAN_DIR, "filter.d"), 0o755)
        t.link(action_dir, action_target)
        t.file(self.p(FAIL2BAN_DIR, "fail2ban.conf"), "".join(
            line + "\n" for line in [
                "# Generated by `agentbox apply` — do not edit.",
                "[Definition]",
                "loglevel = INFO",
                # To the journal, where every other agent-box service logs.
                "logtarget = STDOUT",
                "socket = /run/agent-box-fail2ban/fail2ban.sock",
                "pidfile = /run/agent-box-fail2ban/fail2ban.pid",
                # Bans survive a restart of the daemon and a reboot of the
                # box; an attacker who waits out a service restart has not
                # waited out the ban.
                "dbfile = /var/lib/agent-box-fail2ban/fail2ban.sqlite3",
            ]))
        t.file(self.p(FAIL2BAN_DIR, "jail.conf"), "".join(
            line + "\n" for line in [
                "# Generated by `agentbox apply` — do not edit.",
                "[DEFAULT]",
                # nftables, not iptables: Ubuntu's iptables IS nftables
                # behind a compatibility shim, and going through the shim
                # only adds a way for the ban to fail silently.
                "banaction = nftables-multiport",
                # Read Caddy's log from the journal rather than a file:
                # the terminal's Caddy logs there, and a file backend
                # would need a logfile nothing writes.
                "backend = systemd",
                "filter = %(__name__)s",
                'action = %(banaction)s[port="%(port)s"]',
                "",
                f"[{FAIL2BAN_JAIL}]",
                "enabled = true",
                "port = http,https",
                "maxretry = 5",
                "findtime = 10m",
                "bantime = 1h",
            ]))
        t.file(self.p(FAIL2BAN_DIR, "filter.d", f"{FAIL2BAN_JAIL}.conf"),
               "".join(line + "\n" for line in [
                   "# Generated by `agentbox apply` — do not edit.",
                   "[Definition]",
                   # Caddy's JSON access log for a request that carried an
                   # Authorization header and was refused. Byte-for-byte
                   # the module's failregex (modules/agent-box.nix.in):
                   # one jail, one regex, whichever backend rendered it.
                   'failregex = ^.*"logger":"http\\.log\\.access".*'
                   '"client_ip":"<HOST>".*"Authorization":\\["REDACTED"\\]'
                   '.*"status":401',
                   "journalmatch = _SYSTEMD_UNIT=caddy.service",
               ]))
        path = ":".join([str(self.bin), "/usr/sbin", "/usr/bin",
                         "/sbin", "/bin"])
        t.file(self.p("/etc/systemd/system", FAIL2BAN_UNIT), "".join(
            line + "\n" for line in [
                "# Generated by `agentbox apply` — do not edit.",
                "[Unit]",
                "Description=agent-box: ban repeated browser-terminal "
                "auth failures",
                # The jail reads caddy's journal; without caddy there is
                # nothing to read and nothing to protect.
                "After=caddy.service systemd-journald.service",
                "PartOf=caddy.service",
                "",
                "[Service]",
                "Type=simple",
                f"Environment=PATH={path}",
                f"ExecStart={self.bin}/fail2ban-server -xf -c {FAIL2BAN_DIR}",
                f"ExecStop={self.bin}/fail2ban-client -c {FAIL2BAN_DIR} stop",
                "RuntimeDirectory=agent-box-fail2ban",
                "StateDirectory=agent-box-fail2ban",
                "Restart=on-failure",
                "RestartSec=5s",
                "",
                "[Install]",
                "WantedBy=multi-user.target",
            ]))
        t.units.append(FAIL2BAN_UNIT)

    # -- store housekeeping -------------------------------------------------

    def nix_gc(self, t):
        """Keep the nix store from filling the root filesystem.

        Three pieces, matching what the NixOS deployments already do:

          the timer     a daily `nix-collect-garbage --delete-older-than 7d`.
                        Old generations are what actually accumulate here —
                        every self-update leaves one behind — and 7d still
                        leaves `nix profile rollback` a week of them.
          min/max-free  GC *during* a build, when free space dips below
                        1 GiB, freeing up to 5 GiB. That is the case the
                        timer cannot cover: the box fills up mid-update,
                        which is exactly when it is least able to recover.
          journald      capped at 200M, which systemd otherwise sizes at
                        10% of the filesystem.

        `nix` is not in the runtime profile — it comes from the Determinate
        installer, into the default profile — so the unit names that path
        explicitly rather than trusting a PATH systemd does not set.
        """
        t.file(self.p("/etc/systemd/system", NIX_GC_UNIT), "".join(
            line + "\n" for line in [
                "# Generated by `agentbox apply` — do not edit.",
                "[Unit]",
                "Description=agent-box: collect nix store garbage",
                "",
                "[Service]",
                "Type=oneshot",
                f"ExecStart={NIX_PROFILE_BIN}/nix-collect-garbage "
                f"--delete-older-than {NIX_GC_AGE}",
                # Housekeeping must never be the reason a box runs out of
                # CPU for the work it exists to do.
                "Nice=19",
                "IOSchedulingClass=idle",
            ]))
        t.file(self.p("/etc/systemd/system", NIX_GC_TIMER), "".join(
            line + "\n" for line in [
                "# Generated by `agentbox apply` — do not edit.",
                "[Unit]",
                "Description=agent-box: daily nix store garbage collection",
                "",
                "[Timer]",
                "OnCalendar=daily",
                # A box that was off at 03:15 still collects, rather than
                # waiting a day — Spot and stop/start boxes are off a lot.
                "Persistent=true",
                "RandomizedDelaySec=1h",
                "",
                "[Install]",
                "WantedBy=timers.target",
            ]))
        t.units.append(NIX_GC_TIMER)
        t.dir(self.p("/etc/systemd/journald.conf.d"), 0o755)
        t.file(self.p("/etc/systemd/journald.conf.d/agent-box.conf"),
               "# Generated by `agentbox apply` — do not edit.\n"
               "[Journal]\n"
               "SystemMaxUse=200M\n")
        self.nix_conf(t)

    def nix_conf(self, t):
        """min-free/max-free, in the ONE file Determinate says is ours.

        Determinate Nix generates /etc/nix/nix.conf and tells you not to
        edit it; /etc/nix/nix.custom.conf is the supported place for local
        settings. Which means it is also where a human or another tool puts
        theirs, so this writes it only when the file is absent or was
        written by us — never over someone else's settings. A box that
        already has one keeps it, and says so, rather than silently losing
        a line somebody added on purpose.
        """
        header = "# Generated by `agentbox apply` — do not edit.\n"
        path = self.p("/etc/nix/nix.custom.conf")
        try:
            existing = path.read_text()
        except OSError:
            existing = None
        if existing is not None and not existing.startswith(header):
            self.notes.append(
                f"{path}: left alone (not written by agentbox) — nix "
                f"min-free/max-free not set; add them yourself to keep the "
                f"store from filling the root filesystem mid-build")
            return
        t.dir(self.p("/etc/nix"), 0o755)
        t.file(path, header
               + "min-free = 1073741824\n"    # start GC below 1 GiB free
               + "max-free = 5368709120\n")   # ... and free up to 5 GiB

    # -- base-OS patching ----------------------------------------------------

    def os_updates(self, t):
        """Let the distro patch itself in place, and never reboot for it.

        Two files, and neither one runs apt: they answer, in advance, the
        two questions an unattended patch run asks a machine that has
        nobody sitting at it.

          apt          keep the periodic jobs on (a box whose 20auto-
                       upgrades never got written patches NOTHING, and
                       looks identical to one that is up to date), and say
                       explicitly that a patch may not reboot the box.
                       Nobody here can perform a reboot — an agent has no
                       such grant, and the operator is wherever the cloud
                       console is — so an automatic one would be a session
                       killed at an hour nobody chose.

          needrestart  restart the daemons a patch obsoleted, in place.
                       This is the half that makes "no reboot" honest:
                       needrestart's default is interactive, and an
                       interactive needrestart run non-interactively (which
                       is exactly how unattended-upgrades runs it) falls
                       back to LIST ONLY. The patched daemon then keeps
                       running the code it was patched for until a reboot
                       that, on this box, never comes.

        The one thing that must NOT be restarted is the unit that owns an
        agent's tmux server: `agent-box@%i.service` stops with
        `tmux -L agent-box kill-server`, so "restart it because libc moved"
        is every session on the box dying mid-task at 06:00. That
        exclusion is MERGED into needrestart's own hash rather than
        assigned over it — conf.d snippets are eval'd after the shipped
        config, and replacing the hash would quietly drop its exclusions
        (dbus, the display managers, the network stack) along the way.

        What this cannot fix is a kernel: it patches on disk and takes
        effect at a boot. The box says so through /var/run/reboot-required
        (the shipped guide points at it), and `osUpdates.automaticReboot:
        "HH:MM"` is there for a deployment that would rather take the
        restart than run an old kernel.
        """
        t.dir(self.p("/etc/apt"), 0o755)
        t.dir(self.p("/etc/apt/apt.conf.d"), 0o755)
        # `#` starts a comment in apt.conf too (only #include and #clear
        # are directives), so the generated header is the same one every
        # other rendered file carries — which is what makes this file
        # removable again when osUpdates goes off.
        lines = [
            GENERATED_HEADER.rstrip("\n"),
            "//",
            "// Base-OS security patching for a box with no operator at a",
            "// console. Ubuntu's own 50unattended-upgrades still chooses",
            "// WHICH pockets are patched; this file only says that the",
            "// periodic jobs run, and what may happen afterwards.",
            'APT::Periodic::Enable "1";',
            'APT::Periodic::Update-Package-Lists "1";',
            'APT::Periodic::Download-Upgradeable-Packages "1";',
            'APT::Periodic::Unattended-Upgrade "1";',
            # Downloaded .debs are the one part of this that grows without
            # bound on a small root disk.
            'APT::Periodic::AutocleanInterval "7";',
            "",
        ]
        if self.spec.os_updates_reboot:
            lines += [
                "// This deployment asked for a nightly reboot rather than",
                "// a kernel that only updates on disk. WithUsers, because",
                "// an agent session IS a logged-in user: without it the",
                "// reboot is skipped for as long as anyone is attached,",
                "// which on this box is always.",
                'Unattended-Upgrade::Automatic-Reboot "true";',
                'Unattended-Upgrade::Automatic-Reboot-WithUsers "true";',
                "Unattended-Upgrade::Automatic-Reboot-Time "
                f'"{self.spec.os_updates_reboot}";',
            ]
        else:
            lines += [
                "// Never: the agent sessions this box exists to run live",
                "// in RAM, and nothing here can decide that now is a good",
                "// moment to lose them. Kernel patches therefore wait for",
                "// a reboot somebody performs on purpose.",
                'Unattended-Upgrade::Automatic-Reboot "false";',
            ]
        lines += [
            "",
            "// Housekeeping, so unattended patching cannot fill the root",
            "// filesystem it is supposed to be protecting.",
            'Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";',
            'Unattended-Upgrade::Remove-New-Unused-Dependencies "true";',
            # Each package upgraded in its own dpkg run, so an interrupted
            # patch window (a Spot reclaim) leaves whole packages behind
            # rather than a half-configured one.
            'Unattended-Upgrade::MinimalSteps "true";',
            # No mail on this box; the journal is where anyone looks.
            'Unattended-Upgrade::SyslogEnable "true";',
        ]
        t.file(self.p(APT_CONF), "".join(line + "\n" for line in lines))

        t.dir(self.p("/etc/needrestart"), 0o755)
        t.dir(self.p("/etc/needrestart/conf.d"), 0o755)
        t.file(self.p(NEEDRESTART_CONF), "".join(line + "\n" for line in [
            GENERATED_HEADER.rstrip("\n"),
            "#",
            "# Restart what a patch obsoleted, instead of waiting for a",
            "# reboot nobody here can perform. needrestart's default is",
            "# interactive, and an interactive needrestart run",
            "# non-interactively (unattended-upgrades) falls back to list",
            "# only — the patch lands and the vulnerable process keeps",
            "# running.",
            "$nrconf{restart} = 'a';",
            "",
            "# ...but never the unit that owns an agent's tmux server: its",
            "# ExecStop is `tmux -L agent-box kill-server`, so a restart",
            "# here is every session on this box dying mid-task because a",
            "# library moved. Merged into needrestart's own hash (conf.d",
            "# is eval'd after it), so its shipped exclusions survive.",
            "$nrconf{override_rc}->{qr(^agent-box@)} = 0;",
        ]))

    def os_updates_off(self, t):
        """And turning it off has to take the policy back down.

        Same shape as memory_protection_off: apply never deletes what a
        render merely stops emitting, so a box applied once with
        osUpdates on and then off would keep patching under rules its
        configuration no longer mentions. Only files still carrying our
        header are removed (remove_if_ours), so an administrator who took
        either one over keeps it.
        """
        t.gone(self.p(APT_CONF))
        t.gone(self.p(NEEDRESTART_CONF))

    # -- host directories ---------------------------------------------------

    def dirs(self, t):
        t.dir(self.p("/etc/agent-box"), 0o755)
        t.dir(self.p("/etc/agent-box/units"), 0o755)
        t.dir(self.p("/etc/agent-box/seed"), 0o755)
        t.dir(self.p("/etc/agent-box/guides"), 0o755)
        t.dir(self.p("/etc/systemd/system"), 0o755)
        t.dir(self.p("/etc/systemd/system/multi-user.target.d"), 0o755)
        t.dir(self.p("/etc/systemd/system/sockets.target.d"), 0o755)

    # -- units --------------------------------------------------------------

    def shared_units(self, t):
        """Install the %i template units from the profile, byte-for-byte."""
        src = self.share / "units"
        if not src.is_dir():
            raise ConfigError(
                f"{src} is missing — is the runtime profile installed? "
                "(nix profile install github:defangdevs/agent-box#runtime)"
            )
        for unit in sorted(src.iterdir()):
            if unit.name.startswith("agent-box-webhook@") and \
                    not self.spec.webhook_enable:
                continue
            if unit.name.startswith(("agent-web-terminal@",
                                     "agent-box-settings@")) and \
                    not self.spec.web_enable:
                continue
            t.file(self.p("/etc/systemd/system", unit.name),
                   unit.read_text(), 0o444)
        if self.spec.web_enable:
            t.file(self.p("/etc/systemd/system/caddy.service"),
                   self.caddy_unit(), 0o444)
            t.file(self.p("/etc/systemd/system/"
                          "agent-web-auth-secrets.service"),
                   self.auth_secrets_unit(), 0o444)

    def update_unit(self, t):
        """The on-demand self-update unit (issue #358).

        Deliberately NOT appended to `t.units`: that list is what
        `cmd_apply` runs `systemctl enable --now` over, so a unit in it
        would fire an update on every single apply. This one is started by
        hand — through the agents' sudo rule, the settings page's Update
        button, or root — which is also why it has no [Install] section and
        no target drop-in.

        `nix` is not in the runtime profile (the box gets it from the
        Determinate installer, which puts it in the default profile), and
        systemd units inherit no PATH, so both are named explicitly along
        with /usr/bin for systemctl and wall.
        """
        path = ":".join([
            str(self.bin),
            "/nix/var/nix/profiles/default/bin",
            "/usr/bin", "/bin", "/usr/sbin", "/sbin",
        ])
        t.file(self.p("/etc/systemd/system", UPDATE_UNIT), "".join(
            line + "\n" for line in [
                "# Generated by `agentbox apply` — do not edit.",
                "[Unit]",
                "Description=Fast-forward agent-box to upstream HEAD "
                "and re-apply",
                "After=network-online.target",
                "Wants=network-online.target",
                "",
                "[Service]",
                "Type=oneshot",
                f'Environment="PATH={path}"',
                # Substituting a new runtime closure is minutes of work on a
                # small box, and the trigger is --no-block, so nothing is
                # waiting on it. A default 90 s TimeoutStartSec would kill it
                # mid-switch.
                "TimeoutStartSec=infinity",
                f"ExecStart={self.bin}/agentbox update "
                f"--config {self.config}",
            ]), 0o444)

    def target_wants(self, t):
        """Boot-time enablement for the %i instances.

        The shared template units have no [Install] section — `systemctl
        is-enabled agent-box@agent.service` says "static" — so
        `systemctl enable` is a no-op on them and only `--now` was doing
        anything. That meant the instances ran until the next boot and then
        never came back: after a reboot the live box had caddy and nothing
        else, so the terminal, the settings page and the agent session were
        all gone and / answered 502.

        Fix the way the NixOS backend does it (modules/agent-box.nix.in:
        systemd.targets.multi-user.wants): name the instances in the
        TARGET's own Wants=, which systemd resolves straight from the %i
        template at boot with no per-instance file needed. On a host we do
        not own the target file of, that is a drop-in.
        """
        units, sockets = [], []
        for u in self.spec.users:
            units.append(f"agent-box@{u.name}.service")
            if self.spec.web_enable:
                units.append(f"agent-web-terminal@{u.name}.service")
                units.append(f"agent-box-settings@{u.name}.service")
                sockets.append(f"agent-box-settings@{u.name}.socket")
            if self.spec.webhook_enable:
                units.append(f"agent-box-webhook@{u.name}.service")
                sockets.append(f"agent-box-webhook@{u.name}.socket")
        for target, wants in (("multi-user.target", units),
                              ("sockets.target", sockets)):
            if not wants:
                continue
            t.file(self.p("/etc/systemd/system", f"{target}.d",
                          "10-agent-box.conf"),
                   "# Generated by `agentbox apply` — do not edit.\n"
                   "[Unit]\n"
                   + "".join(f"Wants={w}\n" for w in wants),
                   0o644)

    def auth_secrets_unit(self):
        """Rebuild caddy's auth environment on every boot.

        /run/agent-box-web/env is on tmpfs and caddy.service reads it with an
        unprefixed EnvironmentFile=, so a boot that does not recreate it
        leaves the unit in an auto-restart loop ("Result: resources") and the
        box with no terminal, no settings page and no downloads. Only
        `apply --first-boot` used to write it, and cloud-init runs that once
        — so the first reboot took the whole web front door down. Verified on
        a live Lightsail box before this unit existed.

        Both inputs persist (/etc/agent-box/<user>.hash and
        /var/lib/agent-box-web/cookie-secret-<user>), so the projection into
        /run is cheap to redo. This is the split the NixOS backend already
        has, where agent-web-auth-secrets.service is requiredBy caddy.service
        (modules/agent-box.nix.in: webAuthSecretsService) — ported here so
        the two backends fail, and recover, the same way.
        """
        return (
            "[Unit]\n"
            "Description=Prepare browser terminal auth env for Caddy\n"
            "Before=caddy.service\n"
            # The env file lands in /run/agent-box-web, which tmpfiles makes.
            "After=systemd-tmpfiles-setup.service\n"
            "\n"
            "[Service]\n"
            "Type=oneshot\n"
            "RemainAfterExit=true\n"
            # No --config: /etc/agent-box/web-users already answers the
            # only question this needs (design item 5 in issue #154), so the
            # unit needs neither a YAML parser nor to know which spelling of
            # the config file this box was built from.
            f"ExecStart={self.bin}/agentbox web-secrets\n"
            "\n"
            "[Install]\n"
            # RequiredBy, not WantedBy: caddy cannot start without the file,
            # so a failure here must stop caddy rather than let it loop.
            "RequiredBy=caddy.service\n"
        )

    def caddy_unit(self):
        """The web front door.

        Native-only: on NixOS this is services.caddy. It keeps the name
        caddy.service because the shared password helper reloads that unit
        by name (modules/src/password-helper.py) — and nothing can collide
        with it, since `apply` never installs a distro caddy. It reads the
        auth secrets from /run/agent-box-web/env, which `apply --first-boot`
        writes and the helper rewrites on a password change (the job
        agent-web-auth-secrets.service does on the NixOS side).
        """
        return (
            "[Unit]\n"
            "Description=Caddy (agent-box web front door)\n"
            "After=network-online.target\n"
            "Wants=network-online.target\n"
            "\n"
            "[Service]\n"
            "Type=notify\n"
            "User=caddy\n"
            "Group=caddy\n"
            # NOT --environ: it dumps the whole environment to the journal
            # on every start, and EnvironmentFile above is where the auth
            # secrets (WEB_PASSWORD_HASH_*, WEB_COOKIE_SECRET_*) come from.
            f"ExecStart={self.bin}/caddy run "
            "--config /etc/agent-box/Caddyfile --adapter caddyfile\n"
            f"ExecReload={self.bin}/caddy reload "
            "--config /etc/agent-box/Caddyfile --adapter caddyfile --force\n"
            "EnvironmentFile=/run/agent-box-web/env\n"
            # Caddy puts its ACME certificates under $XDG_DATA_HOME/caddy,
            # defaulting to $HOME/.local/share — and systemd takes HOME from
            # passwd, where a system caddy user has /home/caddy. With
            # ProtectHome=true below that is unreadable, so the very first
            # certificate failed to cache and the box served no TLS at all
            # ("permission denied" on .../certificates/...key, and every
            # client got tlsv1 alert internal error). NixOS avoids it by
            # giving the caddy user dataDir as its home; here the unit says
            # so itself, which also holds when the distro created the user.
            "Environment=HOME=/var/lib/caddy\n"
            "Environment=XDG_DATA_HOME=/var/lib\n"
            "Environment=XDG_CONFIG_HOME=/var/lib\n"
            "StateDirectory=caddy\n"
            "Restart=on-failure\n"
            "RestartSec=5s\n"
            # Same shape as the NixOS caddy unit: it must not read /home,
            # which is why ~/sites is a symlink into /var/lib/agent-box-sites.
            "ProtectHome=true\n"
            "ProtectSystem=strict\n"
            "ReadWritePaths=/var/lib/caddy\n"
            "AmbientCapabilities=CAP_NET_BIND_SERVICE\n"
            "CapabilityBoundingSet=CAP_NET_BIND_SERVICE\n"
            "NoNewPrivileges=true\n"
            "\n"
            "[Install]\n"
            "WantedBy=multi-user.target\n"
        )

    def host_path(self, user):
        """PATH for a session.

        The user's own profile first (`nix profile add` self-service must
        win), then the box profile, then the distro's own bin dirs — the
        native counterpart of the module's curated store-path PATH.
        """
        return ":".join([
            f"{user.home}/.nix-profile/bin",
            str(self.bin),
            "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin",
        ])

    def per_user(self, t):
        for u in self.spec.users:
            self.user_env(t, u)
            self.user_dropins(t, u)
            self.user_seed(t, u)
            t.units.append(f"agent-box@{u.name}.service")
            if self.spec.web_enable:
                t.units.append(f"agent-web-terminal@{u.name}.service")
                t.units.append(f"agent-box-settings@{u.name}.socket")
            if self.spec.webhook_enable:
                t.units.append(f"agent-box-webhook@{u.name}.socket")
        if self.spec.web_enable:
            # Before caddy: enabling it installs the .requires symlink that
            # makes caddy depend on it.
            t.units.append("agent-web-auth-secrets.service")
            t.units.append("caddy.service")
            # The manifest that replaces the module's eval-time per-user loop
            # (design item 5 in issue #154): who has a web login, and where
            # their password hash lives.
            t.file(self.p("/etc/agent-box/web-users"),
                   "".join(f"{u.name}\t/etc/agent-box/{u.name}.hash\n"
                           for u in self.spec.users),
                   0o600)

    def user_env(self, t, u):
        agent_bins = " ".join(
            [f"{a}={self.bin}/{'claude' if a == 'claude' else a}"
             for a in self.spec.agents] + ["shell=/bin/bash"])
        pairs = [
            ("AGENT_BOX_SESSIONS_SEED",
             f"/etc/agent-box/seed/{u.name}-sessions.json"),
            ("AGENT_BOX_AGENT_BINS", agent_bins),
            ("AGENT_BOX_MARK_STOPPED", f"{self.bin}/agent-box-mark-stopped"),
            ("AGENT_BOX_AGENTS_POINTER",
             f"/etc/agent-box/guides/{u.name}-agents-pointer.md"),
            # What supervisor.sh symlinks ~/.claude/CLAUDE.md and
            # $CODEX_HOME/AGENTS.md at (issue #394). Without it a native
            # box seeded the pointer into $HOME and nothing else, so an
            # agent working in a checkout BELOW $HOME — which is what a
            # session doing real work does — stopped seeing the platform
            # guide entirely: claude only reads CLAUDE.md from the cwd
            # upward, codex only AGENTS.md from the project root down plus
            # the one global file.
            ("AGENT_BOX_GUIDE_TARGET",
             f"/etc/agent-box-guides/AGENTS.{u.name}.md"),
        ]
        # Lazy harnesses (issue #416): where the supervisor fetches an agent
        # CLI from when a session names one the runtime profile was built
        # without.
        #
        # No AGENT_BOX_NIX_BIN here, deliberately. The NixOS module pins a
        # store path because it HAS one; resolving `nix` at apply time on a
        # native box would bake THIS host's store path into a generated
        # file, which is both unreproducible (the native fixture differed
        # per machine) and wrong after the next nix upgrade. agents.sh
        # resolves it at runtime from PATH and the two standard install
        # locations instead.
        pairs.append(("AGENT_BOX_NIXPKGS", self.spec.jit_nixpkgs))
        if "claude" in self.spec.agents:
            pairs.append(("AGENT_BOX_CLAUDE_SETTINGS", CLAUDE_SETTINGS))
            if self.spec.webhook_enable:
                # The supervisor reads the VERSION out of this script to
                # pin claude's local-webhook plugin to the release the box
                # runs (best effort — an offline box just starts with what
                # it has). Without it a session silently tracks the
                # marketplace's default branch instead.
                pairs.append(("AGENT_BOX_WEBHOOK_PINNED_SCRIPT",
                              self.spec.webhook_script))
        if self.spec.codex_full_access:
            # Set ONLY when the file above was written: supervisor.sh reads
            # this as "the box has a system-wide codex config", and a
            # session with skipPermissions = false uses it to pin the
            # restricted values back. Exporting it without the file would
            # make that opt-out fight a default nobody wrote.
            pairs.append(("AGENT_BOX_CODEX_FULL_ACCESS", "1"))
        if self.spec.web_enable:
            pairs.append(("AGENT_BOX_URL", u.url))
            if self.spec.webhook_enable:
                pairs.append(("AGENT_BOX_WEBHOOK_URL",
                              f"https://{self.spec.domain}/{u.name}/webhook"))
        # Arbitrary per-user extras (the module's u.environment) join the
        # generated file rather than needing a drop-in.
        pairs += sorted(u.environment.items())
        t.file(self.p("/etc/agent-box/units", f"{u.name}.env"),
               env_file(pairs))

        if self.spec.web_enable:
            t.file(self.p("/etc/agent-box/units",
                          f"agent-web-terminal-{u.name}.env"),
                   env_file([("AGENT_BOX_TTYD_PORT", u.ttyd_port),
                             ("AGENT_BOX_WEB_DOMAIN", self.spec.domain)]))
            settings = [
                ("AGENT_BOX_PASSWORD_CMD",
                 f"/usr/bin/sudo -n /etc/agent-box/bin/agent-box-password-{u.name}"),
            ]
            if u is self.spec.root_user:
                settings.append(("AGENT_BOX_HOME", "1"))
                # Who the root picker at GET / can offer. Only the root
                # daemon serves that page, and it only shows a picker when
                # there is more than one name here — with one terminal
                # user, the norm, it redirects straight into them.
                settings.append(("AGENT_BOX_WEB_USERS", ",".join(
                    x.name for x in self.spec.users)))
            if self.spec.webhook_enable:
                settings.append(("AGENT_BOX_WEBHOOK_STATE_DIR",
                                 f"{u.home}/.local/state/local-webhook"))
                # The same endpoint the agent unit exports above, so the
                # Webhook panel can print what to paste into the sender.
                settings.append(("AGENT_BOX_WEBHOOK_URL",
                                 f"https://{self.spec.domain}/{u.name}/webhook"))
            t.file(self.p("/etc/agent-box/units",
                          f"agent-box-settings-{u.name}.env"),
                   env_file(settings))
        if self.spec.webhook_enable:
            t.file(self.p("/etc/agent-box/units",
                          f"agent-box-webhook-{u.name}.env"),
                   env_file([("LOCAL_WEBHOOK_STATE_DIR",
                              f"{u.home}/.local/state/local-webhook")]))

    def user_dropins(self, t, u):
        """Host-level content, per instance.

        #295 found that a template-level drop-in silently never merges into
        an instance, and that a bare-name ExecStart is not reliably resolved
        by ExecSearchPath in practice — so every ExecStart here is absolute
        and every drop-in is per instance, matching the NixOS side.
        """
        path = self.host_path(u)
        lines = [
            f'Environment="PATH={path}"',
            f'Environment="AGENT_BOX_HOST_LABEL={self.spec.host_label}"',
            f'Environment="AGENT_BOX_ENV_EXEC={self.bin}/agent-box-env-exec"',
            f'Environment="AGENT_BOX_GREP_BIN={self.bin}/grep"',
            f'Environment="AGENT_BOX_FIND_BIN={self.bin}/find"',
            f'Environment="AGENT_BOX_FLOCK_BIN={self.bin}/flock"',
            f'Environment="AGENT_BOX_HOSTNAME_BIN={self.bin}/hostname"',
            f'ExecSearchPath={path}',
            "ExecStart=",
            f"ExecStart={self.bin}/agent-box-supervisor",
            "ExecStop=",
            f"ExecStop={self.bin}/tmux -L agent-box kill-server",
        ]
        if "codex" in self.spec.agents:
            lines.insert(2, 'Environment="AGENT_BOX_CODEX_RC='
                            f'{self.bin}/agent-box-codex-remote-control"')
        if self.spec.webhook_enable:
            lines.insert(2, 'Environment="AGENT_BOX_WEBHOOK_REPO='
                            f'{self.spec.webhook_repo}"')
        if self.spec.protect_memory:
            # Same knob as the module: the supervisor is the last thing that
            # should be killed when the box runs out of memory.
            lines.append("OOMScoreAdjust=500")
        if self.spec.sudo_allowlist:
            lines.append("NoNewPrivileges=false")
        if self.spec.web_enable:
            lines.append(f"ReadWritePaths=/var/lib/agent-box-sites/{u.name}")
            lines.append(
                f"ReadWritePaths=/var/lib/agent-box-downloads/{u.name}")
        for f in u.environment_files:
            lines.append(f"EnvironmentFile=-{f}")
        t.file(self.p("/etc/systemd/system",
                      f"agent-box@{u.name}.service.d", "10-host.conf"),
               dropin(lines))

        if self.spec.web_enable:
            t.file(self.p("/etc/systemd/system",
                          f"agent-web-terminal@{u.name}.service.d",
                          "10-host.conf"),
                   dropin([
                       f'Environment="PATH={self.bin}"',
                       # This override exists ONLY to absolutize the two
                       # binaries: the shared template's ExecStart names
                       # `ttyd` and `agent-box-attach` bare, and this unit
                       # carries no agent PATH. Every FLAG here is therefore
                       # a restatement of
                       # modules/src/units/agent-web-terminal@.service and
                       # must stay identical to it —
                       # macOptionClickForcesSelection (issue #327: the Mac
                       # Option-drag gesture xterm.js ships off, which the
                       # shipped guide tells every user to use) was dropped
                       # here for exactly as long as the two spellings were
                       # maintained by hand. The backend-parity check cannot
                       # see it: that check is keyed on AGENT_BOX_* names and
                       # this is a bare ttyd flag, so
                       # test_ttyd_override_keeps_every_flag_the_template_sets
                       # reads the template instead. #451 removes the
                       # restatement.
                       "ExecStart=",
                       f"ExecStart={self.bin}/ttyd --writable --url-arg "
                       f"-p {u.ttyd_port} -i 127.0.0.1 -b /{u.name} "
                       "-t disableLeaveAlert=true "
                       f"-t titleFixed={u.name}@{self.spec.domain} "
                       "-t macOptionClickForcesSelection=true "
                       f"{self.bin}/agent-box-attach",
                   ]))
            t.file(self.p("/etc/systemd/system",
                          f"agent-box-settings@{u.name}.service.d",
                          "10-host.conf"),
                   dropin([
                       f'Environment="PATH={self.bin}"',
                       f'Environment="AGENT_BOX_AGENTS='
                       f'{",".join(self.spec.agents + ["shell"])}"',
                       f'Environment="AGENT_BOX_DEFAULT_AGENT='
                       f'{self.spec.default_agent}"',
                       f'Environment="AGENT_BOX_REPO={self.spec.repo}"',
                       f'Environment="AGENT_BOX_REV={self.spec.rev}"',
                       f'Environment="AGENT_BOX_SYSTEMCTL={SYSTEMCTL}"',
                       f'Environment="AGENT_BOX_TMUX_BIN={self.bin}/tmux"',
                       # The settings page's Connections cards (issue
                       # #392). Same "<id>=<binary>" convention as
                       # AGENT_BOX_AGENT_BINS, and it names only what this
                       # profile actually ships. It is no longer the card
                       # LIST, though (issue #416): a card also appears for
                       # a CLI the daemon could fetch, which is what makes
                       # a box that ships none of them usable. Still no
                       # defang card here — the runtime profile has no
                       # defang and it is not in nixpkgs either, so nothing
                       # could fetch it, and the daemon drops a card that
                       # can neither act nor be acted on.
                       'Environment="AGENT_BOX_CONNECT_BINS=' + " ".join(
                           [f"{a}={self.bin}/{a}" for a in self.spec.agents]
                           + [f"github={self.bin}/gh"]) + '"',
                       # Where a card fetches a CLI this profile does not
                       # ship (issue #416) — the same pinned source the
                       # supervisor's lazy harness install uses.
                       f'Environment="AGENT_BOX_NIXPKGS={self.spec.jit_nixpkgs}"',
                       # The settings page's Update card: _CMD triggers the
                       # run (sudo, matching the sudoers grant exactly),
                       # _UNIT is only read back for status. /usr/bin/sudo,
                       # not NixOS's /run/wrappers/bin/sudo — this is a
                       # stock distro's sudo (issue #358).
                       f'Environment="AGENT_BOX_UPDATE_CMD=/usr/bin/sudo -n '
                       f'{UPDATE_TRIGGER}"',
                       f'Environment="AGENT_BOX_UPDATE_UNIT={UPDATE_UNIT}"',
                   ] + ([
                       # The webhook panel (issue #227) shells out to the
                       # SAME script and interpreter the receiver runs, so
                       # the panel cannot drift from the semantics the
                       # receiver implements.
                       #
                       # The SCRIPT is what the daemon gates the whole panel
                       # on (WEBHOOKS = bool(WEBHOOK_SCRIPT and
                       # WEBHOOK_STATE_DIR)), so leaving it out hid every
                       # webhook row on every native box — the endpoint and
                       # secret, the standing watches, and each session's
                       # subscription fold — exactly the #392 shape, and
                       # invisible to a fixture that ratifies what the
                       # renderer already emits (issue #425).
                       f'Environment="AGENT_BOX_WEBHOOK_SCRIPT='
                       f'{self.spec.webhook_script}"',
                       # Without the interpreter the daemon falls back to
                       # its own, which need not have local-webhook's
                       # dependencies.
                       f'Environment="AGENT_BOX_WEBHOOK_PYTHON='
                       f'{self.bin}/python3"',
                       # --preamble mode only: the panel prints the prompt
                       # the next match would launch (issue #259).
                       f'Environment="AGENT_BOX_HOOK_SPAWN_CMD='
                       f'{self.bin}/agent-box-webhook-spawn"',
                   ] if self.spec.webhook_enable else []) + [
                       "ExecStart=",
                       f"ExecStart={self.bin}/agent-box-settings",
                   ]))
        if self.spec.webhook_enable:
            t.file(self.p("/etc/systemd/system",
                          f"agent-box-webhook@{u.name}.service.d",
                          "10-host.conf"),
                   dropin([
                       f'Environment="PATH={self.bin}"',
                       'Environment="LOCAL_WEBHOOK_SPAWN_CMD='
                       f'{self.bin}/agent-box-webhook-spawn"',
                       # webhook-spawn.sh names the tmux it starts a
                       # session with. It falls back to PATH, which does
                       # carry tmux here — but the module names it, and a
                       # payload that reads a variable one backend sets and
                       # the other leaves to PATH is exactly the drift the
                       # per-unit half of check_backend_parity.py exists to
                       # stop. Name it on both.
                       f'Environment="AGENT_BOX_TMUX_BIN={self.bin}/tmux"',
                       "ExecStart=",
                       f"ExecStart={self.bin}/agent-box-webhook-receiver",
                   ]))

    def render_guide(self, text):
        """Bind default-agents.md's backend tokens for this native install.

        The module binds the same two tokens with `lib.replaceStrings`
        (modules/agent-box.nix.in) — this is the native half of that split,
        reading the identical @@include'd source (nix/runtime.nix installs
        it byte-for-byte). @WEBHOOK_SECTION@ was landing in shipped guides
        completely unsubstituted until now, since nothing on this side
        ever bound it.

        @UPDATE_SECTION@ never expands to the NixOS self-update paragraph:
        the mechanism differs (a Nix profile, not a system closure), so the
        native update service takes a different command and makes a
        different promise about what restarts (issue #358).
        """
        webhook_section = ""
        if self.spec.webhook_enable:
            webhook_md = self.share / "guides" / "default-agents-webhook.md"
            webhook_section = webhook_md.read_text().rstrip("\n") + "\n\n"
        update_section = (
            "## Updating\n\n"
            "Update the box's software with:\n"
            f"`sudo -n {UPDATE_TRIGGER}`\n"
            "(the full path is required for the passwordless sudo rule to "
            "match).\n"
            "This box is not NixOS: the update fast-forwards the Nix profile "
            "your\n"
            "software comes from to the newest commit of the upstream repo, "
            "renders\n"
            "the host configuration that release describes, and restarts the "
            "services\n"
            "onto it - your own tmux session included, so save context "
            "first.\n\n"
            "It refuses a target that is not strictly ahead of the rev you "
            "are\n"
            "running, and if the new release fails to apply it rolls the "
            "profile\n"
            "back and re-applies the old one. Watch it with `journalctl -fu "
            f"{UPDATE_UNIT}`;\n"
            "the box's own rev is on the settings page.\n\n"
        )
        # Which HOST this guide is describing. The module binds the NixOS
        # section here; this box is a distro host with agent-box in a Nix
        # profile, and saying otherwise is not a cosmetic slip — an agent
        # that believes it is on NixOS reaches for nixos-rebuild, reads
        # /etc/nixos, and mistakes what it can change.
        host_md = self.share / "guides" / "default-agents-host-native.md"
        host_section = host_md.read_text().rstrip("\n") + "\n\n"
        return (text.replace("@WEBHOOK_SECTION@", webhook_section)
                    .replace("@UPDATE_SECTION@", update_section)
                    .replace("@HOST_SECTION@", host_section))

    def user_seed(self, t, u):
        """The declared sessions, seeded on first boot only.

        sessions.json is runtime data afterwards — the supervisor never lets
        an apply clobber sessions the user added or removed while live.

        The schema is NOT ours to choose: modules/src/supervisor.sh reads
        this file with jq as {"version":1,"sessions":{"<name>":{...}}} and
        expects every runtime field to be present. An earlier shape here —
        a list of {"name","agent"} — parsed as JSON and then broke the
        supervisor on a live box: `jq: Cannot index array with string ("0")`
        in a restart loop, with the seeded session showing up as one named
        "0" and never starting. Defaults mirror the module's per-session
        options (modules/agent-box.nix.in: skipPermissions/remoteControl
        default true, everything else null/[]).
        """
        sessions = {}
        for sname in sorted(u.sessions):
            s = u.sessions[sname] or {}
            sessions[sname] = {
                "agent": s.get("agent") or u.agent,
                "skipPermissions": bool(s.get("skipPermissions", True)),
                "remoteControl": bool(s.get("remoteControl", True)),
                "extraArgs": list(s.get("extraArgs") or []),
                # null → the supervisor derives "<user>-<session>@<host>"
                # at start time.
                "remoteControlName": s.get("remoteControlName"),
                "workingDirectory": s.get("cwd") or s.get(
                    "workingDirectory") or u.home,
                # Runtime state the supervisor manages; seeded so a declared
                # kickoff prompt fires once and hasRun exists from the start.
                "initialPrompt": s.get("prompt") or s.get("initialPrompt"),
                "resumePrompt": s.get("resumePrompt"),
                "boxSessionId": None,
                "hasRun": False,
            }
        t.file(self.p("/etc/agent-box/seed", f"{u.name}-sessions.json"),
               json.dumps({"version": 1, "sessions": sessions},
                          indent=2, sort_keys=True) + "\n", 0o644)

        # Per user, like the module's canonicalAgentsPath: this ran inside
        # the per-user loop while naming AGENTS.agent.md for everyone, so a
        # second user overwrote the first user's guide and both pointers
        # aimed at a file describing one of them.
        canonical = f"/etc/agent-box-guides/AGENTS.{u.name}.md"
        guide = self.share / "guides" / "default-agents.md"
        pointer = (
            f"# agent-box - {u.name}@{self.spec.host_label}\n\n"
            "The canonical guide is read-only and updated with the box:\n"
            f"@{canonical}\n"
        )
        t.file(self.p("/etc/agent-box/guides",
                      f"{u.name}-agents-pointer.md"), pointer)
        if guide.is_file():
            t.file(self.p(canonical),
                   self.render_guide(guide.read_text()), 0o444)

    # -- sudoers, tmpfiles, caddy -------------------------------------------

    def sudoers(self, t):
        """Least-privilege sudo, data-driven from the config.

        Only the exact commands the box needs: reload the web front door,
        trigger the self-update unit, and each user's own password helper.
        The update grant is spelled from UPDATE_TRIGGER rather than by hand
        so it cannot drift from the unit `update_unit` renders or from the
        command the guide documents (issue #358; #353 for why a grant that
        does not match the command silently asks for a password).
        """
        lines = [
            "# Generated by `agentbox apply` — do not edit.",
        ]
        for u in self.spec.users:
            cmds = [f"/etc/agent-box/bin/agent-box-password-{u.name}"]
            if self.spec.web_enable:
                cmds.append("/usr/bin/systemctl reload caddy.service")
            cmds.append(UPDATE_TRIGGER)
            cmds += self.spec.sudo_allowlist
            lines.append(f"{u.name} ALL=(root) NOPASSWD: " + ", ".join(cmds))
        t.file(self.p("/etc/sudoers.d/agent-box"),
               "\n".join(lines) + "\n", 0o440)

    def tmpfiles(self, t):
        """The same directory set the module declares in tmpfiles.d.

        systemd-tmpfiles exists on Ubuntu and RHEL too, so this stays a
        declaration rather than a pile of mkdir calls — and `apply` runs
        systemd-tmpfiles --create to realize it.
        """
        lines = []
        if self.spec.web_enable:
            lines += [
                "d /var/lib/agent-box-web 0700 root root - -",
                "d /run/agent-box-web 0700 root root - -",
                "d /var/lib/agent-box-sites 0755 root root - -",
                "d /var/lib/agent-box-downloads 0755 root root - -",
                "d /run/agent-box-settings 0755 root root - -",
            ]
        for u in self.spec.users:
            if self.spec.web_enable:
                lines += [
                    f"d /var/lib/agent-box-sites/{u.name} 0750 {u.name} caddy - -",
                    f"L+ {u.home}/sites - - - - /var/lib/agent-box-sites/{u.name}",
                    f"d /var/lib/agent-box-downloads/{u.name} 0750 {u.name} caddy - -",
                    f"L+ {u.home}/downloads - - - - /var/lib/agent-box-downloads/{u.name}",
                ]
            # The parent is declared too, and owned by the user. Without it
            # systemd-tmpfiles creates ~/.config itself as root, then refuses
            # to descend into it — "Detected unsafe path transition
            # /home/agent (owned by agent) -> /home/agent/.config (owned by
            # root)", exit 73 — and the supervisor's first act on a fresh box
            # is `mkdir ~/.config/agent-box`, which then fails with
            # "Permission denied" and the seeded session never starts. The
            # NixOS module gets away with the single rule only because
            # ~/.config already exists, user-owned, by the time its rules run.
            lines += [
                f"d {u.home}/.config 0755 {u.name} {u.name} - -",
                f"d {u.home}/.config/agent-box 0700 {u.name} {u.name} - -",
            ]
        if self.spec.webhook_enable:
            lines.append("d /run/agent-box-webhook 0755 root root - -")
        t.file(self.p("/etc/tmpfiles.d/agent-box.conf"),
               "\n".join(lines) + "\n")

    def interactive_clis(self, t):
        """agent-box-session and agent-box-profile, on every box.

        The profile ships them bare (-bare); the env prelude the module
        compiles into its wrapper is generated here, because these run
        from every PATH there is, not from a unit. Unconditional: unlike
        the Caddyfile and its fail2ban jail, these commands are the ones
        the shipped guide tells every agent to run regardless of
        web.enable, so a web-disabled box that never calls self.caddy()
        must still get them (issue #394 review).
        """
        agents = " ".join(self.spec.agents + ["shell"])
        # shlex.quote, not hand-written single quotes: these values come
        # from the box's config, and JSON does not escape an apostrophe —
        # one `don't` in webhook.hookSessionArgs closed the quoted string
        # and broke the wrapper for every caller (issue #394 review).
        q = shlex.quote
        t.file(self.p("/usr/local/bin/agent-box-session"),
               "#!/bin/sh\n"
               "# Generated by `agentbox apply`.\n"
               f"export AGENT_BOX_AGENTS={q(agents)}\n"
               f"export AGENT_BOX_DEFAULT_AGENT={q(self.spec.default_agent)}\n"
               f"export AGENT_BOX_FLOCK_BIN={q(f'{self.bin}/flock')}\n"
               # The env store's one reader/writer (issue #212): `env
               # ls/set/rm` here and the settings page must agree
               # byte-for-byte about a multi-line value — a PEM, an SSH key
               # — so neither owns a parser. session-cli.sh reads this with
               # ${VAR:?}, so until now the verb the shipped guide tells
               # every agent to use for secrets died on the spot (#394).
               f"export AGENT_BOX_ENVSTORE_BIN="
               f"{q(f'{self.bin}/agent-box-envstore')}\n"
               # `add --profile` resolves the harness and its arguments by
               # shelling out to agent-box-profile, from PATHs that do not
               # carry it (the webhook receiver unit's PATH is jq +
               # coreutils + this CLI).
               f"export AGENT_BOX_PROFILE_BIN="
               f"{q('/usr/local/bin/agent-box-profile')}\n"
               f'exec {self.bin}/agent-box-session-bare "$@"\n', 0o755)
        # A profile file is the env store in another directory, so it has
        # the same one parser.
        t.file(self.p("/usr/local/bin/agent-box-profile"),
               "#!/bin/sh\n"
               "# Generated by `agentbox apply`.\n"
               f"export AGENT_BOX_AGENTS={q(agents)}\n"
               f"export AGENT_BOX_DEFAULT_AGENT={q(self.spec.default_agent)}\n"
               f"export AGENT_BOX_ENVSTORE_BIN="
               f"{q(f'{self.bin}/agent-box-envstore')}\n"
               f'exec {self.bin}/agent-box-profile-bare "$@"\n', 0o755)

    def caddy(self, t):
        """Bind the shared Caddyfile fragments.

        The fragments are @TOKEN@ templates — the same token set both
        backends bind (issue #154 Phase 2), so the rendered Caddyfile is the
        same text NixOS produces.
        """
        frag = self.share / "caddy"
        root_user = self.spec.root_user

        def bind(name, user=None):
            text = (frag / f"caddyfile-{name}.caddy").read_text()
            text = text.replace("@DOMAIN@", self.spec.domain)
            if user is not None:
                # Bind every token the fragments carry. The values mirror the
                # module's helpers one for one (settingsSocketOf,
                # downloadsDirOf, webhookSocketOf, webhookPathOf, envName),
                # because the rendered Caddyfile has to be the same text on
                # both backends.
                for token, value in [
                    ("@USER_ENV@", user.env_key),
                    ("@SETTINGS_SOCKET@",
                     f"/run/agent-box-settings/{user.name}.sock"),
                    ("@DOWNLOADS_DIR@",
                     f"/var/lib/agent-box-downloads/{user.name}"),
                    ("@TTYD_PORT@", str(user.ttyd_port)),
                    ("@WEBHOOK_PATH@", f"/{user.name}/webhook"),
                    ("@WEBHOOK_SOCKET@",
                     f"/run/agent-box-webhook/{user.name}.sock"),
                    # Last: @USER@ is a prefix of nothing else, but keeping
                    # it last means a value containing "@USER@" could never
                    # be re-substituted.
                    ("@USER@", user.name),
                ]:
                    text = text.replace(token, value)
            left = re.findall(r"@[A-Z_]+@", text)
            if left:
                raise ConfigError(
                    f"caddyfile-{name}.caddy has unbound token(s) "
                    f"{sorted(set(left))} — the fragment gained a token the "
                    "native renderer does not know about")
            return text

        parts = [bind("header")]
        for u in self.spec.users:
            if self.spec.webhook_enable:
                parts.append(bind("webhook", u))
            parts.append(bind("terminal", u))
        parts.append(bind("root", root_user))
        parts.append("}\n")
        t.file(self.p("/etc/agent-box/Caddyfile"), "\n".join(parts), 0o644)

        # The per-user password helper. It crosses sudo, so its paths are
        # compiled in here rather than read from env — an env-supplied path
        # would be a root-write redirect primitive (issue #154 Phase 2).
        helper_src = self.profile / "libexec" / "agent-box" / \
            "password-helper.py"
        if helper_src.is_file():
            body = helper_src.read_text()
            for u in self.spec.users:
                # Constants are APPENDED, exactly as the module's generated
                # tail appends them: the body assigns its own defaults at
                # import time, so anything that has to differ natively
                # (SYSTEMCTL) must come after it. They are compiled in
                # rather than read from env because the helper runs via
                # sudo — an env-supplied path would be a root-write
                # redirect primitive (issue #154 Phase 2 exception).
                tail = (
                    "\n"
                    "# Per-user constants, appended by `agentbox apply`.\n"
                    f"HASH_FILE = '/etc/agent-box/{u.name}.hash'\n"
                    "COOKIE_FILE = "
                    f"'/var/lib/agent-box-web/cookie-secret-{u.name}'\n"
                    f"ENV_SUFFIX = '{u.env_key}'\n"
                    f"CADDY = '{self.bin}/caddy'\n"
                    "# Native override: the body's default is the NixOS path.\n"
                    "SYSTEMCTL = '/usr/bin/systemctl'\n"
                    "\n"
                    'if __name__ == "__main__":\n'
                    "    main()\n"
                )
                t.file(self.p("/etc/agent-box/bin",
                              f"agent-box-password-{u.name}"),
                       f"#!{self.bin}/agent-box-python\n" + body + tail,
                       0o755)

        # Interactive CLIs beyond agent-box-session/agent-box-profile
        # (interactive_clis, called unconditionally from render()):
        # agent-box-webhook needs the Caddy route this method renders, so
        # it stays gated on web.enable the same way the module's
        # webhookEnabled is `cfg.webhook.enable && cfg.web.enable`.
        if self.spec.webhook_enable:
            t.file(self.p("/usr/local/bin/agent-box-webhook"),
                   "#!/bin/sh\n"
                   "# Generated by `agentbox apply`.\n"
                   f"export AGENT_BOX_WEBHOOK_SCRIPT="
                   f"{shlex.quote(self.spec.webhook_script)}\n"
                   f"export AGENT_BOX_HOOK_SESSION_ARGS="
                   f"{shlex.quote(json.dumps(self.spec.hook_session_args))}\n"
                   f'exec {self.bin}/agent-box-webhook-bare "$@"\n', 0o755)


# --------------------------------------------------------------------------
# Applying
# --------------------------------------------------------------------------

def run(cmd, check=True, capture=False):
    return subprocess.run(cmd, check=check, text=True,
                          capture_output=capture)


def write_if_changed(path, text, mode, dry_run=False):
    """Write atomically, and only when the content or mode differs."""
    path = Path(path)
    try:
        current = path.read_text()
        same = current == text and (path.stat().st_mode & 0o7777) == mode
    except FileNotFoundError:
        same = False
    if same:
        return False
    if dry_run:
        print(f"would write {path}")
        return True
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".agentbox-new")
    tmp.write_text(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)
    print(f"wrote {path}")
    return True


def link_if_changed(link, target, dry_run=False):
    """Point `link` at `target`, idempotently.

    Tree has carried symlinks since it was written and apply never wrote
    one — the list was collected and dropped on the floor, so the first
    caller to need a symlink (the fail2ban jail's action.d, issue #394)
    would have rendered a config referring to a path that never existed.
    Replaced through a temp name so a re-point is atomic: readers see the
    old target or the new one, never a missing link.
    """
    link = Path(link)
    target = str(target)
    try:
        if os.readlink(link) == target:
            return False
    except OSError:
        if link.exists() and not link.is_symlink():
            # Something that is not our symlink is sitting there. Refuse
            # rather than delete: whatever put a real directory here knew
            # something we do not.
            print(f"note: {link} exists and is not a symlink — left alone")
            return False
    if dry_run:
        print(f"would link {link} -> {target}")
        return True
    link.parent.mkdir(parents=True, exist_ok=True)
    tmp = link.with_name(link.name + ".agentbox-new")
    if tmp.is_symlink() or tmp.exists():
        tmp.unlink()
    os.symlink(target, tmp)
    os.replace(tmp, link)
    print(f"linked {link} -> {target}")
    return True


def generated_by_us(path):
    """True if `path` still carries the header apply itself writes.

    A human who took the file over — edited it, or replaced it outright —
    loses that header, and that is the one thing that makes a file ours
    to touch: not "does a file exist at this name" (issue #404 review),
    which is also true of an administrator's own copy.

    A generated SCRIPT carries the header on line two: the shebang has to
    come first or the kernel will not run it. Without allowing for that,
    every rendered helper looked like a file we did not write.

    A symlink at the name is never ours, no matter what it points at
    (issue #404 review): read_text() follows it transparently, so without
    this check an administrator who replaced the file with a symlink into
    their OWN config could still have it read as generated — and then
    removed, or its unit disabled, out from under them.
    """
    path = Path(path)
    if path.is_symlink():
        return False
    try:
        text = path.read_text()
    except (OSError, UnicodeDecodeError):
        # An administrator's own binary, or a file in another encoding,
        # is exactly the kind of file this check exists to leave alone —
        # UnicodeDecodeError is not an OSError, so without this it would
        # crash apply instead of just saying "not ours" (issue #404
        # review).
        return False
    if text.startswith("#!"):
        text = text.split("\n", 1)[1] if "\n" in text else ""
    return text.startswith(GENERATED_HEADER)


def remove_if_ours(path, dry_run=False):
    """Delete a file a previous render owned and this one no longer emits.

    Only ours: the file has to still carry the generated header, so a
    human who took the file over keeps it. Nothing else in apply deletes,
    which is the point — a renderer that removes files it did not write is
    a footgun, and one that never removes anything leaves stale policy in
    force (issue #394: codexFullAccess flipped off).
    """
    path = Path(path)
    if not generated_by_us(path):
        if path.exists():
            print(f"note: {path} is no longer ours to remove — left alone")
        return False
    if dry_run:
        print(f"would remove {path}")
        return True
    path.unlink()
    print(f"removed {path}")
    return True


def ensure_user(name, home, dry_run=False):
    """Create the login if it is missing. Never modifies an existing one."""
    import pwd
    try:
        pwd.getpwnam(name)
        return False
    except KeyError:
        pass
    if dry_run:
        print(f"would create user {name}")
        return True
    run(["useradd", "--create-home", "--home-dir", home,
         "--shell", "/bin/bash", name])
    print(f"created user {name}")
    return True


def unit_is_enabled(unit):
    """True only for a unit systemd reports as enabled.

    Deliberately narrow: "masked", "disabled", "static" and a missing
    unit all read as False, so apply only ever re-enables a unit it can
    prove was enabled when it turned it off.
    """
    out = run(["systemctl", "is-enabled", unit], check=False, capture=True)
    return (out.stdout or "").strip() == "enabled"


def systemd_units_live(prefix):
    out = run(["systemctl", "list-unit-files", "--no-legend", f"{prefix}*"],
              check=False, capture=True).stdout or ""
    return [line.split()[0] for line in out.splitlines() if line.strip()]


def zram_module_available():
    """True unless `modprobe zram` (agent-box-zram.service's ExecStart)
    can be proven to fail — a --dry-run, so this never actually loads it.

    Some kernels (Azure's linux-azure Ubuntu images, issue #435) split
    zram out into linux-modules-extra-$(uname -r), which the marketplace
    image does not install; modprobe then aborts under the unit's
    `set -eu` and zram silently never comes up. Only a missing modprobe
    binary reports available rather than warn on a guess — any OTHER
    failure to even run it (e.g. permissions) is not proof the module is
    fine, and staying quiet there is exactly the silent-degradation this
    check exists to catch.
    """
    try:
        return subprocess.run(
            ["modprobe", "--dry-run", "--quiet", "zram"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        ).returncode == 0
    except FileNotFoundError:
        return True
    except OSError:
        return False


def cmd_apply(args):
    profile = resolve_profile(args.profile)
    spec = Spec(load_config(args.config), profile)
    if args.first_boot:
        first_boot(spec, args)
    rend = Renderer(spec, profile, root=args.root or "/", config=args.config)
    tree = rend.render()

    live = args.root is None
    changed = 0
    if live:
        for unit in tree.disable:
            # Before the files go, not after: `systemctl disable` reads the
            # unit file to find the .wants symlink it has to drop, so a
            # removal first would leave the box enabling a unit that no
            # longer exists — and `--now` would have nothing to stop.
            if args.dry_run:
                print(f"would disable {unit}")
                continue
            print(f"disabling {unit} (no longer in config)")
            run(["systemctl", "disable", "--now", unit], check=False)
    for path, mode, owner, group in tree.dirs:
        p = Path(path)
        if not p.is_dir():
            if args.dry_run:
                print(f"would mkdir {p}")
            else:
                p.mkdir(parents=True, exist_ok=True)
                os.chmod(p, mode)
            changed += 1
    for path, (text, mode) in sorted(tree.files.items()):
        if write_if_changed(path, text, mode, args.dry_run):
            changed += 1
    for link, target in sorted(tree.links):
        if link_if_changed(link, target, args.dry_run):
            changed += 1
    removed = set()
    for path in sorted(tree.remove):
        if remove_if_ours(path, args.dry_run):
            removed.add(path)
            changed += 1

    if not live:
        print(f"rendered {len(tree.files)} files under {args.root}")
        return 0

    if not args.dry_run:
        for u in spec.users:
            ensure_user(u.name, u.home)
        if spec.web_enable:
            ensure_group_user("caddy", home="/var/lib/caddy")
        run(["systemd-tmpfiles", "--create", "/etc/tmpfiles.d/agent-box.conf"],
            check=False)
        if spec.protect_memory or str(Path(MEMORY_SYSCTL)) in removed:
            # Also on the way DOWN: our file has just been removed, so this
            # is what lets whatever else sets these values have them back.
            run(["sysctl", "--system"], check=False)
        if spec.protect_memory and not zram_module_available():
            # #435: linux-azure Ubuntu images ship no zram module (it is
            # split into linux-modules-extra-$(uname -r), which the
            # marketplace image does not install) — agent-box-zram.service
            # then fails at ExecStart and nothing else surfaces it; the box
            # quietly runs on disk swap only. Caught here, not inside the
            # unit, because this is a one-time apply-time diagnosis, not
            # something to shell out for on every start/stop.
            rend.notes.append(
                "zram unavailable on this kernel (modprobe zram would "
                "fail) — install linux-modules-extra-$(uname -r) (or your "
                "distro's equivalent) and re-apply; until then "
                f"{ZRAM_UNIT} fails and the box runs on disk swap only")
        if spec.protect_memory:
            # Exactly one OOM daemon, explicitly. Ubuntu enables
            # systemd-oomd by default and it overlaps earlyoom — two
            # daemons racing to kill under pressure is worse than either,
            # because each sees the other's kill as the pressure easing.
            # Stamped, so turning protectMemory back off can give the box
            # back the daemon we took from it.
            if unit_is_enabled(OOMD_UNIT):
                write_if_changed(OOMD_STAMP, GENERATED_HEADER, 0o644)
            run(["systemctl", "disable", "--now", OOMD_UNIT], check=False)
        elif Path(OOMD_STAMP).exists():
            # Only what WE disabled: a box where an admin had already
            # turned systemd-oomd off, or masked it, has no stamp and is
            # left exactly as it is.
            run(["systemctl", "enable", "--now", OOMD_UNIT], check=False)
            remove_if_ours(OOMD_STAMP)
        run(["systemctl", "daemon-reload"])
        # Enable what the config declares; stop instances for users that
        # were removed from it, so a shrinking config is honored too.
        for unit in tree.units:
            if "@" in unit:
                # A %i instance. It has no [Install], so `enable` is a
                # no-op on it and boot-time enablement is the target
                # drop-in's job (see Renderer.target_wants) — all that is
                # left to do here is start it now.
                run(["systemctl", "start", unit], check=False)
            else:
                run(["systemctl", "enable", "--now", unit], check=False)
        wanted = set(tree.units)
        for prefix in ("agent-box@", "agent-web-terminal@",
                       "agent-box-settings@", "agent-box-webhook@"):
            for unit in systemd_units_live(prefix):
                if unit not in wanted and "@." not in unit:
                    # `disable` would be a no-op for the same reason; the
                    # drop-in above no longer wants it, so stopping it is
                    # what makes it gone.
                    print(f"stopping {unit} (not in config)")
                    run(["systemctl", "stop", unit], check=False)
        if spec.web_enable:
            run(["systemctl", "reload-or-restart", "caddy.service"],
                check=False)
    if str(Path(MEMORY_SYSCTL)) in removed:
        # The file is gone, so the values do not come back at the next
        # boot — but the running kernel keeps what was last written to it,
        # and apply has no defensible "default" to put back.
        print("note: vm.swappiness and vm.page-cluster keep their current "
              "value until reboot — nothing sets them now")
    for note in rend.notes:
        print(f"note: {note}")
    print(f"apply complete ({changed} change(s))")
    return 0


def ensure_group_user(name, home=None):
    import pwd
    try:
        pwd.getpwnam(name)
        return
    except KeyError:
        # --home-dir without --create-home: StateDirectory= makes the
        # directory (owned by this user) when the unit starts, but passwd
        # has to agree, or $HOME points into /home — which the unit's
        # ProtectHome=true then hides from it.
        run(["useradd", "--system", "--user-group", "--no-create-home",
             *(["--home-dir", home] if home else []),
             "--shell", "/usr/sbin/nologin", name], check=False)


# What a runtime profile has and an individual package does not.
PROFILE_MARKER = Path("share") / "agent-box"


def resolve_profile(explicit):
    """Where the runtime profile is.

    Derived from this script's own location by default: agentbox ships in
    the profile, so the profile is two directories up from bin/agentbox.

    Deliberately NOT Path.resolve(): in a Nix profile bin/agentbox is a
    symlink into agentbox's OWN store path, whose bin/ contains nothing but
    agentbox. Following it lands two directories up from THERE — the
    package, not the profile — and the first live launch died on exactly
    that: "No such file or directory:
    /nix/store/...-agentbox/bin/caddy". The render test never caught it
    because it passes --profile explicitly, so this function was only ever
    exercised on a real box. Keep the resolved path as a candidate anyway,
    for an install that is a plain directory rather than a profile.
    """
    if explicit:
        return Path(explicit).absolute()
    env = os.environ.get("AGENT_BOX_PROFILE")
    if env:
        return Path(env).absolute()
    argv0 = Path(sys.argv[0])
    if not argv0.is_absolute():
        argv0 = Path(shutil.which(argv0.name) or argv0).absolute()
    candidates = [
        argv0.parent.parent,            # a profile, symlink left intact
        argv0.resolve().parent.parent,  # a plain (non-symlinked) install
        Path("/nix/var/nix/profiles/agent-box"),
    ]
    for candidate in candidates:
        if (candidate / PROFILE_MARKER).is_dir():
            return candidate
    return candidates[0]


# --------------------------------------------------------------------------
# Self-update (issue #358)
# --------------------------------------------------------------------------


class UpdateError(Exception):
    """An update that refused to proceed, or failed and was rolled back."""


def github_json(url, timeout=30):
    """One GitHub REST call. Unauthenticated — 60/hour is plenty for this.

    Failures become UpdateError rather than a traceback: unauthenticated
    GitHub is 60 requests an hour PER IP, so on a shared address a rate
    limit is reachable, and "update declined, GitHub said 403" is what the
    journal should carry.
    """
    req = urllib.request.Request(url, headers={
        "Accept": "application/vnd.github+json",
        "User-Agent": "agent-box-update",
    })
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode())
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise UpdateError(f"GitHub request failed ({url}): {e}")


def wall(message):
    """Tell every logged-in terminal, and the journal.

    Best effort: a box without util-linux's `wall` still updates, it just
    updates quietly, so a missing binary must not abort the run.
    """
    print(f"agent-box: {message}", flush=True)
    try:
        run(["wall", f"agent-box: {message}"], check=False, capture=True)
    except OSError:
        pass


def nix_cmd(*args):
    """A nix invocation that works on a host whose nix.conf enables nothing.

    The Determinate installer the templates use turns flakes on globally,
    but a box whose nix came from somewhere else would fail on the flake
    URL alone — and the failure would look like a broken update rather than
    a disabled feature.
    """
    return ["nix", "--extra-experimental-features", "nix-command flakes",
            *args]


def profile_generation(profile):
    """Which generation number the profile symlink points at, or None."""
    try:
        target = os.readlink(str(profile))
    except OSError:
        return None
    m = re.search(r"-(\d+)-link$", target)
    return int(m.group(1)) if m else None


def rollback_to(profile, generation):
    """Walk the profile back to `generation`. True when it got there.

    One `nix profile rollback` at a time rather than a jump, because a
    failed switch can leave the profile one OR two generations ahead: the
    remove-then-install below is two operations, so `rollback` (which knows
    only "the previous one") has to be repeated. The step is bounded and
    stops the moment a rollback stops moving, so a profile that cannot go
    further reports failure instead of spinning.
    """
    if generation is None:
        return False
    for _ in range(8):
        current = profile_generation(profile)
        if current is None:
            return False
        if current <= generation:
            return current == generation
        run(nix_cmd("profile", "rollback", "--profile", str(profile)),
            check=False)
        if profile_generation(profile) == current:
            return False
    return False


# What a profile swap invalidates, in restart order. Sessions are separate
# and go LAST: the agent that triggered the update is inside one, and
# everything else should be back up by the time its tmux server is replaced.
RESTART_PATTERNS = [
    "agent-web-auth-secrets.service",
    "agent-web-terminal@*.service",
    "agent-box-settings@*.socket",
    "agent-box-settings@*.service",
    "agent-box-webhook@*.socket",
    "agent-box-webhook@*.service",
    "caddy.service",
]
SESSION_PATTERN = "agent-box@*.service"


def active_units(pattern):
    """The live units matching `pattern`, in systemd's own order."""
    out = run([SYSTEMCTL, "list-units", "--no-legend", "--plain",
               "--state=active", pattern], check=False, capture=True).stdout
    return [line.split()[0] for line in (out or "").splitlines() if line.strip()]


def restart_units(restart_sessions=True):
    """Restart what a profile swap invalidated but left looking unchanged.

    The rendered units name `<profile>/bin/...` — a path that does not
    change when the profile does — so `apply` after an update honestly
    reports "0 change(s)" while every daemon on the box is still running
    the previous release's code from its already-mapped store path. That
    was observed on a live native box (issue #358): the settings daemon
    kept serving the old page until it was restarted by hand. An update
    therefore restarts these itself; it cannot infer the need from apply.

    What is live is read from systemd rather than derived from the config,
    for two reasons: a service the operator deliberately stopped stays
    stopped, and the recovery path must work even when the config is the
    very thing the new release choked on.
    """
    patterns = RESTART_PATTERNS + ([SESSION_PATTERN] if restart_sessions
                                   else [])
    restarted = []
    for pattern in patterns:
        for unit in active_units(pattern):
            run([SYSTEMCTL, "restart", unit], check=False)
            restarted.append(unit)
            print(f"restarted {unit}")
    return restarted


def apply_args(config, profile):
    """The Namespace `cmd_apply` reads, for an in-process apply."""
    return argparse.Namespace(
        config=config, profile=str(profile), root=None, dry_run=False,
        first_boot=False, settle_delay=0)


def cmd_update(args):
    """Fast-forward the runtime profile to a newer rev of this repo.

    NixOS updates by rewriting a pin file and running nixos-rebuild; none
    of that exists here. What does exist is the profile the software was
    installed into, which records its own origin and keeps a generation
    history — so "what rev am I on", "move to a newer one" and "undo" need
    no pin-file format of their own (issue #154's "native owns:
    profile-based update/rollback", spelled out in #358).

    The one part of the NixOS payload worth porting verbatim is its
    refusal: a target that is not strictly ahead of the running rev means
    upstream history was rewritten or an older, possibly vulnerable rev is
    being replayed, and both are refused.
    """
    profile = resolve_profile(args.profile)
    if args.post_switch:
        return post_switch(args, profile)

    name, element = manifest_element(profile_manifest(profile))
    if not element:
        raise ConfigError(
            f"no runtime element in {profile}/manifest.json — this box's "
            "software did not come from `nix profile install`, so there is "
            "no profile here to fast-forward")
    repo, current = parse_flake_url(element.get("url") or element.get("uri"))
    if args.repo:
        repo = args.repo
    if not repo:
        raise ConfigError(
            "cannot tell which repo this profile came from "
            f"({element.get('url') or element.get('uri')!r}) — pass --repo "
            "OWNER/REPO")
    if not current:
        raise ConfigError(
            f"the profile's {repo} entry is not locked to a commit, so "
            "there is nothing to compare a target against")

    target = github_json(
        f"{GITHUB_API}/repos/{repo}/commits/{args.rev or 'HEAD'}")["sha"]
    if target == current:
        print(f"already current: {repo}@{current[:12]}")
        return 0
    if args.force:
        print(f"skipping the fast-forward check for {target[:12]} (--force)")
    else:
        status = github_json(
            f"{GITHUB_API}/repos/{repo}/compare/{current}...{target}"
        )["status"]
        if status != "ahead":
            raise UpdateError(
                f"refusing update: {target[:12]} is '{status}' of running "
                f"rev {current[:12]} (need fast-forward)")
    if args.check:
        print(f"update available: {current[:12]} -> {target[:12]}")
        return 0

    flake = f"github:{repo}/{target}#{RUNTIME_ATTR}"
    # Two notices, not one, and the promise of a restart is in the second:
    # realizing the closure is the long, failure-prone half, and it happens
    # BEFORE the profile is touched — so a box that cannot fetch or build
    # the new release must not have been told its services were going down.
    wall(f"fetching {repo}@{target[:12]} — nothing has changed yet.")
    # Realize the new closure BEFORE touching the profile, so the window in
    # which the profile has no runtime element (between the remove and the
    # install) is a symlink flip rather than a multi-minute download that
    # can fail halfway.
    try:
        run(nix_cmd("build", "--no-link", flake))
    except subprocess.CalledProcessError as e:
        raise UpdateError(f"building {flake} failed: {e}")
    wall(f"updating to {repo}@{target[:12]} — services restart, including "
         "agent sessions. Save context now.")

    generation = profile_generation(profile)
    try:
        # Remove-then-install, not a bare install: installing over the
        # existing entry fails with "An existing package already provides
        # the following file" and — this is the trap — leaves the OLD
        # profile in place while a following `apply` reports "0 change(s)",
        # so the box looks updated and is not (verified by hand on a live
        # native box, issue #358).
        run(nix_cmd("profile", "remove", "--profile", str(profile), name))
        run(nix_cmd("profile", "install", "--profile", str(profile), flake))
    except subprocess.CalledProcessError as e:
        rollback_to(profile, generation)
        wall(f"update to {target[:12]} FAILED at the profile switch — "
             "rolled back, box unchanged.")
        raise UpdateError(f"profile switch failed: {e}")

    _, installed = profile_origin(profile)
    if installed != target:
        rollback_to(profile, generation)
        wall(f"update to {target[:12]} FAILED verification — rolled back.")
        raise UpdateError(
            f"the profile reports {installed} after installing {target} — "
            "refusing to call that an update")

    # Hand over to the agentbox that was JUST installed. Continuing
    # in-process would run the old renderer against the new profile's
    # assets and config schema — a version skew that shows up as a partial
    # apply, not as an error. (There is no risk to this running process
    # itself: store paths are immutable and its pages stay mapped.)
    child = [str(profile / "bin" / "agentbox"), "update", "--post-switch",
             "--config", args.config, "--profile", str(profile),
             "--from-rev", current]
    # Only when there IS one: a profile path that is not a generation
    # symlink has no number, and passing the string "None" would make phase
    # two's rollback raise ValueError inside its own except handler — the
    # one place that must not throw.
    if generation is not None:
        child += ["--from-generation", str(generation)]
    if args.no_restart_sessions:
        child.append("--no-restart-sessions")
    print(f"switched to {target[:12]}; applying with the new agentbox")
    return subprocess.run(child).returncode


def post_switch(args, profile):
    """Phase two, always run by the newly installed agentbox.

    Renders the host configuration the new release describes and restarts
    the services onto it. Anything that goes wrong here puts the profile
    back where phase one found it and re-applies with that older code, so a
    failed update leaves a working box rather than a half-switched one.
    """
    restart_sessions = not args.no_restart_sessions
    try:
        # Inside the guard: a release that cannot parse this box's config is
        # exactly what the rollback is for, and a ConfigError escaping here
        # would leave the profile switched with nothing put back.
        rc = cmd_apply(apply_args(args.config, profile))
        if rc:
            raise UpdateError(f"`agentbox apply` exited {rc}")
        restarted = restart_units(restart_sessions=restart_sessions)
    except Exception as e:  # noqa: BLE001 - any failure must roll back
        generation = (int(args.from_generation)
                      if args.from_generation else None)
        rolled = rollback_to(profile, generation)
        # Re-apply with the rolled-back code, as a fresh process for the
        # same version-skew reason phase one handed over to us.
        run([str(profile / "bin" / "agentbox"), "apply",
             "--config", args.config, "--profile", str(profile)], check=False)
        restart_units(restart_sessions=restart_sessions)
        wall(f"update FAILED ({e}) — profile "
             + ("rolled back to the previous release."
                if rolled else "COULD NOT be rolled back; see journalctl "
                               f"-u {UPDATE_UNIT}."))
        print(f"agentbox: update failed: {e}", file=sys.stderr)
        return 1
    _, now = profile_origin(profile)
    wall(f"update applied: now at {(now or '?')[:12]}, "
         f"{len(restarted)} service(s) restarted.")
    return 0


# --------------------------------------------------------------------------
# Web auth secrets
# --------------------------------------------------------------------------

WEB_USERS_FILE = "/etc/agent-box/web-users"
AUTH_ENV_DIR = "/run/agent-box-web"
AUTH_ENV_FILE = "/run/agent-box-web/env"
COOKIE_DIR = "/var/lib/agent-box-web"


def env_key(name):
    """The suffix caddy's env placeholders use. Mirrors User.env_key."""
    return name.upper().replace("-", "_")


def hash_algorithm(hashed):
    """Which basic_auth algorithm a stored hash is for.

    Sniffed rather than assumed: first boot always mints argon2id, but the
    password helper can leave a bcrypt hash behind, and caddy's basic_auth
    has to be told which one it is.
    """
    if hashed.startswith("$argon2id$"):
        return "argon2id"
    if hashed.startswith(("$2a$", "$2b$", "$2y$")):
        return "bcrypt"
    raise ConfigError(
        f"unsupported password hash (starts {hashed[:10]!r})")


def read_web_users(path=WEB_USERS_FILE):
    """The web-login manifest: (user, hash file) per line."""
    entries = []
    for line in Path(path).read_text().splitlines():
        if not line.strip():
            continue
        name, _, hash_path = line.partition("\t")
        entries.append((name, hash_path or f"/etc/agent-box/{name}.hash"))
    return entries


def write_auth_env(users):
    """Project the persistent web secrets into /run for caddy.

    /run is tmpfs and caddy.service reads this file with an unprefixed
    EnvironmentFile=, so it has to be rewritten on every boot — see
    Renderer.auth_secrets_unit for what happened when only --first-boot
    wrote it. Both inputs persist, so this is a projection, not a mint:
    the only thing created here is a cookie secret that does not exist yet.

    Written atomically, because caddy may be starting while this runs.
    """
    Path(AUTH_ENV_DIR).mkdir(parents=True, exist_ok=True)
    os.chmod(AUTH_ENV_DIR, 0o700)
    Path(COOKIE_DIR).mkdir(parents=True, exist_ok=True)
    os.chmod(COOKIE_DIR, 0o700)
    lines = []
    for name, hash_path in users:
        cookie_file = Path(COOKIE_DIR) / f"cookie-secret-{name}"
        if not (cookie_file.exists() and cookie_file.read_text().strip()):
            cookie_file.write_text(os.urandom(32).hex() + "\n")
        os.chmod(cookie_file, 0o600)
        hashed = Path(hash_path).read_text().strip()
        key = env_key(name)
        lines += [
            f"WEB_COOKIE_SECRET_{key}={cookie_file.read_text().strip()}",
            f"WEB_PASSWORD_ALGORITHM_{key}={hash_algorithm(hashed)}",
            f"WEB_PASSWORD_HASH_{key}={hashed}",
        ]
    fd, tmp = tempfile.mkstemp(dir=AUTH_ENV_DIR, prefix=".env.")
    try:
        os.fchmod(fd, 0o640)
        with os.fdopen(fd, "w") as fh:
            fh.write("\n".join(lines) + "\n")
        os.replace(tmp, AUTH_ENV_FILE)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise
    return len(users)


def cmd_web_secrets(args):
    """Rebuild /run/agent-box-web/env — agent-web-auth-secrets.service."""
    path = args.manifest
    if not Path(path).is_file():
        raise ConfigError(
            f"{path} does not exist — has `agentbox apply` ever run on this "
            "box? Without the manifest there is no way to know who has a "
            "web login.")
    n = write_auth_env(read_web_users(path))
    print(f"wrote {AUTH_ENV_FILE} for {n} user(s)")
    return 0


# --------------------------------------------------------------------------
# First boot
# --------------------------------------------------------------------------

def settle_public_ip(attempts=60, quiet=3, sleep=10, initial=0):
    """Wait until the public IPv4 stops changing, then return it.

    A cloud provider may attach a static address a minute or two after the
    instance starts, and the hostname is derived from that address — so
    baking in the first answer would bake in the wrong one.
    """
    if initial:
        time.sleep(initial)
    prev, stable = None, 0
    ip = None
    for _ in range(attempts):
        try:
            with urllib.request.urlopen(
                    "https://checkip.amazonaws.com", timeout=5) as r:
                ip = r.read().decode().strip()
        except Exception:
            ip = None
        stable = stable + 1 if ip and ip == prev else 0
        prev = ip
        if stable >= quiet:
            return ip
        time.sleep(sleep)
    if not ip:
        raise ConfigError("no public IPv4 to derive a hostname from")
    return ip


def first_boot(spec, args):
    """What the CloudFormation UserData used to do inline.

    Kept here rather than in a template so both the Lightsail and the EC2
    native templates (and a hand-provisioned box) get the same behavior,
    and so it is testable.
    """
    if spec.domain in ("", "auto", "sslip.io"):
        ip = settle_public_ip(initial=args.settle_delay)
        spec.domain = ip.replace(".", "-") + ".sslip.io"
        if spec.host_label_from_domain:
            spec.host_label = spec.domain
        print(f"derived domain {spec.domain} from {ip}")

    password = os.environ.get("AGENT_BOX_WEB_PASSWORD", "")
    pw_file = os.environ.get("AGENT_BOX_WEB_PASSWORD_FILE", "")
    if not password and pw_file:
        password = Path(pw_file).read_text().strip()
    if spec.web_enable and password:
        # Mint only what has to persist. The /run projection belongs to
        # write_auth_env, which agent-web-auth-secrets.service redoes on
        # every boot — first boot must not be the only thing that can
        # produce that file.
        caddy = str(Path(spec.profile) / "bin" / "caddy")
        Path("/etc/agent-box").mkdir(parents=True, exist_ok=True)
        for u in spec.users:
            # argon2id, and via stdin — the same algorithm and the same
            # invocation the password helper uses for a later change, so a
            # first-boot hash and a changed one are the same kind of hash.
            hashed = subprocess.run(
                [caddy, "hash-password", "--algorithm", "argon2id"],
                input=password + "\n", text=True, check=True,
                capture_output=True).stdout.strip()
            Path(f"/etc/agent-box/{u.name}.hash").write_text(hashed + "\n")
            os.chmod(f"/etc/agent-box/{u.name}.hash", 0o600)
        # The manifest does not exist yet (render runs after first_boot), so
        # the user list is passed straight in.
        write_auth_env([(u.name, f"/etc/agent-box/{u.name}.hash")
                        for u in spec.users])
        print(f"hashed the web password for {len(spec.users)} user(s)")

    # Write the resolved domain back, so a later plain `agentbox apply`
    # (a config edit, an update) renders the same hostname.
    if args.config.endswith(".json"):
        data = json.loads(Path(args.config).read_text())
        data["domain"] = spec.domain
        Path(args.config).write_text(json.dumps(data, indent=2) + "\n")
    else:
        text = Path(args.config).read_text()
        if re.search(r"^domain:", text, re.M):
            text = re.sub(r"^domain:.*$", f"domain: {spec.domain}", text,
                          count=1, flags=re.M)
        else:
            text = f"domain: {spec.domain}\n" + text
        Path(args.config).write_text(text)


def cmd_signal(args):
    """PUT the CloudFormation success signal.

    Separate from apply so the template can signal only after the box is
    actually serving, and so a failed apply leaves the stack to time out
    (and roll back) instead of reporting a box that does not work.
    """
    body = json.dumps({
        "Status": args.status,
        "Reason": args.reason,
        "UniqueId": "agent-box-first-boot",
        "Data": args.reason,
    }).encode()
    req = urllib.request.Request(
        args.url, data=body, method="PUT",
        headers={"Content-Type": ""})
    with urllib.request.urlopen(req, timeout=30) as r:
        print(f"signalled {args.status}: HTTP {r.status}")
    return 0


# --------------------------------------------------------------------------

def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="agentbox", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("apply", help="render and apply host configuration")
    a.add_argument("--config", default=DEFAULT_CONFIG)
    a.add_argument(
        "--profile",
        help="runtime profile path (default: derived from argv[0])")
    a.add_argument(
        "--root",
        help="render into this directory instead of configuring the host")
    a.add_argument("--dry-run", action="store_true",
                   help="report what would change, write nothing")
    a.add_argument("--first-boot", action="store_true",
                   help="also settle the public IP, derive the sslip.io "
                        "hostname and hash the web password")
    a.add_argument(
        "--settle-delay", type=int, default=0,
        help="seconds to wait before the first IP probe")
    a.set_defaults(func=cmd_apply)

    up = sub.add_parser(
        "update",
        help="fast-forward the runtime profile to a newer rev and re-apply")
    up.add_argument("--config", default=DEFAULT_CONFIG)
    up.add_argument(
        "--profile",
        help="runtime profile path (default: derived from argv[0])")
    up.add_argument(
        "--repo", metavar="OWNER/REPO",
        help="repo to update from (default: the one the profile records)")
    up.add_argument(
        "--rev", metavar="REF",
        help="target commit, tag or branch (default: the repo's "
             "default-branch HEAD)")
    up.add_argument("--check", action="store_true",
                    help="report whether an update is available and stop")
    up.add_argument(
        "--force", action="store_true",
        help="skip the fast-forward check — allows moving to a rev that is "
             "behind or on rewritten history, so only for a deliberate "
             "downgrade")
    up.add_argument(
        "--no-restart-sessions", action="store_true",
        help="restart the daemons but leave agent sessions running on the "
             "previous release until they are restarted by hand")
    # Phase two, invoked by phase one on the newly installed agentbox.
    up.add_argument("--post-switch", action="store_true",
                    help=argparse.SUPPRESS)
    up.add_argument("--from-generation", help=argparse.SUPPRESS)
    up.add_argument("--from-rev", help=argparse.SUPPRESS)
    up.set_defaults(func=cmd_update)

    w = sub.add_parser(
        "web-secrets",
        help="rebuild /run/agent-box-web/env from the persisted secrets")
    w.add_argument("--manifest", default=WEB_USERS_FILE,
                   help=f"web-login manifest (default: {WEB_USERS_FILE})")
    w.set_defaults(func=cmd_web_secrets)

    s = sub.add_parser("signal", help="PUT a CloudFormation WaitCondition signal")
    s.add_argument("url")
    s.add_argument("--status", default="SUCCESS",
                   choices=["SUCCESS", "FAILURE"])
    s.add_argument("--reason", default="agent-box first boot complete")
    s.set_defaults(func=cmd_signal)

    args = ap.parse_args(argv)
    try:
        return args.func(args)
    except ConfigError as e:
        print(f"agentbox: {e}", file=sys.stderr)
        return 2
    except UpdateError as e:
        # 1, not 2: the configuration is fine, the update declined to
        # proceed (or failed and rolled back). systemd reports it as a
        # failed unit either way, which is what the settings page reads.
        print(f"agentbox: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
