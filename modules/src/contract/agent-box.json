{
  "unit": "agent-box@",
  "condition": "always",
  "env": [
    { "name": "AGENT_BOX_GREP_BIN", "kind": "bin", "program": "grep" },
    { "name": "AGENT_BOX_FIND_BIN", "kind": "bin", "program": "find" },
    { "name": "AGENT_BOX_FLOCK_BIN", "kind": "bin", "program": "flock" },
    { "name": "AGENT_BOX_HOSTNAME_BIN", "kind": "bin", "program": "hostname" },
    { "name": "AGENT_BOX_ENV_EXEC", "kind": "bin", "program": "agent-box-env-exec" }
  ],
  "execStart": [
    { "kind": "bin", "program": "agent-box-supervisor" }
  ],
  "directives": [
    { "name": "ReadWritePaths", "kind": "paths", "condition": "web",
      "templates": ["/var/lib/agent-box-sites/%i", "/var/lib/agent-box-downloads/%i"] },
    { "name": "NoNewPrivileges", "kind": "bool", "condition": "no-sudo-allowlist" },
    { "name": "OOMScoreAdjust", "kind": "literal", "condition": "protect-memory", "value": 500 }
  ]
}
