        "start": ["auth", "login", "--hostname", "github.com",
                  "--git-protocol", "https", "--web",
                  "--scopes", "repo,read:org,workflow"],
        "status": ["auth", "status", "--hostname", "github.com"],
        "parse": "gh",
        "hosts": ("github.com",),
        "needs_code": False,
        "show_code": True,
        # gh REFUSES to store a credential while GH_TOKEN is set in its
