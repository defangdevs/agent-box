    for item in items:
        if "=" not in item:
            die(f"not a KEY=VALUE assignment: '{item}'")
        key, value = item.split("=", 1)
        if not valid_key(key):
            die(
                f"invalid key '{key}' (use letters, digits, underscore; not "
                "starting with a digit)"
