    if (st) { st.active = -1; }
  }
  function acRender(input) {
    var ul = acList(input);
    var st = input._dir;
    if (!ul || !st) { return; }
    var frag = acSplit(input.value).frag.toLowerCase();
    var matches = st.entries.filter(function (n) {
      return n.toLowerCase().indexOf(frag) === 0;
    });
    ul.innerHTML = "";
    st.active = -1;
    if (!st.entries.length) {
