    {
        "id": "codex",
        "binary": "codex",
        "attr": "codex",
        "label": "Codex",
        "note": "Sign in with your OpenAI account. Follow the link and "
                "enter the code shown here.",
        "start": ["login", "--device-auth"],
        "status": ["login", "status"],
        "parse": "codex",
        "hosts": ("openai.com", "chatgpt.com"),
