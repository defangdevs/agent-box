        # profile, and that one names itself.
        return args.file, ENV_HEADER
    if args.profile:
        if not valid_profile_name(args.profile):
            die(
                f"invalid profile name '{args.profile}' (letters, digits, '_' "
                f"and '-', at most {PROFILE_NAME_MAX} characters)"
