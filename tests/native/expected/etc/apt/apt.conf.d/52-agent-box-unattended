# Generated by `agentbox apply` — do not edit.
//
// Base-OS security patching for a box with no operator at a
// console. Ubuntu's own 50unattended-upgrades still chooses
// WHICH pockets are patched; this file only says that the
// periodic jobs run, and what may happen afterwards.
APT::Periodic::Enable "1";
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Download-Upgradeable-Packages "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";

// Never: the agent sessions this box exists to run live
// in RAM, and nothing here can decide that now is a good
// moment to lose them. Kernel patches therefore wait for
// a reboot somebody performs on purpose.
Unattended-Upgrade::Automatic-Reboot "false";

// Housekeeping, so unattended patching cannot fill the root
// filesystem it is supposed to be protecting.
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Unattended-Upgrade::MinimalSteps "true";
Unattended-Upgrade::SyslogEnable "true";
