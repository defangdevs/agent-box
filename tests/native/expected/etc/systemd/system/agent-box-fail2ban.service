[Unit]
Description=agent-box: ban repeated browser-terminal auth failures
After=caddy.service systemd-journald.service
PartOf=caddy.service

[Service]
Type=simple
Environment=PATH=@PROFILE@/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=@PROFILE@/bin/fail2ban-server -xf -c /etc/agent-box/fail2ban
ExecStop=@PROFILE@/bin/fail2ban-client stop
RuntimeDirectory=agent-box-fail2ban
