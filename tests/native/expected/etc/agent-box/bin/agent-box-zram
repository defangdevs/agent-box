#!/bin/sh
# Generated by `agentbox apply` — do not edit.
# A script, not an ExecStart one-liner: the device name is
# discovered at setup and has to be found again at teardown.
set -eu
dev_file=/run/agent-box-zram.device
case "${1:-start}" in
  start)
    modprobe zram
    size=$(awk '/^MemTotal:/ {print $2 * 1024}' /proc/meminfo)
    dev=$(zramctl --find --size "$size" --algorithm zstd)
    printf %s "$dev" > "$dev_file"
    mkswap "$dev" >/dev/null
    swapon --priority 100 "$dev"
    ;;
  stop)
    [ -r "$dev_file" ] || exit 0
    dev=$(cat "$dev_file")
    swapoff "$dev"
    zramctl --reset "$dev"
    rm -f "$dev_file"
    ;;
esac
