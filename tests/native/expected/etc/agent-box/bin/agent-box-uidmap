#!/bin/sh
# Generated by `agentbox apply` - do not edit.
# Put newuidmap/newgidmap where the shared docker unit's PATH
# looks for them, carrying the file capabilities that let them
# write a multi-ID /proc/<pid>/uid_map. The nix store cannot
# hold a file capability (it is read-only, and the same path is
# shared with every other box on the cache), so these are
# copies - the same thing NixOS's security.wrappers does with
# /run/wrappers/bin, and what shadow's own --with-fcaps install
# mode does on Debian and Fedora.
set -eu
dir=/etc/agent-box/uidmap
src=@PROFILE@/bin
setcap=@PROFILE@/bin/setcap
getcap=@PROFILE@/bin/getcap
mkdir -p "$dir"
for pair in newuidmap:cap_setuid newgidmap:cap_setgid; do
  program=${pair%%:*}
  cap=${pair#*:}
  if ! cmp -s "$src/$program" "$dir/$program"; then
    install -m755 "$src/$program" "$dir/$program.new"
    mv "$dir/$program.new" "$dir/$program"
  fi
  if ! "$getcap" "$dir/$program" \
      | grep "$cap=ep" >/dev/null; then
    "$setcap" "$cap+ep" "$dir/$program"
  fi
done
