#! /nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-python3-3.14.7-env/bin/python3.14
# The env store: ONE implementation of the KEY=value file format that
# ~/.config/agent-box/env and ~/.config/agent-box/profiles/<name>.env are
# written in (issue #212).
#
# Why this is a library and not another copy of the loop
# -----------------------------------------------------
# Six places used to parse this format independently — the env-exec wrapper,
# `agent-box-session env`, `agent-box-profile`, the settings daemon, the
# webhook spawner, and the profile reader inside the wrapper. Every one of
# them re-derived the same three rules (skip a comment, validate the key,
# strip one pair of quotes), and a format CHANGE therefore had to land in six
# dialects at once or the file would mean different things to different
# readers. Multi-line values are exactly such a change: a PEM written by the
# settings page and read by a line-per-pair shell loop does not come back as a
# PEM, it comes back as its first line plus a handful of junk exports.
#
# So the format has one owner. Python, because the readers that cannot be
# Python (a systemd ExecStart, a hook) go through the agent-box-envstore CLI
# instead, and because a quote-and-continuation scanner in POSIX sh is how the
# next bug gets written.
#
# The file format
# ---------------
#   * A line whose first non-blank character is `#`, or that is blank, is a
#     comment. A line with no `=` is skipped, as is one whose key is not
#     [A-Za-z_][A-Za-z0-9_]* — a hand-edited file must never be able to make a
#     reader do something other than set a variable.
#   * An UNQUOTED value ends at the end of its line, with trailing whitespace
#     removed. Use quotes to keep whitespace. `KEY = value` is not an
#     assignment: the key is `KEY ` and the line is skipped.
#   * A DOUBLE-QUOTED value may span lines: it ends at the next unescaped `"`,
#     however many newlines away that is. `\"` is a literal quote and `\\` a
#     literal backslash; every other backslash is itself, and a newline is a
#     newline. `\n` is NOT an escape — this is systemd's env-file rule
#     (env-file.c), which is what an operator moving a PEM off a systemd box
#     expects, and it means a value can never smuggle in a character the file
#     does not literally contain.
#   * A SINGLE-QUOTED value is legacy: one pair of quotes is stripped when
#     both sit on the same line. It does not continue across lines. Kept
#     because the pre-#212 readers stripped it and files in the wild have it.
#   * An unterminated `"` does not swallow the rest of the file. The line is
#     taken as a legacy raw value and parsing resumes with the next one, so
#     one corrupt entry costs one entry.
#   * A value may not contain NUL, and an entry that does is skipped on read
#     and refused on write. execve cannot carry one anyway — the variable
#     would silently truncate at it — and NUL is what frames the argument
#     vectors this store feeds (see session-cli.sh's profile decode), so a
#     value holding one could turn itself into two arguments.
#
# Writing is the exact inverse: a value is quoted only when it has to be, so a
# file of ordinary tokens stays the plain KEY=value text that `grep` and a
# human both expect.
#
# A write is a read-modify-write, so it takes a lock. os.replace makes a
# READER see a whole document and nothing more, but it does not stop two
# writers that both started from the same base: the second one publishes a
# file that never contained the first one's key, and a secret disappears with
# no error anywhere. That is agent-box#254 in another file. One lock covers
# every writer here because every writer now goes through this function —
# in-process for the settings daemon, through agent-box-envstore for the
# shell CLIs — which is the point of the format having one owner.
import contextlib
import fcntl
import json
import os
import re
import tempfile

# The key charset every reader already agreed on (the settings daemon's
# KEY_RE, the shell CLIs' valid_key).
KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*\Z")

ENV_HEADER = (
    "# Managed by agent-box settings page. KEY=value, one per line.\n"
    "# Do not add secrets by hand here unless you know what you are doing.\n"
    "# A value may span lines when it is double-quoted (issue #212).\n"
)

# Launch config, not environment: agent-box-profile turns these into harness
# arguments and env-exec must not export them (a SYSTEM_PROMPT in the
# environment of everything the agent runs is a footgun, not a feature).
PROFILE_RESERVED = ("HARNESS", "MODEL", "EFFORT", "SYSTEM_PROMPT")


def profile_header(name):
    return (
        f'# agent-box agent profile "{name}" — managed by agent-box-profile.\n'
        "# KEY=value, one per line. HARNESS/MODEL/EFFORT/SYSTEM_PROMPT become\n"
        "# harness arguments; any other key becomes session environment, which\n"
        "# every session of this user can read (issue #135).\n"
        "# A value may span lines when it is double-quoted (issue #212).\n"
    )


def valid_key(key):
    return bool(KEY_RE.match(key))


def valid_value(value):
    """NUL disqualifies a value. See the format notes at the top."""
    return "\0" not in value


def _unescape(text):
    """Resolve `\\"` and `\\\\`; leave every other backslash literal."""
    out = []
    i = 0
    while i < len(text):
        char = text[i]
        if char == "\\" and text[i + 1:i + 2] in ('"', "\\"):
            out.append(text[i + 1])
            i += 2
        else:
            out.append(char)
            i += 1
    return "".join(out)


def _scan_quoted(rest, lines, index):
    """Read a double-quoted value whose opening quote is already consumed.

    `rest` is what followed that quote on its own line, `lines[index:]` the
    lines after it. Returns (value, next_index), or None when the quote is
    never closed — the caller then falls back to the legacy single-line
    reading rather than losing every entry below it.
    """
    chunks = []
    buf = rest
    while True:
        piece = []
        pos = 0
        while pos < len(buf):
            char = buf[pos]
            # Keep the escape pair intact here and resolve it once, after the
            # lines are joined; that way a `\"` cannot be mistaken for the
            # terminator and a `\\` cannot hide one.
            if char == "\\" and buf[pos + 1:pos + 2] in ('"', "\\"):
                piece.append(buf[pos:pos + 2])
                pos += 2
                continue
            if char == '"':
                chunks.append("".join(piece))
                return _unescape("\n".join(chunks)), index
            piece.append(char)
            pos += 1
        chunks.append("".join(piece))
        if index >= len(lines):
            return None
        buf = lines[index]
        index += 1


def parse(text):
    """Return the file's [(key, value)] in file order, junk lines skipped.

    Later duplicates are kept as duplicates; callers that want one value per
    key take the last (see `as_dict`), which is what every reader of this
    format has always done.
    """
    lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    pairs = []
    index = 0
    while index < len(lines):
        # Left-stripped, never fully stripped: a quoted value owns every byte
        # after its opening quote, trailing blanks on a continued line
        # included.
        line = lines[index].lstrip()
        index += 1
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        # No strip on the key: `KEY = value` is not this format, and a reader
        # that quietly accepted it disagreed with the four that did not. The
        # line's own leading indentation is already gone (lstrip above).
        if not valid_key(key):
            continue
        if value.startswith('"'):
            scanned = _scan_quoted(value[1:], lines, index)
            if scanned is not None:
                value, index = scanned
                if valid_value(value):
                    pairs.append((key, value))
                continue
            # Unterminated quote: fall through and read THIS line the legacy
            # way, leaving the lines below it to be parsed on their own.
        value = value.rstrip()
        if len(value) >= 2 and value.startswith("'") and value.endswith("'"):
            value = value[1:-1]
        if not valid_value(value):
            continue
        pairs.append((key, value))
    return pairs


def as_dict(pairs):
    """Collapse [(key, value)] to {key: value}, last occurrence winning."""
    return dict(pairs)


def load(path):
    """`parse` the file at `path`; a missing or unreadable file is empty.

    Unreadable is deliberately not an error: this runs on the session-spawn
    path, where a permission problem on the secrets file must cost the
    secrets, not the session.
    """
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            return parse(handle.read())
    except OSError:
        return []


def needs_quoting(value):
    if value != value.strip():
        return True
    if any(char in value for char in '\n\r"\\'):
        return True
    return value[:1] in ("'", '"')


def quote(value):
    """Render one value, quoting it only when the format requires it."""
    if not needs_quoting(value):
        return value
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def render(pairs, header=""):
    return header + "".join(f"{key}={quote(value)}\n" for key, value in pairs)


class EnvStoreError(ValueError):
    """A value the format cannot carry."""


def save(path, pairs, header="", mode=0o600, dir_mode=0o700):
    """Atomically publish `pairs` to `path`.

    Same rename-over-a-temp-file-in-the-same-directory shape the settings
    daemon and both shell CLIs already used, so a reader either sees the old
    file or the new one. 0600 because the value beside the key is a secret.
    """
    for key, value in pairs:
        if not valid_value(value):
            raise EnvStoreError(f"{key}: a value may not contain NUL")
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, mode=dir_mode, exist_ok=True)
    # makedirs applies `mode` only when it CREATES the directory, and a
    # directory made by an older `mkdir -p` under umask 022 is 0755. The old
    # shell writer chmod'ed it on every write for that reason; keep doing so,
    # because the file inside is a secret.
    try:
        os.chmod(directory, dir_mode)
    except OSError:
        pass
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".envstore.")
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(render(pairs, header))
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


@contextlib.contextmanager
def locked(path):
    """Hold an exclusive advisory lock on `path` for one read-modify-write.

    The lock file sits beside the store, the convention sessions.json already
    uses. fcntl rather than util-linux's flock(1) because every writer of this
    format is python now; the shell CLIs reach it through agent-box-envstore
    and inherit the lock without knowing it exists.
    """
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, mode=0o700, exist_ok=True)
    handle = open(path + ".lock", "a", encoding="utf-8")
    try:
        try:
            os.fchmod(handle.fileno(), 0o600)
        except OSError:
            pass
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield
    finally:
        handle.close()


def update(path, assignments, header="", drop=(), must_exist=False):
    """Rewrite `path` with `drop` and the assigned keys removed, then append.

    One read-modify-write under the lock, so `set` keeps the file's order for
    untouched keys and moves a re-set key to the end — the behavior the shell
    `env_rewrite` and the daemon's `set_key` both had — and a concurrent
    writer cannot drop the key this one did not touch.

    `must_exist` refuses to CREATE the file, and is why the check belongs
    here rather than in the caller: an `os.path.exists` before this call sits
    outside the lock, so a concurrent delete lands between the two and the
    write recreates the file the other writer had just removed — with values
    from a form that may itself be stale. Returns whether anything was
    written; False only ever means "it was gone".
    """
    with locked(path):
        if must_exist and not os.path.exists(path):
            return False
        doomed = set(drop) | {key for key, _ in assignments}
        kept = [(k, v) for (k, v) in load(path) if k not in doomed]
        save(path, kept + list(assignments), header)
        return True


def keys(path):
    """Sorted, de-duplicated key NAMES — never the values.

    The settings page and both CLIs list keys and refuse to show values; that
    rule belongs to the format's owner, not to each caller.
    """
    return sorted({key for key, _ in load(path)})


def dumps(path):
    """The store as a JSON object, for the shell callers that hold jq."""
    return json.dumps(as_dict(load(path)), ensure_ascii=False)


# Secret custody: the wire protocol, at-rest encryption, and the record
# store (issue #922).
#
# One owner for the things the root broker, the worker, and the unprivileged
# CLI and MCP adapter must agree on: how a request is framed, which names
# are legal, how a value is protected on disk, and how a client calls the
# broker's socket. The broker and worker use the Store below; the CLI and
# MCP adapter never touch it, because the whole point is that the agent
# user cannot read the records - they only ever call connect_and_call.
#
# Spliced ABOVE secret-broker.py, secret-cli.py, and secrets-mcp.py (with
# secret-jobs.py spliced between protocol and broker) by the generated
# module, so the names bind in all three; this file therefore has no
# `if __name__` block.
# secret-worker.py is NOT spliced with this file - it runs as the ordinary
# agent user and has no need of `cryptography` or the Store, so keeping it
# standalone keeps its dependency closure as small as a bare python3.
import base64
import binascii
import contextlib
import fcntl
import json
import os
import re
import socket
import struct

from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
from cryptography.hazmat.primitives.kdf.hkdf import HKDF

SECRET_NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,63}$")
# Same charset agent-box-profile's valid_name already enforces (profile-
# cli.sh), so a namespace is always a name that CLI could also have created.
PROFILE_NAME_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
SECRET_MAX_FRAME = 64 * 1024
SECRET_MAX_VALUE = 32 * 1024
SECRET_MAX_NAMES = 256
SECRET_MAX_ENV = 64
SECRET_MAX_ARGV = 64
SECRET_MAX_ARG_LEN = 4096
SECRET_MAX_CWD_LEN = 4096
SECRET_MAX_IDEMPOTENCY_LEN = 128
SECRET_DEFAULT_TIMEOUT_MS = 10 * 60 * 1000
SECRET_MAX_TIMEOUT_MS = 60 * 60 * 1000
SECRET_MAX_JOBS_PER_USER = 2
SECRET_MAX_OUTPUT_BYTES = 64 * 1024
SECRET_JOB_RETENTION_SECONDS = 24 * 60 * 60

# Where agent-box-profile's own default pointer lives (profile-cli.sh's
# DIR/DEFAULT_FILE). Secrets have no separate "global" bucket (deprecated in
# favor of the box's actual default profile, 2026-11-13): a request naming no
# --profile resolves to whichever profile `agent-box-profile default` names,
# exactly like a session agent-box-session add starts with neither --profile
# nor --harness already does. A box with no default profile has no secret
# request without --profile to fall back to at all.
PROFILES_DIR_PARTS = (".config", "agent-box", "profiles")
DEFAULT_PROFILE_FILE = ".default"

SECRET_OPS = ("list", "set", "remove", "exec", "status", "cancel")
ENV_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*\Z")
IDEMPOTENCY_RE = re.compile(r"^[A-Za-z0-9_.:-]{1,%d}$" % SECRET_MAX_IDEMPOTENCY_LEN)


class SecretError(Exception):
    """A refusal the caller may be told about; never carries a value."""


def valid_secret_name(name):
    return isinstance(name, str) and SECRET_NAME_RE.match(name) is not None


def valid_secret_value(value):
    if not isinstance(value, str) or value == "" or "\0" in value:
        return False
    return len(value.encode("utf-8")) <= SECRET_MAX_VALUE


def valid_profile(name):
    return isinstance(name, str) and PROFILE_NAME_RE.match(name) is not None


def resolve_profile(explicit, home=None):
    """Turn "no --profile given" into a concrete name, the way
    `agent-box-session add` already resolves no --profile/--harness into
    the box's default profile: there is no OTHER fallback. Secrets have no
    separate global scope - the issue's original plan deferred per-profile
    scope and kept one bucket per Linux user; in review, lionello deprecated
    that bucket outright in favor of resolving straight to whichever profile
    `agent-box-profile default` currently names (2026-11-13), with layered
    profile overlays left for later (cf. Nix overlays).

    Used by the CLI, the MCP adapter, and env-exec.py - all of which run as
    the ordinary agent user and can read agent-box-profile's own pointer
    file themselves, exactly as profile-cli.sh's default_name() does. The
    broker never parses this file: every request it receives already names
    a concrete profile, resolved by the caller before it was sent."""
    if explicit is not None:
        if not valid_profile(explicit):
            raise SecretError("invalid profile")
        return explicit
    home = home or os.path.expanduser("~")
    no_default = SecretError(
        "no --profile given and no default profile is set "
        "(see `agent-box-profile default`)")
    pointer = os.path.join(home, *PROFILES_DIR_PARTS, DEFAULT_PROFILE_FILE)
    try:
        with open(pointer, "r") as handle:
            name = handle.readline().rstrip("\n")
    except OSError:
        raise no_default
    if not valid_profile(name):
        raise no_default
    if not os.path.isfile(os.path.join(home, *PROFILES_DIR_PARTS, f"{name}.env")):
        raise no_default
    return name


def recv_exact(conn, count):
    chunks = []
    while count:
        chunk = conn.recv(count)
        if not chunk:
            raise SecretError("connection closed mid-frame")
        chunks.append(chunk)
        count -= len(chunk)
    return b"".join(chunks)


def send_frame(conn, obj):
    body = json.dumps(obj, separators=(",", ":")).encode("utf-8")
    if len(body) > SECRET_MAX_FRAME:
        raise SecretError("response too large")
    conn.sendall(struct.pack(">I", len(body)) + body)


def connect_and_call(sock_path, req, timeout=15):
    """One round trip to the broker: connect, send the request, read the
    reply, close. The one client the CLI and the MCP adapter both need, so
    a fix to one (a longer timeout for a slow systemd-run start, a retry) is
    a fix to both rather than a fix that only one of them got. Never raises:
    a transport failure comes back shaped exactly like a protocol refusal
    ({"ok": False, "error": ...}), which is what every caller already
    checks for."""
    if not sock_path:
        return {"ok": False, "error": "secrets are not enabled on this box"}
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    conn.settimeout(timeout)
    try:
        conn.connect(sock_path)
        send_frame(conn, req)
        return recv_frame(conn)
    except (OSError, SecretError) as exc:
        return {"ok": False, "error": f"broker unavailable: {exc}"}
    finally:
        conn.close()


def recv_frame(conn):
    (length,) = struct.unpack(">I", recv_exact(conn, 4))
    # The length is checked BEFORE any allocation: a peer must not be able to
    # make the root process reserve memory by lying in four bytes.
    if length == 0 or length > SECRET_MAX_FRAME:
        raise SecretError("bad frame length")
    try:
        obj = json.loads(recv_exact(conn, length).decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise SecretError("malformed request")
    if not isinstance(obj, dict):
        raise SecretError("malformed request")
    return obj


def _valid_argv_item(item):
    return (isinstance(item, str) and item != "" and "\0" not in item
            and len(item.encode("utf-8")) <= SECRET_MAX_ARG_LEN)


def _valid_env_map(env):
    if not isinstance(env, dict) or len(env) > SECRET_MAX_ENV:
        return False
    for key, value in env.items():
        if not ENV_KEY_RE.match(key):
            return False
        if not isinstance(value, str) or "\0" in value:
            return False
        if len(value.encode("utf-8")) > SECRET_MAX_VALUE:
            return False
    return True


def _valid_name_list(names):
    if not isinstance(names, list) or len(names) > SECRET_MAX_NAMES:
        return False
    return all(valid_secret_name(name) for name in names)


def validate_request(req):
    """Strict schema: unknown fields are refused, not ignored, so a caller
    cannot smuggle a uid, a path, or a unit property past a future reader."""
    op = req.get("op")
    if op not in SECRET_OPS:
        raise SecretError("unknown operation")
    allowed = {
        "list": {"op", "profile"},
        "set": {"op", "profile", "name", "value"},
        "remove": {"op", "profile", "name"},
        "exec": {"op", "profile", "argv", "command", "shell", "secretNames",
                 "cwd", "env", "timeoutMs", "idempotencyKey"},
        "status": {"op", "profile", "jobId"},
        "cancel": {"op", "profile", "jobId"},
    }[op]
    if set(req) - allowed:
        raise SecretError("unexpected field")
    # Always required: there is no "no profile" scope on the wire. A caller
    # with no --profile resolves one client-side (resolve_profile, above)
    # before building the request at all.
    if not valid_profile(req.get("profile")):
        raise SecretError("invalid profile")
    if op in ("set", "remove") and not valid_secret_name(req.get("name")):
        raise SecretError("invalid name")
    if op == "set" and not valid_secret_value(req.get("value")):
        raise SecretError("invalid value")
    if op in ("status", "cancel"):
        job_id = req.get("jobId")
        if not isinstance(job_id, str) or not re.match(r"^[A-Za-z0-9_-]{1,64}$", job_id):
            raise SecretError("invalid job id")
    if op == "exec":
        _validate_exec_request(req)
    return op


def _validate_exec_request(req):
    has_argv = "argv" in req
    has_command = "command" in req
    if has_argv == has_command:
        raise SecretError("exactly one of argv or command is required")
    if has_argv:
        argv = req["argv"]
        if (not isinstance(argv, list) or not argv or len(argv) > SECRET_MAX_ARGV
                or not all(_valid_argv_item(item) for item in argv)):
            raise SecretError("invalid argv")
        if "shell" in req:
            raise SecretError("shell is only valid with command")
    else:
        if not _valid_argv_item(req.get("command")):
            raise SecretError("invalid command")
        if req.get("shell") not in ("bash", "sh"):
            raise SecretError("shell must be bash or sh")
    names = req.get("secretNames", [])
    if not _valid_name_list(names):
        raise SecretError("invalid secretNames")
    if "cwd" in req:
        cwd = req["cwd"]
        if (not isinstance(cwd, str) or not cwd.startswith("/") or "\0" in cwd
                or len(cwd.encode("utf-8")) > SECRET_MAX_CWD_LEN):
            raise SecretError("invalid cwd")
    if "env" in req and not _valid_env_map(req["env"]):
        raise SecretError("invalid env")
    if set(req.get("env", {})) & set(names):
        raise SecretError("env may not name a requested secret")
    if "timeoutMs" in req:
        timeout = req["timeoutMs"]
        if not isinstance(timeout, int) or isinstance(timeout, bool) or not (0 < timeout <= SECRET_MAX_TIMEOUT_MS):
            raise SecretError("invalid timeoutMs")
    if "idempotencyKey" in req:
        key = req["idempotencyKey"]
        if not isinstance(key, str) or not IDEMPOTENCY_RE.match(key):
            raise SecretError("invalid idempotencyKey")


# --- At-rest encryption -----------------------------------------------------
#
# Phase 1 (this file): one root key, generated once, held in a root-only
# file beside the per-user namespaces. It never leaves this box. A record's
# value is AES-256-GCM under a key HKDF-derived per (user, namespace) from
# that root key, with (user, namespace, name, version) as AAD so a ciphertext
# copied into another slot fails to decrypt rather than silently decrypting
# as something else.
#
# Phase 2 (tracked in issue #922's follow-up) replaces load_root_key with a
# call to an external KMS/keyvault and nothing else here changes: every
# caller already goes through this one function to get the bytes it derives
# namespace keys from.
ROOT_KEY_BYTES = 32


def load_root_key(path):
    """The box-wide root key, creating it on first use. Callers hold this in
    memory only; it is never written anywhere but this one 0600 file."""
    try:
        with open(path, "rb") as handle:
            key = handle.read()
    except FileNotFoundError:
        key = None
    if key is not None:
        if len(key) != ROOT_KEY_BYTES:
            raise SecretError("root key corrupt")
        return key
    # Create it atomically. A loser of the race below simply re-reads the
    # winner's file instead of overwriting it.
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, mode=0o700, exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        new_key = os.urandom(ROOT_KEY_BYTES)
        with os.fdopen(fd, "wb") as handle:
            handle.write(new_key)
            handle.flush()
            os.fsync(handle.fileno())
        try:
            os.link(tmp, path)
        except FileExistsError:
            pass
    finally:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
    return load_root_key(path)


def _namespace_key(root_key, user, namespace):
    hkdf = HKDF(algorithm=hashes.SHA256(), length=32, salt=None,
                info=f"agent-box-secret-v1:{user}:{namespace}".encode("utf-8"))
    return hkdf.derive(root_key)


def _aad(user, namespace, name, version):
    return f"{user}:{namespace}:{name}:{version}".encode("utf-8")


def _encrypt(key, aad, plaintext):
    nonce = os.urandom(12)
    ct = AESGCM(key).encrypt(nonce, plaintext.encode("utf-8"), aad)
    return nonce, ct


def _decrypt(key, aad, nonce, ct):
    try:
        return AESGCM(key).decrypt(nonce, ct, aad).decode("utf-8")
    except Exception:
        raise SecretError("decryption failed")


def _next_version(old_record):
    """old_record is whatever _read() handed back for a slot that may never
    have been written, or may have been written by code this broker no
    longer recognizes. Either way, a version counter that cannot be trusted
    must not raise - it starts over at 1 rather than crash the request."""
    try:
        version = old_record.get("version", 0)
        if not isinstance(version, int) or isinstance(version, bool):
            return 1
        return version + 1
    except AttributeError:
        return 1


class Store:
    """Root-only records for ONE (user, profile) namespace.

    Layout: <root>/<namespace>/{meta.json,.lock,<NAME>.rec}, where <root> is
    this user's own directory and <namespace> is always a concrete profile
    name - callers resolve "no --profile given" before this is ever
    constructed (see resolve_profile). Every access goes through a
    directory fd with O_NOFOLLOW, so a planted symlink is an error and
    never a redirect; every
    write is temp-file + fsync + rename, so a crash leaves the old record or
    the new one. Values are encrypted before they ever reach _write (see
    set/get below); _read/_write themselves do not know about secrecy, only
    about atomic JSON records.
    """

    def __init__(self, root, namespace, user, uid, root_key):
        if not re.match(r"^[A-Za-z0-9_.-]{1,64}$", namespace) or namespace in (".", ".."):
            raise SecretError("invalid namespace")
        os.makedirs(root, mode=0o700, exist_ok=True)
        root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            try:
                os.mkdir(namespace, 0o700, dir_fd=root_fd)
            except FileExistsError:
                pass
            self.dir_fd = os.open(namespace, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                  dir_fd=root_fd)
        finally:
            os.close(root_fd)
        self.user = user
        self.namespace = namespace
        self._key = _namespace_key(root_key, user, namespace)
        self._bind(user, uid)

    def close(self):
        os.close(self.dir_fd)

    def _read(self, name):
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=self.dir_fd)
        except FileNotFoundError:
            return None
        except OSError:
            raise SecretError("store entry unreadable")
        with os.fdopen(fd, "rb") as handle:
            try:
                obj = json.loads(handle.read(SECRET_MAX_FRAME * 2))
            except ValueError:
                raise SecretError("store entry corrupt")
        if not isinstance(obj, dict):
            raise SecretError("store entry corrupt")
        return obj

    def _write(self, name, obj):
        tmp = f".{name}.tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW,
                     0o600, dir_fd=self.dir_fd)
        with os.fdopen(fd, "wb") as handle:
            handle.write(json.dumps(obj).encode("utf-8"))
            handle.flush()
            os.fsync(handle.fileno())
        os.rename(tmp, name, src_dir_fd=self.dir_fd, dst_dir_fd=self.dir_fd)
        os.fsync(self.dir_fd)

    def _bind(self, user, uid):
        # A namespace is bound to the identity it was created for. A uid that
        # was recycled for a different account must not inherit the records.
        meta = self._read("meta.json")
        if meta is None:
            self._write("meta.json", {"user": user, "uid": uid})
        elif meta.get("user") != user or meta.get("uid") != uid:
            raise SecretError("namespace belongs to another identity")

    def _locked(self):
        fd = os.open(".lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600,
                     dir_fd=self.dir_fd)
        fcntl.flock(fd, fcntl.LOCK_EX)
        return fd

    def list(self):
        """Names and metadata only; no value is ever decrypted here."""
        out = []
        for entry in sorted(os.listdir(self.dir_fd)):
            if not entry.endswith(".rec") or not valid_secret_name(entry[:-4]):
                continue
            rec = self._read(entry) or {}
            out.append({"name": entry[:-4], "version": rec.get("version", 0),
                        "configured": not rec.get("tombstone", False)})
        return out

    def set(self, name, value):
        lock = self._locked()
        try:
            old = self._read(name + ".rec") or {}
            version = _next_version(old)
            nonce, ct = _encrypt(self._key, _aad(self.user, self.namespace, name, version), value)
            self._write(name + ".rec", {
                "version": version,
                "nonce": base64.b64encode(nonce).decode("ascii"),
                "ct": base64.b64encode(ct).decode("ascii"),
            })
            return version
        finally:
            os.close(lock)

    def get(self, name):
        """Decrypt one value. Only the exec path calls this - list/set/
        remove never see plaintext. Raises SecretError (never a bare
        KeyError/ValueError/binascii.Error) for anything short of a valid
        record, including one written by an incompatible earlier format -
        the caller must be able to treat "cannot resolve this name" as one
        kind of failure, not crash the whole process on it."""
        rec = self._read(name + ".rec")
        if rec is None or rec.get("tombstone"):
            return None
        try:
            nonce = base64.b64decode(rec["nonce"], validate=True)
            ct = base64.b64decode(rec["ct"], validate=True)
            version = rec["version"]
            if not isinstance(version, int) or isinstance(version, bool):
                raise ValueError("bad version")
        except (KeyError, ValueError, TypeError, binascii.Error):
            raise SecretError("store entry corrupt")
        aad = _aad(self.user, self.namespace, name, version)
        return _decrypt(self._key, aad, nonce, ct)

    def remove(self, name):
        """Delete the value but keep a tombstone, so a retired name stays
        protected rather than reappearing from a stale legacy copy."""
        lock = self._locked()
        try:
            old = self._read(name + ".rec")
            if old is None:
                raise SecretError("no such secret")
            version = _next_version(old)
            self._write(name + ".rec", {"version": version, "tombstone": True})
            return version
        finally:
            os.close(lock)


def handle_request(store, req):
    """Handles the non-exec ops. exec/status/cancel are dispatched by the
    broker directly (they need the job manager, not just a Store)."""
    op = validate_request(req)
    if op == "list":
        return {"ok": True, "secrets": store.list()[:SECRET_MAX_NAMES]}
    if op == "set":
        return {"ok": True, "version": store.set(req["name"], req["value"])}
    if op == "remove":
        return {"ok": True, "version": store.remove(req["name"])}
    raise SecretError("unsupported here")


# Secret custody: advisory detection of plaintext secrets, never migration
# (issue #922).
#
# This file answers one question - "which names in this user's env store or
# profiles LOOK like secrets and are not yet in the broker?" - and nothing
# else. It never reads a value, never writes anywhere, and nothing that
# calls it is allowed to use the answer to copy a value into the broker.
# That is deliberate: a value that has been sitting in a plaintext env file
# has already been exposed (readable via /proc, possibly logged, possibly
# in a shell history or an old backup), so moving the SAME bytes into an
# encrypted store would launder that exposure rather than end it. The only
# real fix is rotating the credential at its source and setting a FRESH
# value with `agent-box-secret set`; this module exists to point that out
# loudly and repeatedly, not to paper over it with a one-time copy.
#
# Called from three places, all read-only: `agent-box-secret list` (the
# CLI), the settings page's env/profile editor, and a root-run advisory
# step in the box's own update path (agentbox apply / the NixOS activation
# equivalent) - chosen over "wait a couple of releases" specifically
# because a box's owner decides when it updates, so there is no shared
# clock to count releases against. Every one of the three calls this with
# a REAL root_key path or dir listing it can read; none of them call the
# broker to ask it to decrypt anything, because this never needs to.
#
# Spliced ABOVE secret-cli.py (and the settings daemon, and the apply-time
# report script) by the generated module, after lib/envstore.py, so load()
# already exists when this runs.
import os
import re

# A heuristic, not a classifier: suffix-shaped names a human would
# recognize as "probably a credential". False positives are fine and
# expected here (WEB_COOKIE_SECRET_* is not a user secret, for instance) -
# this only ever produces a hint for a human to judge, never an action.
# False negatives just mean a name using neither convention gets no hint,
# which is the same as today's behavior.
CANDIDATE_NAME_RE = re.compile(
    r"(^|_)(TOKEN|KEY|SECRET|PASSWORD|PASSWD|CREDENTIALS?|APIKEY|PAT)S?($|_)",
    re.IGNORECASE,
)


def looks_like_a_secret(name):
    return bool(CANDIDATE_NAME_RE.search(name))


def _names_in(path):
    return [key for key, _ in load(path)]


def list_profiles(home):
    """Every profile this user has, by name - a plain directory listing,
    the same set `agent-box-profile ls` would show."""
    profiles_dir = os.path.join(home, ".config", "agent-box", "profiles")
    try:
        entries = os.listdir(profiles_dir)
    except OSError:
        return []
    names = []
    for entry in entries:
        if entry.endswith(".env") and not entry.startswith("."):
            names.append(entry[:-len(".env")])
    return sorted(names)


def protected_names(store_root, namespace):
    """Names already in the broker's namespace for this user, read the way
    root can - straight off the record filenames, no decryption, no socket.
    A profile the broker has never seen (no directory yet) is simply empty.
    Callers without filesystem access to store_root (an ordinary CLI call,
    for instance) pass the names they already got from `agent-box-secret
    list` instead - see scan()'s `known` parameter."""
    try:
        entries = os.listdir(os.path.join(store_root, namespace))
    except OSError:
        return set()
    return {entry[:-len(".rec")] for entry in entries if entry.endswith(".rec")}


def scan(home, store_root=None, known_by_namespace=None, default_profile=None):
    """Every candidate name in this user's env store and profiles that is
    not already registered in the matching broker namespace.

    `store_root` (this user's /var/lib/agent-box-secrets/<user>, root-
    readable only) is used when the caller can read it directly - the
    apply-time report, say. A caller that cannot (an ordinary CLI
    invocation) instead passes `known_by_namespace`, a
    {namespace: set-of-names} map it already asked the broker for over its
    own socket. Giving neither simply reports every candidate as
    unprotected, which is still a safe (over-) estimate, never an under-
    one: the worst this function does wrong is mention a name that
    actually is already protected, not miss one that is not.

    `default_profile` is this user's CURRENT default profile name (there is
    no separate "_global" namespace any more - see resolve_profile), needed
    only to resolve the shared env file's own candidates against the right
    `store_root` directory. A caller with no default profile (or that does
    not know it) can leave this unset; the env file's candidates are then
    reported as unprotected rather than guessed at.

    Returns a list of {"name", "scope", "path"} dicts, "scope" being
    "env" (the box-wide file every session loads, default-profile
    sessions and every other profile's sessions alike) or "profile:NAME".
    """
    known_by_namespace = known_by_namespace or {}

    def already_known(namespace, name):
        if namespace in known_by_namespace:
            return name in known_by_namespace[namespace]
        if store_root:
            real_namespace = default_profile if namespace is None else namespace
            if real_namespace is not None:
                return name in protected_names(store_root, real_namespace)
        return False

    out = []
    config = os.path.join(home, ".config", "agent-box")
    env_path = os.path.join(config, "env")
    for name in _names_in(env_path):
        if looks_like_a_secret(name) and not already_known(None, name):
            out.append({"name": name, "scope": "env", "path": env_path})

    for profile in list_profiles(home):
        profile_path = os.path.join(config, "profiles", f"{profile}.env")
        for name in _names_in(profile_path):
            if looks_like_a_secret(name) and not already_known(profile, name):
                out.append({"name": name, "scope": f"profile:{profile}",
                           "path": profile_path})
    return out


HINT_LINES = (
    "These names look like credentials and are still stored in plain text:",
    "The exact bytes have already been exposed (every process of this user "
    "can read them), so copying them into agent-box-secret would not undo "
    "that - rotate each one at its source, then store the NEW value with "
    "`agent-box-secret set NAME --stdin` (add --profile NAME for a profile, "
    "not the shared env file).",
)


def format_hint(candidates):
    """The human-readable notice shared by the CLI, the apply-time report,
    and (as plain text for a tooltip) the settings page. Empty when there
    is nothing to report."""
    if not candidates:
        return ""
    lines = [HINT_LINES[0]]
    for item in candidates:
        where = "the shared env file" if item["scope"] == "env" else item["scope"]
        lines.append(f"  {item['name']}  ({where})")
    lines.append(HINT_LINES[1])
    return "\n".join(lines)


"""agent-box-secret-candidates-report - advisory-only, run on every apply
(issue #922).

Prints, for each configured user given on argv, which of their env-store
and profile names look like credentials and are not yet in the broker.
Never acts on what it finds (see lib/secret-candidates.py's header) and
never fails: a box owner decides when to run `agentbox apply` / the NixOS
switch, so there is no shared release clock to count against before
assuming everyone has moved a value over - this runs on EVERY apply
instead, for as long as there is something left to report, and naturally
stops printing once an owner has acted (or never prints anything on a box
that never had a plaintext-shaped name to begin with).

Root-only in practice (apply/activation runs as root), which is what lets
it read every configured user's $HOME and the root-owned secret store
directly - no socket, no decryption, just directory listings and the env-
store parser already used everywhere else. A user who does not exist yet
(a config pointed at a name useradd has not created) is skipped quietly:
this never blocks apply over an advisory step.

Exit status is always 0: this prints to stdout, which `agentbox apply` and
a NixOS activation script already surface to whoever ran the command, but
it is advisory and must never make either kind of apply fail.
"""
import pwd
import sys


def main(argv):
    any_found = False
    for user in argv:
        try:
            home = pwd.getpwnam(user).pw_dir
        except KeyError:
            continue
        store_root = f"/var/lib/agent-box-secrets/{user}"
        default_profile = None
        try:
            default_profile = resolve_profile(None, home=home)
        except SecretError:
            pass
        candidates = scan(home, store_root=store_root, default_profile=default_profile)
        hint = format_hint(candidates)
        if hint:
            if not any_found:
                sys.stdout.write(
                    "agent-box secrets: plaintext credential(s) found, not "
                    "yet protected (issue #922):\n\n")
                any_found = True
            sys.stdout.write(f"  [{user}]\n")
            for line in hint.splitlines():
                sys.stdout.write(f"  {line}\n")
            sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
