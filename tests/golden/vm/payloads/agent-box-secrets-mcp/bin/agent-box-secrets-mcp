#! /nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-python3-3.14.7-env/bin/python3.14
# Secret custody: the wire protocol, at-rest encryption, and the record
# store (issue #922).
#
# One owner for the things the root broker, the worker, and the unprivileged
# CLI and MCP adapter must agree on: how a request is framed, which names
# are legal, how a value is protected on disk, and how a client calls the
# broker's socket. The broker and worker use the Store below; the CLI and
# MCP adapter never touch it, because the whole point is that the agent
# user cannot read the records - they only ever call connect_and_call.
#
# Spliced ABOVE secret-broker.py, secret-cli.py, and secrets-mcp.py (with
# secret-jobs.py spliced between protocol and broker) by the generated
# module, so the names bind in all three; this file therefore has no
# `if __name__` block.
# secret-worker.py is NOT spliced with this file - it runs as the ordinary
# agent user and has no need of `cryptography` or the Store, so keeping it
# standalone keeps its dependency closure as small as a bare python3.
import base64
import binascii
import contextlib
import fcntl
import hashlib
import hmac
import json
import os
import re
import secrets as _secrets_rng
import socket
import stat
import string
import struct
import time
import urllib.parse

from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
from cryptography.hazmat.primitives.kdf.hkdf import HKDF

SECRET_NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,63}$")
# Same charset agent-box-profile's valid_name already enforces (profile-
# cli.sh), so a namespace is always a name that CLI could also have created.
PROFILE_NAME_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
SECRET_MAX_FRAME = 64 * 1024
SECRET_MAX_VALUE = 32 * 1024
SECRET_MAX_NAMES = 256
SECRET_MAX_ENV = 64
SECRET_MAX_ARGV = 64
SECRET_MAX_ARG_LEN = 4096
SECRET_MAX_CWD_LEN = 4096
SECRET_MAX_IDEMPOTENCY_LEN = 128
SECRET_DEFAULT_TIMEOUT_MS = 10 * 60 * 1000
SECRET_MAX_TIMEOUT_MS = 60 * 60 * 1000
SECRET_MAX_JOBS_PER_USER = 2
SECRET_MAX_OUTPUT_BYTES = 64 * 1024
SECRET_JOB_RETENTION_SECONDS = 24 * 60 * 60
# Finished jobs keep their (capped) output for the retention window above, and
# a finished job no longer counts against SECRET_MAX_JOBS_PER_USER. Without a
# second bound a caller could run jobs back to back and grow the broker's
# memory for a whole day: 256 retained jobs is at most 256 x 2 x 64 KiB = 32
# MiB per user. A new exec is refused at the bound, not an old result evicted,
# so a result stays readable for its whole retention window.
SECRET_MAX_RETAINED_JOBS_PER_USER = 256
# A profile name is cheap to mint and each new one is a persistent directory
# plus meta.json under the user's store. The broker's open-store cache bounds
# descriptors, not disk, so the number of namespaces is capped here; existing
# namespaces stay reachable past the cap, only a NEW one is refused.
SECRET_MAX_NAMESPACES_PER_USER = 128

# Where agent-box-profile's own default pointer lives (profile-cli.sh's
# DIR/DEFAULT_FILE). Secrets have no separate "global" bucket (deprecated in
# favor of the box's actual default profile, 2026-11-13): a request naming no
# --profile resolves to whichever profile `agent-box-profile default` names,
# exactly like a session agent-box-session add starts with neither --profile
# nor --harness already does. A box with no default profile has no secret
# request without --profile to fall back to at all.
PROFILES_DIR_PARTS = (".config", "agent-box", "profiles")
DEFAULT_PROFILE_FILE = ".default"

SECRET_OPS = ("list", "set", "remove", "exec", "status", "cancel",
              "generate", "fill", "save-cookies", "load-cookies")
# What a record's value IS, which decides what the broker hands out for it:
#   value   - the plain value (the default; every record written before
#             kinds existed reads as this one)
#   totp    - a TOTP seed (base32, or an otpauth:// URI). exec and fill get
#             the CURRENT one-time code; the seed itself never leaves the
#             broker, not even into a job.
#   cookies - a browser session: {"cookies": [...], "origins": []}, the
#             shape Playwright's storageState uses, so an exec job can hand
#             it straight to `browser.new_context(storage_state=...)`.
SECRET_KINDS = ("value", "totp", "cookies")
SECRET_MAX_ORIGINS = 8
SECRET_MAX_ORIGIN_LEN = 256
SECRET_MAX_SELECTOR_LEN = 1024
SECRET_MAX_COOKIES = 300
SECRET_GENERATE_DEFAULT_LENGTH = 24
SECRET_GENERATE_MIN_LENGTH = 12
SECRET_GENERATE_MAX_LENGTH = 128
# Symbols every site we have met accepts in a password: no quote, backslash,
# slash, backtick, pipe or space, which are the ones forms and shells mangle.
SECRET_GENERATE_SYMBOLS = "!#$%&()*+,-.:;<=>?@[]^_{}~"
CDP_TARGET_ID_RE = re.compile(r"^[A-Za-z0-9]{1,64}$")
ENV_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*\Z")
IDEMPOTENCY_RE = re.compile(r"^[A-Za-z0-9_.:-]{1,%d}$" % SECRET_MAX_IDEMPOTENCY_LEN)


class SecretError(Exception):
    """A refusal the caller may be told about; never carries a value."""


def valid_secret_name(name):
    return isinstance(name, str) and SECRET_NAME_RE.match(name) is not None


def valid_secret_value(value):
    if not isinstance(value, str) or value == "" or "\0" in value:
        return False
    return len(value.encode("utf-8")) <= SECRET_MAX_VALUE


def valid_profile(name):
    return isinstance(name, str) and PROFILE_NAME_RE.match(name) is not None


def resolve_profile(explicit, home=None):
    """Turn "no --profile given" into a concrete name, the way
    `agent-box-session add` already resolves no --profile/--harness into
    the box's default profile: there is no OTHER fallback. Secrets have no
    separate global scope - the issue's original plan deferred per-profile
    scope and kept one bucket per Linux user; in review, lionello deprecated
    that bucket outright in favor of resolving straight to whichever profile
    `agent-box-profile default` currently names (2026-11-13), with layered
    profile overlays left for later (cf. Nix overlays).

    Used by the CLI, the MCP adapter, and env-exec.py - all of which run as
    the ordinary agent user and can read agent-box-profile's own pointer
    file themselves, exactly as profile-cli.sh's default_name() does. The
    broker never parses this file: every request it receives already names
    a concrete profile, resolved by the caller before it was sent."""
    if explicit is not None:
        if not valid_profile(explicit):
            raise SecretError("invalid profile")
        return explicit
    home = home or os.path.expanduser("~")
    no_default = SecretError(
        "no --profile given and no default profile is set "
        "(see `agent-box-profile default`)")
    pointer = os.path.join(home, *PROFILES_DIR_PARTS, DEFAULT_PROFILE_FILE)
    try:
        with open(pointer, "r") as handle:
            name = handle.readline().rstrip("\n")
    except OSError:
        raise no_default
    if not valid_profile(name):
        raise no_default
    if not os.path.isfile(os.path.join(home, *PROFILES_DIR_PARTS, f"{name}.env")):
        raise no_default
    return name


def recv_exact(conn, count):
    chunks = []
    while count:
        chunk = conn.recv(count)
        if not chunk:
            raise SecretError("connection closed mid-frame")
        chunks.append(chunk)
        count -= len(chunk)
    return b"".join(chunks)


def send_frame(conn, obj):
    body = json.dumps(obj, separators=(",", ":")).encode("utf-8")
    if len(body) > SECRET_MAX_FRAME:
        raise SecretError("response too large")
    conn.sendall(struct.pack(">I", len(body)) + body)


def connect_and_call(sock_path, req, timeout=15):
    """One round trip to the broker: connect, send the request, read the
    reply, close. The one client the CLI and the MCP adapter both need, so
    a fix to one (a longer timeout for a slow systemd-run start, a retry) is
    a fix to both rather than a fix that only one of them got. Never raises:
    a transport failure comes back shaped exactly like a protocol refusal
    ({"ok": False, "error": ...}), which is what every caller already
    checks for."""
    if not sock_path:
        return {"ok": False, "error": "secrets are not enabled on this box"}
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    conn.settimeout(timeout)
    try:
        conn.connect(sock_path)
        send_frame(conn, req)
        return recv_frame(conn)
    except (OSError, SecretError) as exc:
        return {"ok": False, "error": f"broker unavailable: {exc}"}
    finally:
        conn.close()


def recv_frame(conn):
    (length,) = struct.unpack(">I", recv_exact(conn, 4))
    # The length is checked BEFORE any allocation: a peer must not be able to
    # make the root process reserve memory by lying in four bytes.
    if length == 0 or length > SECRET_MAX_FRAME:
        raise SecretError("bad frame length")
    try:
        obj = json.loads(recv_exact(conn, length).decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise SecretError("malformed request")
    if not isinstance(obj, dict):
        raise SecretError("malformed request")
    return obj


def _valid_argv_item(item):
    return (isinstance(item, str) and item != "" and "\0" not in item
            and len(item.encode("utf-8")) <= SECRET_MAX_ARG_LEN)


def _valid_env_map(env):
    if not isinstance(env, dict) or len(env) > SECRET_MAX_ENV:
        return False
    for key, value in env.items():
        if not ENV_KEY_RE.match(key):
            return False
        if not isinstance(value, str) or "\0" in value:
            return False
        if len(value.encode("utf-8")) > SECRET_MAX_VALUE:
            return False
    return True


def _valid_name_list(names):
    if not isinstance(names, list) or len(names) > SECRET_MAX_NAMES:
        return False
    return all(valid_secret_name(name) for name in names)


def validate_request(req):
    """Strict schema: unknown fields are refused, not ignored, so a caller
    cannot smuggle a uid, a path, or a unit property past a future reader."""
    op = req.get("op")
    if op not in SECRET_OPS:
        raise SecretError("unknown operation")
    allowed = {
        "list": {"op", "profile"},
        "set": {"op", "profile", "name", "value", "kind", "origins", "fillOnly"},
        "remove": {"op", "profile", "name"},
        "exec": {"op", "profile", "argv", "command", "shell", "secretNames",
                 "cwd", "env", "timeoutMs", "idempotencyKey"},
        "status": {"op", "profile", "jobId"},
        "cancel": {"op", "profile", "jobId"},
        "generate": {"op", "profile", "name", "length", "symbols", "origins", "fillOnly"},
        "fill": {"op", "profile", "name", "cdpPort", "targetId", "selector", "timeoutMs"},
        "save-cookies": {"op", "profile", "name", "cdpPort", "targetId", "origins",
                         "fillOnly", "timeoutMs"},
        "load-cookies": {"op", "profile", "name", "cdpPort", "targetId", "timeoutMs"},
    }[op]
    if set(req) - allowed:
        raise SecretError("unexpected field")
    # Always required: there is no "no profile" scope on the wire. A caller
    # with no --profile resolves one client-side (resolve_profile, above)
    # before building the request at all.
    if not valid_profile(req.get("profile")):
        raise SecretError("invalid profile")
    if op in ("set", "remove", "generate", "fill", "save-cookies", "load-cookies") \
            and not valid_secret_name(req.get("name")):
        raise SecretError("invalid name")
    if op == "set" and not valid_secret_value(req.get("value")):
        raise SecretError("invalid value")
    if op in ("set", "generate", "save-cookies"):
        _validate_meta_fields(op, req)
    if op == "set":
        kind = req.get("kind", "value")
        if kind == "totp":
            parse_totp(req["value"])
        elif kind == "cookies":
            parse_cookie_state(req["value"])
    if op == "generate":
        length = req.get("length", SECRET_GENERATE_DEFAULT_LENGTH)
        if (not isinstance(length, int) or isinstance(length, bool)
                or not SECRET_GENERATE_MIN_LENGTH <= length <= SECRET_GENERATE_MAX_LENGTH):
            raise SecretError("invalid length (%d-%d)" % (
                SECRET_GENERATE_MIN_LENGTH, SECRET_GENERATE_MAX_LENGTH))
        if not isinstance(req.get("symbols", True), bool):
            raise SecretError("invalid symbols")
    if op in ("fill", "save-cookies", "load-cookies"):
        _validate_browser_fields(op, req)
    if op in ("status", "cancel"):
        job_id = req.get("jobId")
        if not isinstance(job_id, str) or not re.match(r"^[A-Za-z0-9_-]{1,64}$", job_id):
            raise SecretError("invalid job id")
    if op == "exec":
        _validate_exec_request(req)
    return op


def normalize_origin(text):
    """Reduce a URL to the web origin a browser reports for it - scheme,
    lower-case host, and a port only when it is not the scheme's default -
    which is exactly the string Chromium puts in a frame's securityOrigin,
    so a fill compares two strings and nothing else. https always; http
    only for a loopback host, where a local test server lives. A host that
    is not plain ASCII is refused rather than guessed at: give its punycode
    (xn--) form, which is what the browser reports."""
    if not isinstance(text, str) or not text or len(text) > SECRET_MAX_ORIGIN_LEN:
        raise SecretError("invalid origin")
    try:
        parts = urllib.parse.urlsplit(text.strip())
        port = parts.port
    except ValueError:
        raise SecretError(f"invalid origin: {text}")
    scheme = parts.scheme.lower()
    host = (parts.hostname or "").lower()
    if not host or not host.isascii() or parts.username or parts.password:
        raise SecretError(f"invalid origin: {text}")
    if not re.match(r"^[a-z0-9.:\[\]-]+$", host):
        raise SecretError(f"invalid origin: {text}")
    loopback = host in ("localhost", "127.0.0.1", "::1")
    if scheme != "https" and not (scheme == "http" and loopback):
        raise SecretError(f"origin must be https (http only for localhost): {text}")
    default_port = 443 if scheme == "https" else 80
    shown_host = f"[{host}]" if ":" in host else host
    if port is not None and port != default_port:
        return f"{scheme}://{shown_host}:{port}"
    return f"{scheme}://{shown_host}"


def _validate_meta_fields(op, req):
    kind = req.get("kind", "value")
    if kind not in SECRET_KINDS:
        raise SecretError("invalid kind")
    origins = req.get("origins", [])
    if (not isinstance(origins, list) or len(origins) > SECRET_MAX_ORIGINS
            or any(normalize_origin(o) != o for o in origins)):
        # The client normalizes; the broker only accepts what normalizing
        # would not change, so what list shows is exactly what fill matches.
        raise SecretError("invalid origins (give normalized origins, at most %d)"
                          % SECRET_MAX_ORIGINS)
    fill_only = req.get("fillOnly", False)
    if not isinstance(fill_only, bool):
        raise SecretError("invalid fillOnly")
    if fill_only and not origins:
        raise SecretError("fillOnly needs at least one origin")
    if op == "save-cookies" and not origins:
        raise SecretError("save-cookies needs at least one origin")


def _validate_browser_fields(op, req):
    port = req.get("cdpPort")
    if not isinstance(port, int) or isinstance(port, bool) or not 1 <= port <= 65535:
        raise SecretError("invalid cdpPort")
    if "targetId" in req and not (isinstance(req["targetId"], str)
                                  and CDP_TARGET_ID_RE.match(req["targetId"])):
        raise SecretError("invalid targetId")
    if op == "fill":
        selector = req.get("selector")
        if (not isinstance(selector, str) or not selector or "\0" in selector
                or len(selector.encode("utf-8")) > SECRET_MAX_SELECTOR_LEN):
            raise SecretError("invalid selector")
    if "timeoutMs" in req:
        timeout = req["timeoutMs"]
        if not isinstance(timeout, int) or isinstance(timeout, bool) or not (0 < timeout <= SECRET_MAX_TIMEOUT_MS):
            raise SecretError("invalid timeoutMs")


def record_meta_from_request(req, kind=None):
    """The non-secret metadata a set/generate/save-cookies request asks the
    record to carry. Only non-default fields are kept, so a plain `set`
    writes a record byte-for-byte shaped like the ones before kinds."""
    meta = {}
    kind = kind or req.get("kind", "value")
    if kind != "value":
        meta["kind"] = kind
    if req.get("origins"):
        meta["origins"] = list(req["origins"])
    if req.get("fillOnly"):
        meta["fillOnly"] = True
    return meta


# --- TOTP (RFC 6238) ----------------------------------------------------------


def parse_totp(value):
    """(key, digits, period, algorithm) from a base32 seed or an
    otpauth://totp/ URI - the two shapes a site's "set up your
    authenticator" page offers. Refuses anything else, so a typo is caught
    when the seed is stored rather than at the first login."""
    text = value.strip()
    digits, period, algorithm = 6, 30, "SHA1"
    if text.lower().startswith("otpauth://"):
        parts = urllib.parse.urlsplit(text)
        if parts.netloc.lower() != "totp":
            raise SecretError("only otpauth://totp/ URIs are supported")
        query = urllib.parse.parse_qs(parts.query)
        seed = (query.get("secret") or [""])[0]
        try:
            digits = int((query.get("digits") or ["6"])[0])
            period = int((query.get("period") or ["30"])[0])
        except ValueError:
            raise SecretError("invalid TOTP parameters")
        algorithm = (query.get("algorithm") or ["SHA1"])[0].upper()
    else:
        seed = text
    seed = re.sub(r"[\s-]", "", seed).upper()
    if not seed or not re.match(r"^[A-Z2-7]+=*$", seed):
        raise SecretError("invalid TOTP seed (expected base32)")
    try:
        key = base64.b32decode(seed.rstrip("=") + "=" * (-len(seed.rstrip("=")) % 8))
    except (binascii.Error, ValueError):
        raise SecretError("invalid TOTP seed (expected base32)")
    if not key or digits not in (6, 7, 8) or not 15 <= period <= 120 \
            or algorithm not in ("SHA1", "SHA256", "SHA512"):
        raise SecretError("invalid TOTP parameters")
    return key, digits, period, algorithm


def totp_code(value, now=None):
    key, digits, period, algorithm = parse_totp(value)
    counter = int((time.time() if now is None else now) // period)
    mac = hmac.new(key, struct.pack(">Q", counter),
                   getattr(hashlib, algorithm.lower())).digest()
    offset = mac[-1] & 0x0F
    code = (struct.unpack(">I", mac[offset:offset + 4])[0] & 0x7FFFFFFF) % (10 ** digits)
    return str(code).zfill(digits)


# --- Generated passwords and stored browser sessions -----------------------------


def generate_password(length=SECRET_GENERATE_DEFAULT_LENGTH, symbols=True):
    """A random password with at least one character of every class it
    draws from, because most sign-up forms refuse one without."""
    classes = [string.ascii_lowercase, string.ascii_uppercase, string.digits]
    if symbols:
        classes.append(SECRET_GENERATE_SYMBOLS)
    alphabet = "".join(classes)
    while True:
        candidate = "".join(_secrets_rng.choice(alphabet) for _ in range(length))
        if all(any(ch in cls for ch in candidate) for cls in classes):
            return candidate


COOKIE_FIELDS = ("name", "value", "domain", "path", "expires", "httpOnly", "secure", "sameSite")


def parse_cookie_state(value):
    """A stored browser session: Playwright's storageState shape, cookies
    only. Returns the cookie list; refuses anything else so a load never
    hands the browser something it did not come from."""
    try:
        state = json.loads(value)
    except ValueError:
        raise SecretError("cookies value is not JSON")
    cookies = state.get("cookies") if isinstance(state, dict) else None
    if not isinstance(cookies, list) or len(cookies) > SECRET_MAX_COOKIES:
        raise SecretError("cookies value needs a \"cookies\" list")
    for cookie in cookies:
        if (not isinstance(cookie, dict) or not isinstance(cookie.get("name"), str)
                or not isinstance(cookie.get("value"), str)
                or not isinstance(cookie.get("domain"), str)):
            raise SecretError("each cookie needs name, value and domain")
    return cookies


def _validate_exec_request(req):
    has_argv = "argv" in req
    has_command = "command" in req
    if has_argv == has_command:
        raise SecretError("exactly one of argv or command is required")
    if has_argv:
        argv = req["argv"]
        if (not isinstance(argv, list) or not argv or len(argv) > SECRET_MAX_ARGV
                or not all(_valid_argv_item(item) for item in argv)):
            raise SecretError("invalid argv")
        if "shell" in req:
            raise SecretError("shell is only valid with command")
    else:
        if not _valid_argv_item(req.get("command")):
            raise SecretError("invalid command")
        if req.get("shell") not in ("bash", "sh"):
            raise SecretError("shell must be bash or sh")
    names = req.get("secretNames", [])
    if not _valid_name_list(names):
        raise SecretError("invalid secretNames")
    if "cwd" in req:
        cwd = req["cwd"]
        if (not isinstance(cwd, str) or not cwd.startswith("/") or "\0" in cwd
                or len(cwd.encode("utf-8")) > SECRET_MAX_CWD_LEN):
            raise SecretError("invalid cwd")
    if "env" in req and not _valid_env_map(req["env"]):
        raise SecretError("invalid env")
    if set(req.get("env", {})) & set(names):
        raise SecretError("env may not name a requested secret")
    if "timeoutMs" in req:
        timeout = req["timeoutMs"]
        if not isinstance(timeout, int) or isinstance(timeout, bool) or not (0 < timeout <= SECRET_MAX_TIMEOUT_MS):
            raise SecretError("invalid timeoutMs")
    if "idempotencyKey" in req:
        key = req["idempotencyKey"]
        if not isinstance(key, str) or not IDEMPOTENCY_RE.match(key):
            raise SecretError("invalid idempotencyKey")


# --- At-rest encryption -----------------------------------------------------
#
# Phase 1 (this file): one root key, generated once, held in a root-only
# file beside the per-user namespaces. It never leaves this box. A record's
# value is AES-256-GCM under a key HKDF-derived per (user, namespace) from
# that root key, with (user, namespace, name, version) as AAD so a ciphertext
# copied into another slot fails to decrypt rather than silently decrypting
# as something else.
#
# Phase 2 (tracked in issue #922's follow-up) replaces load_root_key with a
# call to an external KMS/keyvault and nothing else here changes: every
# caller already goes through this one function to get the bytes it derives
# namespace keys from.
ROOT_KEY_BYTES = 32


def _fsync_dir(directory):
    dir_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(dir_fd)
    finally:
        os.close(dir_fd)


def load_root_key(path):
    """The box-wide root key, creating it on first use. Callers hold this in
    memory only; it is never written anywhere but this one 0600 file."""
    try:
        with open(path, "rb") as handle:
            key = handle.read()
    except FileNotFoundError:
        key = None
    if key is not None:
        if len(key) != ROOT_KEY_BYTES:
            raise SecretError("root key corrupt")
        # A concurrent creator may have linked this key and not yet synced
        # the directory; sync it here so records are never written under a
        # key whose directory entry could still be lost.
        _fsync_dir(os.path.dirname(path) or ".")
        return key
    # Create it atomically. A loser of the race below simply re-reads the
    # winner's file instead of overwriting it.
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, mode=0o700, exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        new_key = os.urandom(ROOT_KEY_BYTES)
        with os.fdopen(fd, "wb") as handle:
            handle.write(new_key)
            handle.flush()
            os.fsync(handle.fileno())
        try:
            os.link(tmp, path)
        except FileExistsError:
            pass
    finally:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
    # The file fsync above does not make the new directory entry durable:
    # without this, a power loss could drop .rootkey while records already
    # encrypted under it survive, and the next start would mint a different
    # key that cannot decrypt them.
    _fsync_dir(directory)
    return load_root_key(path)


def _namespace_key(root_key, user, namespace):
    hkdf = HKDF(algorithm=hashes.SHA256(), length=32, salt=None,
                info=f"agent-box-secret-v1:{user}:{namespace}".encode("utf-8"))
    return hkdf.derive(root_key)


def _aad(user, namespace, name, version):
    return f"{user}:{namespace}:{name}:{version}".encode("utf-8")


def _encrypt(key, aad, plaintext):
    nonce = os.urandom(12)
    ct = AESGCM(key).encrypt(nonce, plaintext.encode("utf-8"), aad)
    return nonce, ct


def _decrypt(key, aad, nonce, ct):
    try:
        return AESGCM(key).decrypt(nonce, ct, aad).decode("utf-8")
    except Exception:
        raise SecretError("decryption failed")


def _next_version(old_record):
    """old_record is whatever _read() handed back for a slot that may never
    have been written, or may have been written by code this broker no
    longer recognizes. Either way, a version counter that cannot be trusted
    must not raise - it starts over at 1 rather than crash the request."""
    try:
        version = old_record.get("version", 0)
        if not isinstance(version, int) or isinstance(version, bool):
            return 1
        return version + 1
    except AttributeError:
        return 1


def _fsync_dir(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _makedirs_durable(path):
    """os.makedirs(path, 0o700), then fsync EVERY ancestor of path, on every
    call (fsync(2): syncing a directory does not persist its own entry in
    ITS parent). Unconditional because a retry cannot tell which levels an
    earlier attempt created before one of its syncs failed: it finds them
    all existing, and every entry on the way down must still be made
    durable before a write under them is acknowledged. The Store is cached
    per namespace, so this is a handful of fsyncs per profile, not per
    request."""
    path = os.path.abspath(path)
    os.makedirs(path, mode=0o700, exist_ok=True)
    ancestor = os.path.dirname(path)
    while True:
        _fsync_dir(ancestor)
        parent = os.path.dirname(ancestor)
        if parent == ancestor:
            break
        ancestor = parent


class Store:
    """Root-only records for ONE (user, profile) namespace.

    Layout: <root>/<namespace>/{meta.json,.lock,<NAME>.rec}, where <root> is
    this user's own directory and <namespace> is always a concrete profile
    name - callers resolve "no --profile given" before this is ever
    constructed (see resolve_profile). Every access goes through a
    directory fd with O_NOFOLLOW, so a planted symlink is an error and
    never a redirect; every
    write is temp-file + fsync + rename, so a crash leaves the old record or
    the new one. Values are encrypted before they ever reach _write (see
    set/get below); _read/_write themselves do not know about secrecy, only
    about atomic JSON records.
    """

    @staticmethod
    def exists(root, namespace):
        """True if this namespace already has a directory. Read-only ops
        ask this first so a `list` with an invented profile name does not
        create (and permanently spend a quota slot on) a namespace."""
        try:
            return stat.S_ISDIR(os.lstat(os.path.join(root, namespace)).st_mode)
        except (FileNotFoundError, NotADirectoryError):
            return False

    def __init__(self, root, namespace, user, uid, root_key):
        if not re.match(r"^[A-Za-z0-9_.-]{1,64}$", namespace) or namespace in (".", ".."):
            raise SecretError("invalid namespace")
        _makedirs_durable(root)
        root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            try:
                os.stat(namespace, dir_fd=root_fd, follow_symlinks=False)
            except FileNotFoundError:
                existing = [e for e in os.listdir(root_fd) if not e.startswith(".")]
                if len(existing) >= SECRET_MAX_NAMESPACES_PER_USER:
                    raise SecretError("too many secret profiles for this user") from None
                try:
                    os.mkdir(namespace, 0o700, dir_fd=root_fd)
                except FileExistsError:
                    pass
            # Every time, not only after our own mkdir: fsync on the
            # namespace itself (in _write) does not persist its ENTRY in
            # the parent, and a retry after a failed sync finds the
            # directory already there. Without this a crash after an
            # acknowledged `set` could lose the whole profile.
            os.fsync(root_fd)
            self.dir_fd = os.open(namespace, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                  dir_fd=root_fd)
        finally:
            os.close(root_fd)
        self.user = user
        self.namespace = namespace
        try:
            self._key = _namespace_key(root_key, user, namespace)
            self._bind(user, uid)
        except BaseException:
            # The broker does not cache a Store that failed to build, so
            # every retry would otherwise leak one more descriptor.
            os.close(self.dir_fd)
            raise

    def close(self):
        os.close(self.dir_fd)

    def _read(self, name):
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=self.dir_fd)
        except FileNotFoundError:
            return None
        except OSError:
            raise SecretError("store entry unreadable")
        with os.fdopen(fd, "rb") as handle:
            try:
                obj = json.loads(handle.read(SECRET_MAX_FRAME * 2))
            except ValueError:
                raise SecretError("store entry corrupt")
        if not isinstance(obj, dict):
            raise SecretError("store entry corrupt")
        return obj

    def _write(self, name, obj):
        tmp = f".{name}.tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW,
                     0o600, dir_fd=self.dir_fd)
        with os.fdopen(fd, "wb") as handle:
            handle.write(json.dumps(obj).encode("utf-8"))
            handle.flush()
            os.fsync(handle.fileno())
        os.rename(tmp, name, src_dir_fd=self.dir_fd, dst_dir_fd=self.dir_fd)
        os.fsync(self.dir_fd)

    def _bind(self, user, uid):
        # A namespace is bound to the identity it was created for. A uid that
        # was recycled for a different account must not inherit the records.
        meta = self._read("meta.json")
        if meta is None:
            self._write("meta.json", {"user": user, "uid": uid})
        elif meta.get("user") != user or meta.get("uid") != uid:
            raise SecretError("namespace belongs to another identity")

    def _locked(self):
        fd = os.open(".lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600,
                     dir_fd=self.dir_fd)
        fcntl.flock(fd, fcntl.LOCK_EX)
        return fd

    def list(self):
        """Names and metadata only; no value is ever decrypted here."""
        out = []
        for entry in sorted(os.listdir(self.dir_fd)):
            if not entry.endswith(".rec") or not valid_secret_name(entry[:-4]):
                continue
            rec = self._read(entry) or {}
            item = {"name": entry[:-4], "version": rec.get("version", 0),
                    "configured": not rec.get("tombstone", False)}
            if item["configured"]:
                item.update(_public_meta(rec))
            out.append(item)
        return out

    def _name_count(self):
        return sum(1 for entry in os.listdir(self.dir_fd)
                   if entry.endswith(".rec") and valid_secret_name(entry[:-4]))

    def set(self, name, value, meta=None):
        lock = self._locked()
        try:
            old = self._read(name + ".rec") or {}
            if not old and self._name_count() >= SECRET_MAX_NAMES:
                # list() reports at most SECRET_MAX_NAMES names, and env-exec
                # strips only names it is told about, so the store must
                # never hold more names than one response can carry.
                raise SecretError("too many secrets")
            version = _next_version(old)
            nonce, ct = _encrypt(self._key, _aad(self.user, self.namespace, name, version), value)
            record = {
                "version": version,
                "nonce": base64.b64encode(nonce).decode("ascii"),
                "ct": base64.b64encode(ct).decode("ascii"),
            }
            if meta:
                # Plaintext on purpose: list() shows it without decrypting.
                # It is root-only like the ciphertext, and it changes only
                # together with the value (set/generate/save-cookies), so a
                # caller cannot move a fill-only secret to a new origin
                # without also replacing what the old origin knew.
                record["meta"] = meta
            self._write(name + ".rec", record)
            return version
        finally:
            os.close(lock)

    def get(self, name):
        """Decrypt one value. Only the exec path calls this - list/set/
        remove never see plaintext. Raises SecretError (never a bare
        KeyError/ValueError/binascii.Error) for anything short of a valid
        record, including one written by an incompatible earlier format -
        the caller must be able to treat "cannot resolve this name" as one
        kind of failure, not crash the whole process on it."""
        rec = self._read(name + ".rec")
        if rec is None or rec.get("tombstone"):
            return None
        try:
            nonce = base64.b64decode(rec["nonce"], validate=True)
            ct = base64.b64decode(rec["ct"], validate=True)
            version = rec["version"]
            if not isinstance(version, int) or isinstance(version, bool):
                raise ValueError("bad version")
        except (KeyError, ValueError, TypeError, binascii.Error):
            raise SecretError("store entry corrupt")
        aad = _aad(self.user, self.namespace, name, version)
        return _decrypt(self._key, aad, nonce, ct)

    def meta(self, name):
        """The record's non-secret metadata, defaults filled in, or None for
        a name that is missing or removed. Never decrypts anything."""
        rec = self._read(name + ".rec")
        if rec is None or rec.get("tombstone"):
            return None
        return _public_meta(rec)

    def remove(self, name):
        """Delete the value but keep a tombstone, so a retired name stays
        protected rather than reappearing from a stale legacy copy."""
        lock = self._locked()
        try:
            old = self._read(name + ".rec")
            if old is None:
                raise SecretError("no such secret")
            version = _next_version(old)
            self._write(name + ".rec", {"version": version, "tombstone": True})
            return version
        finally:
            os.close(lock)


def _public_meta(rec):
    meta = rec.get("meta") if isinstance(rec.get("meta"), dict) else {}
    kind = meta.get("kind", "value")
    origins = meta.get("origins", [])
    return {
        "kind": kind if kind in SECRET_KINDS else "value",
        "origins": [o for o in origins if isinstance(o, str)] if isinstance(origins, list) else [],
        "fillOnly": meta.get("fillOnly") is True,
    }


def handle_request(store, req):
    """Handles the non-exec ops. exec/status/cancel are dispatched by the
    broker directly (they need the job manager, not just a Store)."""
    op = validate_request(req)
    if op == "list":
        return {"ok": True, "secrets": store.list()[:SECRET_MAX_NAMES]}
    if op == "set":
        return {"ok": True, "version": store.set(req["name"], req["value"],
                                                 record_meta_from_request(req))}
    if op == "generate":
        value = generate_password(req.get("length", SECRET_GENERATE_DEFAULT_LENGTH),
                                  req.get("symbols", True))
        return {"ok": True, "version": store.set(req["name"], value,
                                                 record_meta_from_request(req))}
    if op == "remove":
        return {"ok": True, "version": store.remove(req["name"])}
    raise SecretError("unsupported here")


"""agent-box-secrets-mcp - the box-local MCP adapter (#922, PR 3 slice).

An unprivileged stdio server. It never sees a value except as it flows back
from a job's own (already redacted) stdout/stderr - it talks to the root
broker over its per-user Unix socket exactly like the CLI does, using the
same request schema (lib/secret-protocol.py). The four tools from the issue
(list_secret_names / exec_with_secrets / exec_with_secrets_status /
exec_with_secrets_cancel), plus the website-login tools: generate_secret,
browser_fill, browser_save_cookies and browser_load_cookies. There is
deliberately no tool that can read, export or SET a value - a value typed
into a tool call would land in the transcript; `agent-box-secret set
--stdin` is how a person stores one they already have.

Scope: this process's AGENT_BOX_PROFILE (the supervisor already exports it
into every session - see env-exec.py), or the box's current default
profile when that is unset (resolve_profile, lib/secret-protocol.py) -
there is no separate global scope. No tool argument can select a
different profile; that is routing, not a security boundary, exactly like
every other per-profile value in this codebase (see env-exec.py's own
"Convenience, NOT isolation" note on profile env) - the broker only ever
checks SO_PEERCRED uid, so any process of this user could ask for another
profile's secrets by naming it explicitly. What scoping buys is that an
ordinary tool call never reaches across profiles by accident.

Spliced ABOVE this file by the generated module, after secret-protocol.py,
so SecretError/connect_and_call/SECRET_* already exist when this runs.
"""
import os
import sys
import time

from mcp.server.fastmcp import FastMCP

SOCKET_PATH = os.environ.get("AGENT_BOX_SECRET_SOCKET")
POLL_INTERVAL_S = 0.1
INLINE_WAIT_BUDGET_S = 3.0
BROWSER_WAIT_BUDGET_S = 20.0

mcp = FastMCP("agent-box-secrets")


def _call(req, profile=None):
    # Resolved per call, not once at import: a box with no default profile
    # and no AGENT_BOX_PROFILE must not fail to even START this server over
    # it - each tool call reports the refusal instead. A job's own follow-up
    # calls pass the profile it was started under, so a default that changes
    # meanwhile cannot make status/cancel look in another namespace.
    try:
        profile = resolve_profile(profile or os.environ.get("AGENT_BOX_PROFILE") or None)
    except SecretError as exc:
        return {"ok": False, "error": str(exc)}
    return connect_and_call(SOCKET_PATH, dict(req, profile=profile))


@mcp.tool()
def list_secret_names() -> dict:
    """List this profile's configured secret names, versions, kinds
    (value/totp/cookies), origins and whether each is fill-only. Never a
    value - use exec_with_secrets to run a command with one injected, or
    browser_fill to type one into a login form."""
    return _call({"op": "list"})


@mcp.tool()
def exec_with_secrets(
    secretNames: list[str],
    argv: list[str] | None = None,
    command: str | None = None,
    shell: str | None = None,
    cwd: str | None = None,
    env: dict[str, str] | None = None,
    timeoutMs: int | None = None,
    idempotencyKey: str | None = None,
) -> dict:
    """Run a command with ONLY the named secrets injected into its
    environment. Give either argv (a literal argument list, preferred) or
    command+shell ("bash" or "sh"). secretNames must come from
    list_secret_names. The command's own environment never contains a
    secret this call did not name. Output is captured with every selected
    value's exact text redacted. Returns before the job may have finished
    for a long-running command; poll with exec_with_secrets_status using
    the returned jobId. idempotencyKey makes a retried call with the exact
    same request return the original job instead of starting a second one."""
    req = {"op": "exec", "secretNames": secretNames}
    if argv is not None:
        req["argv"] = argv
    if command is not None:
        req["command"] = command
    if shell is not None:
        req["shell"] = shell
    if cwd is not None:
        req["cwd"] = cwd
    if env is not None:
        req["env"] = env
    if timeoutMs is not None:
        req["timeoutMs"] = timeoutMs
    if idempotencyKey is not None:
        req["idempotencyKey"] = idempotencyKey
    try:
        profile = resolve_profile(os.environ.get("AGENT_BOX_PROFILE") or None)
    except SecretError as exc:
        return {"ok": False, "error": str(exc)}
    resp = _call(req, profile)
    if not resp.get("ok"):
        return resp
    job_id = resp["jobId"]
    deadline = time.time() + INLINE_WAIT_BUDGET_S
    status = _call({"op": "status", "jobId": job_id}, profile)
    # Not lib/secret-jobs.py's ACTIVE_STATES: this file only splices with
    # secret-protocol.py (see the header), to keep the unprivileged adapter's
    # dependency closure small - a second literal here is cheaper than
    # pulling in the whole job-manager module for one tuple.
    while status.get("ok") and status.get("state") in ("pending", "running") and time.time() < deadline:
        time.sleep(POLL_INTERVAL_S)
        status = _call({"op": "status", "jobId": job_id}, profile)
    status["jobId"] = job_id
    status["profile"] = profile
    return status


def _run_browser_job(req):
    try:
        profile = resolve_profile(os.environ.get("AGENT_BOX_PROFILE") or None)
    except SecretError as exc:
        return {"ok": False, "error": str(exc)}
    resp = _call(req, profile)
    if not resp.get("ok"):
        return resp
    job_id = resp["jobId"]
    deadline = time.time() + BROWSER_WAIT_BUDGET_S
    status = _call({"op": "status", "jobId": job_id}, profile)
    while status.get("ok") and status.get("state") in ("pending", "running") and time.time() < deadline:
        time.sleep(POLL_INTERVAL_S)
        status = _call({"op": "status", "jobId": job_id}, profile)
    status["jobId"] = job_id
    status["profile"] = profile
    return status


def _origins(origins):
    return [normalize_origin(o) for o in origins or []]


@mcp.tool()
def generate_secret(
    name: str,
    origins: list[str] | None = None,
    length: int = SECRET_GENERATE_DEFAULT_LENGTH,
    symbols: bool = True,
    allowExec: bool = False,
) -> dict:
    """Create a new random password and store it as `name`, without anyone
    (you included) ever seeing it. Use it when you sign up for a website:
    give the site's URL in origins, then type it into the sign-up form with
    browser_fill. With origins the secret is fill-only (exec refuses it)
    unless allowExec is true. Set symbols=false for a site that refuses
    punctuation. Replaces an existing secret of the same name."""
    try:
        normalized = _origins(origins)
    except SecretError as exc:
        return {"ok": False, "error": str(exc)}
    req = {"op": "generate", "name": name, "length": length, "symbols": symbols}
    if normalized:
        req["origins"] = normalized
        req["fillOnly"] = not allowExec
    return _call(req)


@mcp.tool()
def browser_fill(name: str, cdpPort: int, selector: str, targetId: str | None = None) -> dict:
    """Type secret `name` into the input that CSS `selector` matches, in
    your Chromium on 127.0.0.1:cdpPort (start it with
    --remote-debugging-port). The broker first checks that the page's
    origin, as the browser reports it, is one of the secret's origins, and
    refuses otherwise - so never retry a refusal on another page: it means
    you are not on the site you think. A TOTP secret types its current
    code. targetId (from http://127.0.0.1:PORT/json/list) is needed only
    when several pages are open. Submit the form yourself afterwards."""
    req = {"op": "fill", "name": name, "cdpPort": cdpPort, "selector": selector}
    if targetId:
        req["targetId"] = targetId
    return _run_browser_job(req)


@mcp.tool()
def browser_save_cookies(name: str, cdpPort: int, origins: list[str],
                         targetId: str | None = None, allowExec: bool = False) -> dict:
    """After you log in, store the browser's cookies for `origins` as
    secret `name`, so a later session can skip the login with
    browser_load_cookies. The cookies go straight to the broker; they are
    not returned to you. Fill-only unless allowExec is true (then exec can
    inject them as a Playwright storageState JSON)."""
    try:
        normalized = _origins(origins)
    except SecretError as exc:
        return {"ok": False, "error": str(exc)}
    req = {"op": "save-cookies", "name": name, "cdpPort": cdpPort,
           "origins": normalized, "fillOnly": not allowExec}
    if targetId:
        req["targetId"] = targetId
    return _run_browser_job(req)


@mcp.tool()
def browser_load_cookies(name: str, cdpPort: int, targetId: str | None = None) -> dict:
    """Put the cookies stored as `name` back into your Chromium on
    127.0.0.1:cdpPort, limited to the secret's own origins. Reload or
    navigate the page afterwards to use the session."""
    req = {"op": "load-cookies", "name": name, "cdpPort": cdpPort}
    if targetId:
        req["targetId"] = targetId
    return _run_browser_job(req)


@mcp.tool()
def exec_with_secrets_status(jobId: str, profile: str | None = None) -> dict:
    """Poll a job started by exec_with_secrets. Pass the profile that call
    returned, if any, so the lookup uses the profile the job started under."""
    return _call({"op": "status", "jobId": jobId}, profile)


@mcp.tool()
def exec_with_secrets_cancel(jobId: str, profile: str | None = None) -> dict:
    """Stop a running job started by exec_with_secrets. A job that already
    finished is returned unchanged; cancellation cannot undo an effect the
    command already caused outside this box (e.g. a detached deployment)."""
    return _call({"op": "cancel", "jobId": jobId}, profile)


def main():
    if not SOCKET_PATH:
        sys.stderr.write(
            "agent-box-secrets-mcp: AGENT_BOX_SECRET_SOCKET is not set; "
            "every tool call will report secrets as disabled\n")
    mcp.run()


if __name__ == "__main__":
    main()
