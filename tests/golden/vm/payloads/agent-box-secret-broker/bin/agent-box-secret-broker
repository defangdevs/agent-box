#! /nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-python3-3.14.7-env/bin/python3.14
# Secret custody: the wire protocol, at-rest encryption, and the record
# store (issue #922).
#
# One owner for the things the root broker, the worker, and the unprivileged
# CLI and MCP adapter must agree on: how a request is framed, which names
# are legal, how a value is protected on disk, and how a client calls the
# broker's socket. The broker and worker use the Store below; the CLI and
# MCP adapter never touch it, because the whole point is that the agent
# user cannot read the records - they only ever call connect_and_call.
#
# Spliced ABOVE secret-broker.py, secret-cli.py, and secrets-mcp.py (with
# secret-jobs.py spliced between protocol and broker) by the generated
# module, so the names bind in all three; this file therefore has no
# `if __name__` block.
# secret-worker.py is NOT spliced with this file - it runs as the ordinary
# agent user and has no need of `cryptography` or the Store, so keeping it
# standalone keeps its dependency closure as small as a bare python3.
import base64
import binascii
import contextlib
import fcntl
import hashlib
import hmac
import json
import os
import re
import secrets as _secrets_rng
import socket
import stat
import string
import struct
import threading
import time
import urllib.parse

from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
from cryptography.hazmat.primitives.kdf.hkdf import HKDF

SECRET_NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,63}$")
# Same charset agent-box-profile's valid_name already enforces (profile-
# cli.sh), so a namespace is always a name that CLI could also have created.
PROFILE_NAME_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
SECRET_MAX_FRAME = 64 * 1024
SECRET_MAX_VALUE = 32 * 1024
SECRET_MAX_NAMES = 256
SECRET_MAX_ENV = 64
SECRET_MAX_ARGV = 64
SECRET_MAX_ARG_LEN = 4096
SECRET_MAX_CWD_LEN = 4096
SECRET_MAX_IDEMPOTENCY_LEN = 128
SECRET_DEFAULT_TIMEOUT_MS = 10 * 60 * 1000
SECRET_MAX_TIMEOUT_MS = 60 * 60 * 1000
SECRET_MAX_JOBS_PER_USER = 2
SECRET_MAX_OUTPUT_BYTES = 64 * 1024
SECRET_JOB_RETENTION_SECONDS = 24 * 60 * 60
# Finished jobs keep their (capped) output for the retention window above, and
# a finished job no longer counts against SECRET_MAX_JOBS_PER_USER. Without a
# second bound a caller could run jobs back to back and grow the broker's
# memory for a whole day: 256 retained jobs is at most 256 x 2 x 64 KiB = 32
# MiB per user. A new exec is refused at the bound, not an old result evicted,
# so a result stays readable for its whole retention window.
SECRET_MAX_RETAINED_JOBS_PER_USER = 256
# A profile name is cheap to mint and each new one is a persistent directory
# plus meta.json under the user's store. The broker's open-store cache bounds
# descriptors, not disk, so the number of namespaces is capped here; existing
# namespaces stay reachable past the cap, only a NEW one is refused.
SECRET_MAX_NAMESPACES_PER_USER = 128

# Where agent-box-profile's own default pointer lives (profile-cli.sh's
# DIR/DEFAULT_FILE). Secrets have no separate "global" bucket (deprecated in
# favor of the box's actual default profile, 2026-11-13): a request naming no
# --profile resolves to whichever profile `agent-box-profile default` names,
# exactly like a session agent-box-session add starts with neither --profile
# nor --harness already does. A box with no default profile has no secret
# request without --profile to fall back to at all.
PROFILES_DIR_PARTS = (".config", "agent-box", "profiles")
DEFAULT_PROFILE_FILE = ".default"

SECRET_OPS = ("list", "set", "remove", "exec", "status", "cancel",
              "generate", "fill", "save-cookies", "load-cookies")
# What a record's value IS, which decides what the broker hands out for it:
#   value   - the plain value (the default; every record written before
#             kinds existed reads as this one)
#   totp    - a TOTP seed (base32, or an otpauth:// URI). exec and fill get
#             the CURRENT one-time code; the seed itself never leaves the
#             broker, not even into a job.
#   cookies - a browser session: {"cookies": [...], "origins": []}, the
#             shape Playwright's storageState uses, so an exec job can hand
#             it straight to `browser.new_context(storage_state=...)`.
SECRET_KINDS = ("value", "totp", "cookies")
SECRET_MAX_ORIGINS = 8
SECRET_MAX_ORIGIN_LEN = 256
SECRET_MAX_SELECTOR_LEN = 1024
SECRET_MAX_COOKIES = 300
# The most bytes one profile's `list` reply may take, leaving headroom under
# SECRET_MAX_FRAME for the envelope. Store.set refuses a write that would
# push the listing past it - origins are what grow it (8 x 256 bytes per
# record), and a profile that could no longer be listed would hide every
# name in it from the CLI, MCP and env-exec's stripping alike.
SECRET_MAX_LIST_BYTES = SECRET_MAX_FRAME - 1024
SECRET_GENERATE_DEFAULT_LENGTH = 24
SECRET_GENERATE_MIN_LENGTH = 12
SECRET_GENERATE_MAX_LENGTH = 128
# Symbols every site we have met accepts in a password: no quote, backslash,
# slash, backtick, pipe or space, which are the ones forms and shells mangle.
SECRET_GENERATE_SYMBOLS = "!#$%&()*+,-.:;<=>?@[]^_{}~"
CDP_TARGET_ID_RE = re.compile(r"^[A-Za-z0-9]{1,64}$")
ENV_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*\Z")
IDEMPOTENCY_RE = re.compile(r"^[A-Za-z0-9_.:-]{1,%d}$" % SECRET_MAX_IDEMPOTENCY_LEN)


class SecretError(Exception):
    """A refusal the caller may be told about; never carries a value."""


def valid_secret_name(name):
    return isinstance(name, str) and SECRET_NAME_RE.match(name) is not None


def valid_secret_value(value):
    if not isinstance(value, str) or value == "" or "\0" in value:
        return False
    return len(value.encode("utf-8")) <= SECRET_MAX_VALUE


def valid_profile(name):
    return isinstance(name, str) and PROFILE_NAME_RE.match(name) is not None


def resolve_profile(explicit, home=None):
    """Turn "no --profile given" into a concrete name, the way
    `agent-box-session add` already resolves no --profile/--harness into
    the box's default profile: there is no OTHER fallback. Secrets have no
    separate global scope - the issue's original plan deferred per-profile
    scope and kept one bucket per Linux user; in review, lionello deprecated
    that bucket outright in favor of resolving straight to whichever profile
    `agent-box-profile default` currently names (2026-11-13), with layered
    profile overlays left for later (cf. Nix overlays).

    Used by the CLI, the MCP adapter, and env-exec.py - all of which run as
    the ordinary agent user and can read agent-box-profile's own pointer
    file themselves, exactly as profile-cli.sh's default_name() does. The
    broker never parses this file: every request it receives already names
    a concrete profile, resolved by the caller before it was sent."""
    if explicit is not None:
        if not valid_profile(explicit):
            raise SecretError("invalid profile")
        return explicit
    home = home or os.path.expanduser("~")
    no_default = SecretError(
        "no --profile given and no default profile is set "
        "(see `agent-box-profile default`)")
    pointer = os.path.join(home, *PROFILES_DIR_PARTS, DEFAULT_PROFILE_FILE)
    try:
        with open(pointer, "r") as handle:
            name = handle.readline().rstrip("\n")
    except OSError:
        raise no_default
    if not valid_profile(name):
        raise no_default
    if not os.path.isfile(os.path.join(home, *PROFILES_DIR_PARTS, f"{name}.env")):
        raise no_default
    return name


def recv_exact(conn, count):
    chunks = []
    while count:
        chunk = conn.recv(count)
        if not chunk:
            raise SecretError("connection closed mid-frame")
        chunks.append(chunk)
        count -= len(chunk)
    return b"".join(chunks)


def send_frame(conn, obj):
    body = json.dumps(obj, separators=(",", ":")).encode("utf-8")
    if len(body) > SECRET_MAX_FRAME:
        raise SecretError("response too large")
    conn.sendall(struct.pack(">I", len(body)) + body)


def connect_and_call(sock_path, req, timeout=15):
    """One round trip to the broker: connect, send the request, read the
    reply, close. The one client the CLI and the MCP adapter both need, so
    a fix to one (a longer timeout for a slow systemd-run start, a retry) is
    a fix to both rather than a fix that only one of them got. Never raises:
    a transport failure comes back shaped exactly like a protocol refusal
    ({"ok": False, "error": ...}), which is what every caller already
    checks for."""
    if not sock_path:
        return {"ok": False, "error": "secrets are not enabled on this box"}
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    conn.settimeout(timeout)
    try:
        conn.connect(sock_path)
        send_frame(conn, req)
        return recv_frame(conn)
    except (OSError, SecretError) as exc:
        return {"ok": False, "error": f"broker unavailable: {exc}"}
    finally:
        conn.close()


def recv_frame(conn):
    (length,) = struct.unpack(">I", recv_exact(conn, 4))
    # The length is checked BEFORE any allocation: a peer must not be able to
    # make the root process reserve memory by lying in four bytes.
    if length == 0 or length > SECRET_MAX_FRAME:
        raise SecretError("bad frame length")
    try:
        obj = json.loads(recv_exact(conn, length).decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise SecretError("malformed request")
    if not isinstance(obj, dict):
        raise SecretError("malformed request")
    return obj


def _valid_argv_item(item):
    return (isinstance(item, str) and item != "" and "\0" not in item
            and len(item.encode("utf-8")) <= SECRET_MAX_ARG_LEN)


def _valid_env_map(env):
    if not isinstance(env, dict) or len(env) > SECRET_MAX_ENV:
        return False
    for key, value in env.items():
        if not ENV_KEY_RE.match(key):
            return False
        if not isinstance(value, str) or "\0" in value:
            return False
        if len(value.encode("utf-8")) > SECRET_MAX_VALUE:
            return False
    return True


def _valid_name_list(names):
    if not isinstance(names, list) or len(names) > SECRET_MAX_NAMES:
        return False
    return all(valid_secret_name(name) for name in names)


def validate_request(req):
    """Strict schema: unknown fields are refused, not ignored, so a caller
    cannot smuggle a uid, a path, or a unit property past a future reader."""
    op = req.get("op")
    if op not in SECRET_OPS:
        raise SecretError("unknown operation")
    allowed = {
        "list": {"op", "profile"},
        "set": {"op", "profile", "name", "value", "kind", "origins", "fillOnly"},
        "remove": {"op", "profile", "name"},
        "exec": {"op", "profile", "argv", "command", "shell", "secretNames",
                 "cwd", "env", "timeoutMs", "idempotencyKey"},
        "status": {"op", "profile", "jobId"},
        "cancel": {"op", "profile", "jobId"},
        "generate": {"op", "profile", "name", "length", "symbols", "origins", "fillOnly"},
        "fill": {"op", "profile", "name", "cdpPort", "targetId", "selector", "timeoutMs"},
        "save-cookies": {"op", "profile", "name", "cdpPort", "targetId", "origins",
                         "fillOnly", "timeoutMs"},
        "load-cookies": {"op", "profile", "name", "cdpPort", "targetId", "timeoutMs"},
    }[op]
    if set(req) - allowed:
        raise SecretError("unexpected field")
    # Always required: there is no "no profile" scope on the wire. A caller
    # with no --profile resolves one client-side (resolve_profile, above)
    # before building the request at all.
    if not valid_profile(req.get("profile")):
        raise SecretError("invalid profile")
    if op in ("set", "remove", "generate", "fill", "save-cookies", "load-cookies") \
            and not valid_secret_name(req.get("name")):
        raise SecretError("invalid name")
    if op == "set" and not valid_secret_value(req.get("value")):
        raise SecretError("invalid value")
    if op in ("set", "generate", "save-cookies"):
        _validate_meta_fields(op, req)
    if op == "set":
        kind = req.get("kind", "value")
        if kind == "totp":
            parse_totp(req["value"])
        elif kind == "cookies":
            parse_cookie_state(req["value"])
    if op == "generate":
        length = req.get("length", SECRET_GENERATE_DEFAULT_LENGTH)
        if (not isinstance(length, int) or isinstance(length, bool)
                or not SECRET_GENERATE_MIN_LENGTH <= length <= SECRET_GENERATE_MAX_LENGTH):
            raise SecretError("invalid length (%d-%d)" % (
                SECRET_GENERATE_MIN_LENGTH, SECRET_GENERATE_MAX_LENGTH))
        if not isinstance(req.get("symbols", True), bool):
            raise SecretError("invalid symbols")
    if op in ("fill", "save-cookies", "load-cookies"):
        _validate_browser_fields(op, req)
    if op in ("status", "cancel"):
        job_id = req.get("jobId")
        if not isinstance(job_id, str) or not re.match(r"^[A-Za-z0-9_-]{1,64}$", job_id):
            raise SecretError("invalid job id")
    if op == "exec":
        _validate_exec_request(req)
    return op


def normalize_origin(text):
    """Reduce a URL to the web origin a browser reports for it - scheme,
    lower-case host, and a port only when it is not the scheme's default -
    which is exactly the string Chromium puts in a frame's securityOrigin,
    so a fill compares two strings and nothing else. https always; http
    only for a loopback host, where a local test server lives. A host that
    is not plain ASCII is refused rather than guessed at: give its punycode
    (xn--) form, which is what the browser reports."""
    if not isinstance(text, str) or not text or len(text) > SECRET_MAX_ORIGIN_LEN:
        raise SecretError("invalid origin")
    try:
        parts = urllib.parse.urlsplit(text.strip())
        port = parts.port
    except ValueError:
        raise SecretError(f"invalid origin: {text}")
    scheme = parts.scheme.lower()
    host = (parts.hostname or "").lower()
    if not host or not host.isascii() or parts.username or parts.password:
        raise SecretError(f"invalid origin: {text}")
    if not re.match(r"^[a-z0-9.:\[\]-]+$", host):
        raise SecretError(f"invalid origin: {text}")
    loopback = host in ("localhost", "127.0.0.1", "::1")
    if scheme != "https" and not (scheme == "http" and loopback):
        raise SecretError(f"origin must be https (http only for localhost): {text}")
    default_port = 443 if scheme == "https" else 80
    shown_host = f"[{host}]" if ":" in host else host
    if port is not None and port != default_port:
        return f"{scheme}://{shown_host}:{port}"
    return f"{scheme}://{shown_host}"


def _validate_meta_fields(op, req):
    kind = req.get("kind", "value")
    if kind not in SECRET_KINDS:
        raise SecretError("invalid kind")
    origins = req.get("origins", [])
    if (not isinstance(origins, list) or len(origins) > SECRET_MAX_ORIGINS
            or any(normalize_origin(o) != o for o in origins)):
        # The client normalizes; the broker only accepts what normalizing
        # would not change, so what list shows is exactly what fill matches.
        raise SecretError("invalid origins (give normalized origins, at most %d)"
                          % SECRET_MAX_ORIGINS)
    fill_only = req.get("fillOnly", False)
    if not isinstance(fill_only, bool):
        raise SecretError("invalid fillOnly")
    if fill_only and not origins:
        raise SecretError("fillOnly needs at least one origin")
    if op == "save-cookies" and not origins:
        raise SecretError("save-cookies needs at least one origin")


def _validate_browser_fields(op, req):
    port = req.get("cdpPort")
    if not isinstance(port, int) or isinstance(port, bool) or not 1 <= port <= 65535:
        raise SecretError("invalid cdpPort")
    if "targetId" in req and not (isinstance(req["targetId"], str)
                                  and CDP_TARGET_ID_RE.match(req["targetId"])):
        raise SecretError("invalid targetId")
    if op == "fill":
        selector = req.get("selector")
        if (not isinstance(selector, str) or not selector or "\0" in selector
                or len(selector.encode("utf-8")) > SECRET_MAX_SELECTOR_LEN):
            raise SecretError("invalid selector")
    if "timeoutMs" in req:
        timeout = req["timeoutMs"]
        if not isinstance(timeout, int) or isinstance(timeout, bool) or not (0 < timeout <= SECRET_MAX_TIMEOUT_MS):
            raise SecretError("invalid timeoutMs")


def record_meta_from_request(req, kind=None):
    """The non-secret metadata a set/generate/save-cookies request asks the
    record to carry. Only non-default fields are kept, so a plain `set`
    writes a record byte-for-byte shaped like the ones before kinds."""
    meta = {}
    kind = kind or req.get("kind", "value")
    if kind != "value":
        meta["kind"] = kind
    if req.get("origins"):
        meta["origins"] = list(req["origins"])
    if req.get("fillOnly"):
        meta["fillOnly"] = True
    return meta


# --- TOTP (RFC 6238) ----------------------------------------------------------


def parse_totp(value):
    """(key, digits, period, algorithm) from a base32 seed or an
    otpauth://totp/ URI - the two shapes a site's "set up your
    authenticator" page offers. Refuses anything else, so a typo is caught
    when the seed is stored rather than at the first login."""
    text = value.strip()
    digits, period, algorithm = 6, 30, "SHA1"
    if text.lower().startswith("otpauth://"):
        parts = urllib.parse.urlsplit(text)
        if parts.netloc.lower() != "totp":
            raise SecretError("only otpauth://totp/ URIs are supported")
        query = urllib.parse.parse_qs(parts.query)
        seed = (query.get("secret") or [""])[0]
        try:
            digits = int((query.get("digits") or ["6"])[0])
            period = int((query.get("period") or ["30"])[0])
        except ValueError:
            raise SecretError("invalid TOTP parameters")
        algorithm = (query.get("algorithm") or ["SHA1"])[0].upper()
    else:
        seed = text
    seed = re.sub(r"[\s-]", "", seed).upper()
    if not seed or not re.match(r"^[A-Z2-7]+=*$", seed):
        raise SecretError("invalid TOTP seed (expected base32)")
    try:
        key = base64.b32decode(seed.rstrip("=") + "=" * (-len(seed.rstrip("=")) % 8))
    except (binascii.Error, ValueError):
        raise SecretError("invalid TOTP seed (expected base32)")
    if not key or digits not in (6, 7, 8) or not 15 <= period <= 120 \
            or algorithm not in ("SHA1", "SHA256", "SHA512"):
        raise SecretError("invalid TOTP parameters")
    return key, digits, period, algorithm


def totp_code(value, now=None):
    key, digits, period, algorithm = parse_totp(value)
    counter = int((time.time() if now is None else now) // period)
    mac = hmac.new(key, struct.pack(">Q", counter),
                   getattr(hashlib, algorithm.lower())).digest()
    offset = mac[-1] & 0x0F
    code = (struct.unpack(">I", mac[offset:offset + 4])[0] & 0x7FFFFFFF) % (10 ** digits)
    return str(code).zfill(digits)


# --- Generated passwords and stored browser sessions -----------------------------


def generate_password(length=SECRET_GENERATE_DEFAULT_LENGTH, symbols=True):
    """A random password with at least one character of every class it
    draws from, because most sign-up forms refuse one without."""
    classes = [string.ascii_lowercase, string.ascii_uppercase, string.digits]
    if symbols:
        classes.append(SECRET_GENERATE_SYMBOLS)
    alphabet = "".join(classes)
    while True:
        candidate = "".join(_secrets_rng.choice(alphabet) for _ in range(length))
        if all(any(ch in cls for ch in candidate) for cls in classes):
            return candidate


COOKIE_FIELDS = ("name", "value", "domain", "path", "expires", "httpOnly", "secure", "sameSite")


def parse_cookie_state(value):
    """A stored browser session: Playwright's storageState shape, cookies
    only. Returns the cookie list; refuses anything else so a load never
    hands the browser something it did not come from."""
    try:
        state = json.loads(value)
    except ValueError:
        raise SecretError("cookies value is not JSON")
    cookies = state.get("cookies") if isinstance(state, dict) else None
    if not isinstance(cookies, list) or len(cookies) > SECRET_MAX_COOKIES:
        raise SecretError("cookies value needs a \"cookies\" list")
    for cookie in cookies:
        if (not isinstance(cookie, dict) or not isinstance(cookie.get("name"), str)
                or not isinstance(cookie.get("value"), str)
                or not isinstance(cookie.get("domain"), str)):
            raise SecretError("each cookie needs name, value and domain")
    return cookies


def _validate_exec_request(req):
    has_argv = "argv" in req
    has_command = "command" in req
    if has_argv == has_command:
        raise SecretError("exactly one of argv or command is required")
    if has_argv:
        argv = req["argv"]
        if (not isinstance(argv, list) or not argv or len(argv) > SECRET_MAX_ARGV
                or not all(_valid_argv_item(item) for item in argv)):
            raise SecretError("invalid argv")
        if "shell" in req:
            raise SecretError("shell is only valid with command")
    else:
        if not _valid_argv_item(req.get("command")):
            raise SecretError("invalid command")
        if req.get("shell") not in ("bash", "sh"):
            raise SecretError("shell must be bash or sh")
    names = req.get("secretNames", [])
    if not _valid_name_list(names):
        raise SecretError("invalid secretNames")
    if "cwd" in req:
        cwd = req["cwd"]
        if (not isinstance(cwd, str) or not cwd.startswith("/") or "\0" in cwd
                or len(cwd.encode("utf-8")) > SECRET_MAX_CWD_LEN):
            raise SecretError("invalid cwd")
    if "env" in req and not _valid_env_map(req["env"]):
        raise SecretError("invalid env")
    if set(req.get("env", {})) & set(names):
        raise SecretError("env may not name a requested secret")
    if "timeoutMs" in req:
        timeout = req["timeoutMs"]
        if not isinstance(timeout, int) or isinstance(timeout, bool) or not (0 < timeout <= SECRET_MAX_TIMEOUT_MS):
            raise SecretError("invalid timeoutMs")
    if "idempotencyKey" in req:
        key = req["idempotencyKey"]
        if not isinstance(key, str) or not IDEMPOTENCY_RE.match(key):
            raise SecretError("invalid idempotencyKey")


# --- At-rest encryption -----------------------------------------------------
#
# Phase 1 (this file): one root key, generated once, held in a root-only
# file beside the per-user namespaces. It never leaves this box. A record's
# value is AES-256-GCM under a key HKDF-derived per (user, namespace) from
# that root key, with (user, namespace, name, version) as AAD so a ciphertext
# copied into another slot fails to decrypt rather than silently decrypting
# as something else.
#
# Phase 2 (tracked in issue #922's follow-up) replaces load_root_key with a
# call to an external KMS/keyvault and nothing else here changes: every
# caller already goes through this one function to get the bytes it derives
# namespace keys from.
ROOT_KEY_BYTES = 32


def _fsync_dir(directory):
    dir_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(dir_fd)
    finally:
        os.close(dir_fd)


def load_root_key(path):
    """The box-wide root key, creating it on first use. Callers hold this in
    memory only; it is never written anywhere but this one 0600 file."""
    try:
        with open(path, "rb") as handle:
            key = handle.read()
    except FileNotFoundError:
        key = None
    if key is not None:
        if len(key) != ROOT_KEY_BYTES:
            raise SecretError("root key corrupt")
        # A concurrent creator may have linked this key and not yet synced
        # the directory; sync it here so records are never written under a
        # key whose directory entry could still be lost.
        _fsync_dir(os.path.dirname(path) or ".")
        return key
    # Create it atomically. A loser of the race below simply re-reads the
    # winner's file instead of overwriting it.
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, mode=0o700, exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        new_key = os.urandom(ROOT_KEY_BYTES)
        with os.fdopen(fd, "wb") as handle:
            handle.write(new_key)
            handle.flush()
            os.fsync(handle.fileno())
        try:
            os.link(tmp, path)
        except FileExistsError:
            pass
    finally:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
    # The file fsync above does not make the new directory entry durable:
    # without this, a power loss could drop .rootkey while records already
    # encrypted under it survive, and the next start would mint a different
    # key that cannot decrypt them.
    _fsync_dir(directory)
    return load_root_key(path)


def _namespace_key(root_key, user, namespace):
    hkdf = HKDF(algorithm=hashes.SHA256(), length=32, salt=None,
                info=f"agent-box-secret-v1:{user}:{namespace}".encode("utf-8"))
    return hkdf.derive(root_key)


def _aad(user, namespace, name, version):
    return f"{user}:{namespace}:{name}:{version}".encode("utf-8")


def _encrypt(key, aad, plaintext):
    nonce = os.urandom(12)
    ct = AESGCM(key).encrypt(nonce, plaintext.encode("utf-8"), aad)
    return nonce, ct


def _decrypt(key, aad, nonce, ct):
    try:
        return AESGCM(key).decrypt(nonce, ct, aad).decode("utf-8")
    except Exception:
        raise SecretError("decryption failed")


def _next_version(old_record):
    """old_record is whatever _read() handed back for a slot that may never
    have been written, or may have been written by code this broker no
    longer recognizes. Either way, a version counter that cannot be trusted
    must not raise - it starts over at 1 rather than crash the request."""
    try:
        version = old_record.get("version", 0)
        if not isinstance(version, int) or isinstance(version, bool):
            return 1
        return version + 1
    except AttributeError:
        return 1


def _fsync_dir(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _makedirs_durable(path):
    """os.makedirs(path, 0o700), then fsync EVERY ancestor of path, on every
    call (fsync(2): syncing a directory does not persist its own entry in
    ITS parent). Unconditional because a retry cannot tell which levels an
    earlier attempt created before one of its syncs failed: it finds them
    all existing, and every entry on the way down must still be made
    durable before a write under them is acknowledged. The Store is cached
    per namespace, so this is a handful of fsyncs per profile, not per
    request."""
    path = os.path.abspath(path)
    os.makedirs(path, mode=0o700, exist_ok=True)
    ancestor = os.path.dirname(path)
    while True:
        _fsync_dir(ancestor)
        parent = os.path.dirname(ancestor)
        if parent == ancestor:
            break
        ancestor = parent


class Store:
    """Root-only records for ONE (user, profile) namespace.

    Layout: <root>/<namespace>/{meta.json,.lock,<NAME>.rec}, where <root> is
    this user's own directory and <namespace> is always a concrete profile
    name - callers resolve "no --profile given" before this is ever
    constructed (see resolve_profile). Every access goes through a
    directory fd with O_NOFOLLOW, so a planted symlink is an error and
    never a redirect; every
    write is temp-file + fsync + rename, so a crash leaves the old record or
    the new one. Values are encrypted before they ever reach _write (see
    set/get below); _read/_write themselves do not know about secrecy, only
    about atomic JSON records.
    """

    @staticmethod
    def exists(root, namespace):
        """True if this namespace already has a directory. Read-only ops
        ask this first so a `list` with an invented profile name does not
        create (and permanently spend a quota slot on) a namespace."""
        try:
            return stat.S_ISDIR(os.lstat(os.path.join(root, namespace)).st_mode)
        except (FileNotFoundError, NotADirectoryError):
            return False

    # The quota count and the mkdir below must not interleave between two
    # threads (the serving thread and a save-cookies drain thread both
    # construct Stores), or both can pass the count and overshoot it.
    _create_lock = threading.Lock()

    def __init__(self, root, namespace, user, uid, root_key):
        if not re.match(r"^[A-Za-z0-9_.-]{1,64}$", namespace) or namespace in (".", ".."):
            raise SecretError("invalid namespace")
        _makedirs_durable(root)
        root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            try:
                os.stat(namespace, dir_fd=root_fd, follow_symlinks=False)
            except FileNotFoundError:
                with Store._create_lock:
                    existing = [e for e in os.listdir(root_fd) if not e.startswith(".")]
                    if (namespace not in existing
                            and len(existing) >= SECRET_MAX_NAMESPACES_PER_USER):
                        raise SecretError("too many secret profiles for this user") from None
                    try:
                        os.mkdir(namespace, 0o700, dir_fd=root_fd)
                    except FileExistsError:
                        pass
            # Every time, not only after our own mkdir: fsync on the
            # namespace itself (in _write) does not persist its ENTRY in
            # the parent, and a retry after a failed sync finds the
            # directory already there. Without this a crash after an
            # acknowledged `set` could lose the whole profile.
            os.fsync(root_fd)
            self.dir_fd = os.open(namespace, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                  dir_fd=root_fd)
        finally:
            os.close(root_fd)
        self.user = user
        self.namespace = namespace
        try:
            self._key = _namespace_key(root_key, user, namespace)
            self._bind(user, uid)
        except BaseException:
            # The broker does not cache a Store that failed to build, so
            # every retry would otherwise leak one more descriptor.
            os.close(self.dir_fd)
            raise

    def close(self):
        os.close(self.dir_fd)

    def _read(self, name):
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=self.dir_fd)
        except FileNotFoundError:
            return None
        except OSError:
            raise SecretError("store entry unreadable")
        with os.fdopen(fd, "rb") as handle:
            try:
                obj = json.loads(handle.read(SECRET_MAX_FRAME * 2))
            except ValueError:
                raise SecretError("store entry corrupt")
        if not isinstance(obj, dict):
            raise SecretError("store entry corrupt")
        return obj

    def _write(self, name, obj):
        tmp = f".{name}.tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW,
                     0o600, dir_fd=self.dir_fd)
        with os.fdopen(fd, "wb") as handle:
            handle.write(json.dumps(obj).encode("utf-8"))
            handle.flush()
            os.fsync(handle.fileno())
        os.rename(tmp, name, src_dir_fd=self.dir_fd, dst_dir_fd=self.dir_fd)
        os.fsync(self.dir_fd)

    def _bind(self, user, uid):
        # A namespace is bound to the identity it was created for. A uid that
        # was recycled for a different account must not inherit the records.
        meta = self._read("meta.json")
        if meta is None:
            self._write("meta.json", {"user": user, "uid": uid})
        elif meta.get("user") != user or meta.get("uid") != uid:
            raise SecretError("namespace belongs to another identity")

    def _locked(self):
        fd = os.open(".lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600,
                     dir_fd=self.dir_fd)
        fcntl.flock(fd, fcntl.LOCK_EX)
        return fd

    def list(self, replace=None):
        """Names and metadata only; no value is ever decrypted here.
        replace=(name, record) lists as if that record were already
        written, which is how set() measures a write before making it."""
        out = []
        entries = set(os.listdir(self.dir_fd))
        if replace is not None:
            entries.add(replace[0] + ".rec")
        for entry in sorted(entries):
            if not entry.endswith(".rec") or not valid_secret_name(entry[:-4]):
                continue
            if replace is not None and entry == replace[0] + ".rec":
                rec = replace[1]
            else:
                rec = self._read(entry) or {}
            item = {"name": entry[:-4], "version": rec.get("version", 0),
                    "configured": not rec.get("tombstone", False)}
            if item["configured"]:
                item.update(_public_meta(rec))
            out.append(item)
        return out

    def _name_count(self):
        return sum(1 for entry in os.listdir(self.dir_fd)
                   if entry.endswith(".rec") and valid_secret_name(entry[:-4]))

    def set(self, name, value, meta=None):
        lock = self._locked()
        try:
            old = self._read(name + ".rec") or {}
            if not old and self._name_count() >= SECRET_MAX_NAMES:
                # list() reports at most SECRET_MAX_NAMES names, and env-exec
                # strips only names it is told about, so the store must
                # never hold more names than one response can carry.
                raise SecretError("too many secrets")
            version = _next_version(old)
            nonce, ct = _encrypt(self._key, _aad(self.user, self.namespace, name, version), value)
            record = {
                "version": version,
                "nonce": base64.b64encode(nonce).decode("ascii"),
                "ct": base64.b64encode(ct).decode("ascii"),
            }
            if meta:
                # Plaintext on purpose: list() shows it without decrypting.
                # It is root-only like the ciphertext, and it changes only
                # together with the value (set/generate/save-cookies), so a
                # caller cannot move a fill-only secret to a new origin
                # without also replacing what the old origin knew.
                record["meta"] = meta
            listed = self.list(replace=(name, record))
            if len(json.dumps(listed, separators=(",", ":")).encode("utf-8")) > SECRET_MAX_LIST_BYTES:
                # Refuse here rather than store a record that makes the
                # whole profile unlistable (see SECRET_MAX_LIST_BYTES).
                raise SecretError("too much origin metadata in this profile to list it: "
                                  "use fewer or shorter origins")
            self._write(name + ".rec", record)
            return version
        finally:
            os.close(lock)

    def snapshot(self, name):
        """(meta, value) of ONE record version, or None for a name that is
        missing or removed. A caller that authorizes on the metadata and
        then uses the value must take both from here: a meta() then a get()
        can straddle a concurrent set (a background save-cookies, say) and
        pair the old record's permissions with the new record's value."""
        rec = self._read(name + ".rec")
        if rec is None or rec.get("tombstone"):
            return None
        return _public_meta(rec), self._decrypt_record(name, rec)

    def get(self, name):
        """Decrypt one value. Only the exec path calls this - list/set/
        remove never see plaintext. Raises SecretError (never a bare
        KeyError/ValueError/binascii.Error) for anything short of a valid
        record, including one written by an incompatible earlier format -
        the caller must be able to treat "cannot resolve this name" as one
        kind of failure, not crash the whole process on it."""
        rec = self._read(name + ".rec")
        if rec is None or rec.get("tombstone"):
            return None
        return self._decrypt_record(name, rec)

    def _decrypt_record(self, name, rec):
        try:
            nonce = base64.b64decode(rec["nonce"], validate=True)
            ct = base64.b64decode(rec["ct"], validate=True)
            version = rec["version"]
            if not isinstance(version, int) or isinstance(version, bool):
                raise ValueError("bad version")
        except (KeyError, ValueError, TypeError, binascii.Error):
            raise SecretError("store entry corrupt")
        aad = _aad(self.user, self.namespace, name, version)
        return _decrypt(self._key, aad, nonce, ct)

    def meta(self, name):
        """The record's non-secret metadata, defaults filled in, or None for
        a name that is missing or removed. Never decrypts anything."""
        rec = self._read(name + ".rec")
        if rec is None or rec.get("tombstone"):
            return None
        return _public_meta(rec)

    def remove(self, name):
        """Delete the value but keep a tombstone, so a retired name stays
        protected rather than reappearing from a stale legacy copy."""
        lock = self._locked()
        try:
            old = self._read(name + ".rec")
            if old is None:
                raise SecretError("no such secret")
            version = _next_version(old)
            self._write(name + ".rec", {"version": version, "tombstone": True})
            return version
        finally:
            os.close(lock)


def _public_meta(rec):
    meta = rec.get("meta") if isinstance(rec.get("meta"), dict) else {}
    kind = meta.get("kind", "value")
    origins = meta.get("origins", [])
    return {
        "kind": kind if kind in SECRET_KINDS else "value",
        "origins": [o for o in origins if isinstance(o, str)] if isinstance(origins, list) else [],
        "fillOnly": meta.get("fillOnly") is True,
    }


def handle_request(store, req):
    """Handles the non-exec ops. exec/status/cancel are dispatched by the
    broker directly (they need the job manager, not just a Store)."""
    op = validate_request(req)
    if op == "list":
        return {"ok": True, "secrets": store.list()[:SECRET_MAX_NAMES]}
    if op == "set":
        return {"ok": True, "version": store.set(req["name"], req["value"],
                                                 record_meta_from_request(req))}
    if op == "generate":
        value = generate_password(req.get("length", SECRET_GENERATE_DEFAULT_LENGTH),
                                  req.get("symbols", True))
        return {"ok": True, "version": store.set(req["name"], value,
                                                 record_meta_from_request(req))}
    if op == "remove":
        return {"ok": True, "version": store.remove(req["name"])}
    raise SecretError("unsupported here")

# Secret custody: bounded command jobs (issue #922, PR 2 slice).
#
# exec_with_secrets runs the caller's command with ONLY the requested values
# injected, as a job the broker tracks by id so start/status/cancel survive
# an MCP adapter reconnect. The actual child always runs as the unprivileged
# agent user - the Launcher below is what decides HOW: production launches a
# systemd transient unit with User=<agent> (SystemdLauncher); tests and a
# root-less dev box use DirectLauncher, which spawns the same
# secret-worker.py directly. Business logic (idempotency, timeouts,
# redaction, output caps) lives here once and is identical either way - only
# "how is the child's uid actually dropped" differs, and that is exactly the
# one thing a unit test on this box cannot prove (see tests/secrets.nix).
#
# Spliced ABOVE secret-broker.py by the generated module, after
# secret-protocol.py; this file therefore has no `if __name__` block and
# reuses SecretError, SECRET_MAX_OUTPUT_BYTES, etc. from that file.
import contextlib
import hashlib
import json
import os
import secrets as _secrets_module
import signal
import subprocess
import threading
import time

JOB_STATES = ("pending", "running", "done", "error", "cancelled", "timeout")
ACTIVE_STATES = ("pending", "running")


def new_job_id():
    return _secrets_module.token_hex(12)


def redact(data, values):
    """Replace every exact occurrence of a secret value with a fixed-width
    marker. Order matters: redact longer values first so one value that is a
    substring of another cannot partially unmask it."""
    if not values:
        return data
    out = data
    for value in sorted(set(values), key=len, reverse=True):
        if value:
            out = out.replace(value.encode("utf-8"), b"***redacted***")
    return out


def fingerprint_request(req):
    """What makes two exec requests "the same" for idempotency: everything
    that affects what runs, nothing that affects bookkeeping (jobId,
    idempotencyKey itself)."""
    material = {
        "profile": req.get("profile"),
        "argv": req.get("argv"),
        "command": req.get("command"),
        "shell": req.get("shell"),
        "secretNames": sorted(req.get("secretNames", [])),
        "cwd": req.get("cwd"),
        "env": req.get("env", {}),
        "timeoutMs": req.get("timeoutMs"),
    }
    blob = json.dumps(material, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return hashlib.sha256(blob).hexdigest()


class Job:
    def __init__(self, job_id, namespace, fingerprint, request, created_at):
        self.id = job_id
        self.namespace = namespace
        self.fingerprint = fingerprint
        self.idempotency_key = request.get("idempotencyKey")
        self.timeout_ms = request.get("timeoutMs") or SECRET_DEFAULT_TIMEOUT_MS
        self.created_at = created_at
        self.started_at = None
        self.finished_at = None
        self.state = "pending"
        self.exit_code = None
        self.stdout = b""
        self.stderr = b""
        self.stdout_truncated = False
        self.stderr_truncated = False
        self.handle = None  # set by the Launcher; opaque to everything else
        # A browser job whose stdout is a value to STORE (save-cookies), not
        # output for the caller: called with the raw stdout once the worker
        # exits 0, returns the summary to report instead. While it is set,
        # status never shows stdout at all, not even a prefix mid-run.
        self.capture = None
        # A capture job's stdout pump writes HERE, never to stdout: status
        # only ever shows stdout, so the captured bytes cannot reach a
        # caller even if the pump outlives the drain thread's join and
        # publishes after the sink has run. capture_sealed then makes that
        # late publish a no-op, so the bytes are not retained either.
        self.capture_out = b""
        self.capture_out_truncated = False
        self.capture_sealed = False
        self.lock = threading.Lock()

    def public(self):
        with self.lock:
            hidden = self.capture is not None
            return {
                "jobId": self.id,
                "state": self.state,
                "exitCode": self.exit_code,
                "stdout": "" if hidden else self.stdout.decode("utf-8", "replace"),
                "stderr": self.stderr.decode("utf-8", "replace"),
                "stdoutTruncated": self.stdout_truncated,
                "stderrTruncated": self.stderr_truncated,
            }

def encode_worker_frame(argv_or_command, shell, secret_values, nonsecret_env, cwd,
                        browser=None):
    """The one place that builds secret-worker.py's stdin frame, so a field
    added to it cannot land in one Launcher and not the other - the two
    launchers differ in how the child's uid is dropped, nothing about the
    request it is handed. `browser` set means a built-in browser job (fill,
    save-cookies, load-cookies): the worker runs its own fixed CDP code
    instead of exec'ing a caller's command."""
    frame = json.dumps({
        "argv": argv_or_command if shell is None else None,
        "command": argv_or_command if shell is not None else None,
        "shell": shell,
        "secrets": secret_values,
        "env": nonsecret_env,
        "cwd": cwd,
        "browser": browser,
    }).encode("utf-8")
    return len(frame).to_bytes(4, "big") + frame


def spawn_worker(argv, frame_bytes):
    """subprocess.Popen plus the frame handoff, shared by both launchers.
    Raises on any failure to start or to hand off the frame - the caller
    (JobManager._dispatch) is what turns that into a job error rather than
    an unhandled exception."""
    proc = subprocess.Popen(
        argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        start_new_session=True,
    )
    try:
        proc.stdin.write(frame_bytes)
        proc.stdin.close()
    except OSError:
        proc.kill()
        proc.wait()
        raise
    return proc


class Launcher:
    """How a job's child actually starts. Subclasses own the uid drop."""

    def start(self, job, argv_or_command, shell, secret_values, nonsecret_env, cwd,
              browser=None):
        raise NotImplementedError

    def poll(self, job):
        raise NotImplementedError

    def kill(self, job):
        raise NotImplementedError


class DirectLauncher(Launcher):
    """Dev/test launcher: runs secret-worker.py directly, as whatever user
    this broker process itself runs as. This is what every unit test and a
    root-less dev-mode broker use - it proves the protocol, the redaction,
    the timeouts and the idempotency, and nothing about the uid boundary.
    Production (SystemdLauncher, in secret-broker.py) is the only launcher
    that proves that; see the module's VM test."""

    def __init__(self, worker_path, python_bin="python3"):
        self.worker_path = worker_path
        self.python_bin = python_bin

    def start(self, job, argv_or_command, shell, secret_values, nonsecret_env, cwd,
              browser=None):
        frame_bytes = encode_worker_frame(argv_or_command, shell, secret_values,
                                          nonsecret_env, cwd, browser)
        job.handle = spawn_worker([self.python_bin, self.worker_path], frame_bytes)
        return job.handle

    def poll(self, job):
        return job.handle.poll()

    def kill(self, job):
        if job.handle is None:
            # _dispatch only calls kill() through cancel()/the timeout path,
            # both of which happen after a successful start() set this - but
            # guard it anyway, since "no handle" must never raise past here.
            return
        try:
            os.killpg(job.handle.pid, signal.SIGKILL)
        except OSError:
            with contextlib.suppress(ProcessLookupError, OSError):
                job.handle.kill()


class JobManager:
    """One per (broker process, user). Tracks every job across every profile
    of that user - the "2 active jobs per user" limit in the issue is a
    per-user limit, not per-profile."""

    def __init__(self, launcher, max_output_bytes, max_jobs,
                 max_retained=SECRET_MAX_RETAINED_JOBS_PER_USER):
        self.launcher = launcher
        self.max_output_bytes = max_output_bytes
        self.max_jobs = max_jobs
        self.max_retained = max_retained
        self._jobs = {}
        self._by_idempotency = {}  # (namespace, key) -> job id
        self._lock = threading.Lock()

    def _active_count(self):
        return sum(1 for j in self._jobs.values() if j.state in ACTIVE_STATES)

    def start(self, namespace, req, resolve_secret, builtin=None):
        """builtin, for the browser ops, is {"secretNames": [...],
        "browser": {...}, "capture": callable-or-None}: the job runs the
        worker's own CDP code with those names resolved, instead of the
        caller's command."""
        fingerprint = fingerprint_request(req)
        key = req.get("idempotencyKey")
        with self._lock:
            if key is not None:
                existing_id = self._by_idempotency.get((namespace, key))
                if existing_id is not None:
                    existing = self._jobs[existing_id]
                    if existing.fingerprint != fingerprint:
                        raise SecretError("idempotency key conflict")
                    return existing.id
            if self._active_count() >= self.max_jobs:
                raise SecretError("too many active jobs")
            if len(self._jobs) >= self.max_retained:
                # See SECRET_MAX_RETAINED_JOBS_PER_USER: finished results are
                # kept for the retention window, so refuse instead of evicting.
                raise SecretError("too many retained job results; try again later")
            job = Job(new_job_id(), namespace, fingerprint, req, time.time())
            self._jobs[job.id] = job
            if key is not None:
                self._by_idempotency[(namespace, key)] = job.id
        try:
            self._dispatch(job, req, resolve_secret, builtin)
        except Exception:
            # Anything unexpected (an OSError reading a record, say) must
            # not leave the registered job "pending": two of those would
            # consume this user's whole execution capacity until restart.
            with job.lock:
                if job.state in ACTIVE_STATES:
                    job.state = "error"
                    job.stderr = b"internal error resolving secrets"
                    job.finished_at = time.time()
        return job.id

    def _dispatch(self, job, req, resolve_secret, builtin=None):
        names = builtin["secretNames"] if builtin else req.get("secretNames", [])
        secret_values = {}
        for name in names:
            try:
                value = resolve_secret(name)
            except SecretError as exc:
                value = None
                failure = str(exc)
            else:
                failure = f"no such secret: {name}"
            if value is None:
                job.state = "error"
                job.stderr = failure.encode("utf-8")
                job.finished_at = time.time()
                return
            secret_values[name] = value
        if builtin:
            argv_or_command, shell, browser = None, None, builtin["browser"]
            job.capture = builtin.get("capture")
        else:
            argv_or_command = req["argv"] if "argv" in req else req["command"]
            shell, browser = req.get("shell"), None
        job.started_at = time.time()
        job.state = "running"
        try:
            self.launcher.start(job, argv_or_command, shell, secret_values,
                                req.get("env", {}), req.get("cwd"), browser)
        except Exception as exc:
            # A job that failed to even START (systemd-run missing, a fork
            # failure, a frame too large for the pipe) must not stay
            # "running" forever: that leaks one of this user's 2 job slots
            # permanently, and a later cancel()/kill() on a job with no
            # handle would crash the broker (see Launcher.kill below).
            job.state = "error"
            job.stderr = f"failed to start: {exc}".encode("utf-8")
            job.finished_at = time.time()
            return
        redact_values = list(secret_values.values())
        threading.Thread(target=self._drain, args=(job, redact_values), daemon=True).start()

    def _drain(self, job, redact_values):
        proc = job.handle
        timeout = (job.timeout_ms / 1000.0) if job.timeout_ms else None
        deadline = (time.time() + timeout) if timeout else None
        # A secret can straddle two 4 KiB reads, so the redaction scan has
        # to see a value whole to catch it - which means not committing the
        # tail of what has been read so far until it either resolves into a
        # redacted match or there is nothing more that could still extend
        # it into one. The simplest way to get that right is to never hold
        # back a PARTIAL raw buffer at all: keep the whole raw buffer (it is
        # cheap, because it is capped) and redact it afresh each time, so a
        # match that only completes on a later read is still found whole
        # the next time this runs. Capping it is what keeps this bounded
        # instead of the unbounded "keep every byte ever produced" the
        # first cut of this function did: `yes` with a 1-hour timeout no
        # longer grows this process's memory without limit, nor does the
        # redaction scan run against more than this many bytes at a time.
        longest_value = max((len(v.encode("utf-8")) for v in redact_values), default=0)
        raw_cap = self.max_output_bytes + longest_value

        hold = max(longest_value - 1, 0)

        def pump(stream, attr):
            raw = bytearray()
            truncated = False
            discarded = False

            def publish(eof):
                nonlocal truncated
                clean = redact(bytes(raw), redact_values)
                if hold and (not eof or discarded):
                    # The last hold bytes may be the start of a secret whose
                    # end has not been read yet - or, once the raw cap has
                    # discarded bytes, whose end was cut off for good, so EOF
                    # does not resolve it. Publishing them would leak an
                    # unresolved prefix through status.
                    clean = clean[:max(len(clean) - hold, 0)]
                if len(clean) > self.max_output_bytes:
                    clean = clean[:self.max_output_bytes]
                    truncated = True
                with job.lock:
                    if attr == "capture_out" and job.capture_sealed:
                        return
                    setattr(job, attr, clean)
                    setattr(job, attr + "_truncated", truncated)

            try:
                while True:
                    # Keep reading even once the cap below is hit, so a child
                    # that fills its pipe buffer never blocks on a reader that
                    # has stopped reading; the extra bytes are simply discarded.
                    chunk = stream.read(4096)
                    if not chunk:
                        break
                    room = raw_cap - len(raw)
                    if room <= 0:
                        truncated = True
                        discarded = True
                        with job.lock:
                            if not (attr == "capture_out" and job.capture_sealed):
                                setattr(job, attr + "_truncated", True)
                        continue
                    if len(chunk) > room:
                        raw.extend(chunk[:room])
                        truncated = True
                        discarded = True
                    else:
                        raw.extend(chunk)
                    publish(False)
                publish(True)
            finally:
                # Job.handle outlives the child for the retention window;
                # without this each finished job keeps two descriptors open.
                with contextlib.suppress(OSError, ValueError):
                    stream.close()

        out_attr = "capture_out" if job.capture is not None else "stdout"
        out_thread = threading.Thread(target=pump, args=(proc.stdout, out_attr), daemon=True)
        err_thread = threading.Thread(target=pump, args=(proc.stderr, "stderr"), daemon=True)
        out_thread.start()
        err_thread.start()
        timed_out = False
        while True:
            rc = self.launcher.poll(job)
            if rc is not None:
                break
            if deadline is not None and time.time() >= deadline:
                timed_out = True
                self.launcher.kill(job)
                # Reap it: the retained job still owns the process handle.
                for _ in range(100):
                    if self.launcher.poll(job) is not None:
                        break
                    time.sleep(0.05)
                break
            time.sleep(0.05)
        out_thread.join(timeout=5)
        err_thread.join(timeout=5)
        with job.lock:
            job.finished_at = time.time()
            if timed_out:
                job.state = "timeout"
                job.exit_code = None
            elif job.state == "running":
                rc = self.launcher.poll(job)
                job.exit_code = rc
                job.state = "done" if rc == 0 else "error"
            if job.capture is not None:
                self._finish_capture(job, complete=not out_thread.is_alive())

    def _finish_capture(self, job, complete):
        """Runs under job.lock. Hands a capture job's private output to its
        sink and reports the sink's summary as stdout; on any failure the
        job is an error and the captured bytes are dropped, never shown.
        complete is False when the stdout pump had not reached EOF by the
        join's deadline (a descendant still holding the pipe): what it has
        published so far may be a prefix, so it is never stored."""
        captured, job.capture_out = job.capture_out, b""
        truncated = job.capture_out_truncated
        job.capture_sealed = True
        sink, job.capture = job.capture, None
        job.stdout = b""
        if job.state != "done":
            return
        if not complete:
            job.state = "error"
            job.stderr = b"captured value did not finish in time; nothing stored"
            return
        if truncated:
            job.state = "error"
            job.stderr = b"captured value too large to store"
            return
        try:
            job.stdout = sink(captured).encode("utf-8")
        except SecretError as exc:
            job.state = "error"
            job.stderr = str(exc).encode("utf-8")
        except Exception as exc:  # noqa: BLE001 - must not kill the drain thread
            job.state = "error"
            job.stderr = f"failed to store captured value: {type(exc).__name__}".encode("utf-8")

    def status(self, namespace, job_id):
        job = self._jobs.get(job_id)
        if job is None or job.namespace != namespace:
            raise SecretError("no such job")
        return job.public()

    def cancel(self, namespace, job_id):
        job = self._jobs.get(job_id)
        if job is None or job.namespace != namespace:
            raise SecretError("no such job")
        with job.lock:
            already_terminal = job.state not in ACTIVE_STATES
        if already_terminal:
            return job.public()
        self.launcher.kill(job)
        with job.lock:
            if job.state == "running":
                job.state = "cancelled"
                job.finished_at = time.time()
        return job.public()

    def sweep(self, retention_seconds):
        """Drop finished jobs older than the retention window, so memory and
        the idempotency map do not grow without bound (issue #922: "24-hour
        result retention")."""
        now = time.time()
        with self._lock:
            stale = [
                jid for jid, job in self._jobs.items()
                if job.state not in ACTIVE_STATES
                and job.finished_at is not None
                and now - job.finished_at > retention_seconds
            ]
            for jid in stale:
                job = self._jobs.pop(jid)
                if job.idempotency_key is not None:
                    self._by_idempotency.pop((job.namespace, job.idempotency_key), None)


"""agent-box-secret-broker - root custodian for ONE agent user's secrets
(#922).

Runs as root from a socket-activated unit, one instance per configured user.
The socket's directory is root-owned and only that user can connect; on top
of that every connection is checked against the kernel's SO_PEERCRED uid, so
a mis-set mode cannot widen access. The request cannot name a uid, a path,
or a namespace outside this user's own: the user/uid come from this
process's own arguments, and "namespace" is just which of THIS user's
profile buckets a request names.

The protocol (src/lib/secret-protocol.py) has no list/set/remove operation
that returns a value. exec/status/cancel (src/lib/secret-jobs.py) are the
only ops that ever let a value leave this process, and they hand it to a
worker that is already running as the unprivileged agent user by the time it
sees it - never back to the caller.
"""
import argparse
import os
import pwd
import subprocess
import sys
import threading
import time


def peer_uid(conn):
    cred = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    return struct.unpack("3i", cred)[1]


def drain_request(conn):
    """Read the peer's frame before refusing it. Closing with the request
    still unread resets the connection, so the peer sees EPIPE or ECONNRESET
    instead of the refusal."""
    try:
        recv_frame(conn)
    except (SecretError, OSError):
        pass


class SystemdLauncher(Launcher):
    """Production launcher: a systemd transient service with User=<agent>,
    one per job. `systemd-run --pipe` relays the unit's stdio to this
    process's own pipes, so from JobManager's point of view this behaves
    exactly like DirectLauncher's subprocess.Popen - poll()/kill() apply to
    the systemd-run process, which blocks for the unit's whole lifetime.

    Unproven on this box: there is no root and no KVM here, so this class
    has never been exercised end to end. The OS boundary it is supposed to
    give (uid, cgroup, NoNewPrivileges) is exactly what tests/secrets.nix is
    for; see the issue and the PR description before trusting it in
    production. DirectLauncher is what every unit test in this repository
    actually runs.
    """

    def __init__(self, user, worker_path, python_bin=None):
        self.user = user
        self.worker_path = worker_path
        # None: exec the worker by its own absolute path. It is a generated
        # script with a store-path shebang, so nothing here depends on a
        # bare `python3` being on the PATH of the broker's unit or of the
        # transient job unit - neither of which has one on NixOS.
        self.python_bin = python_bin

    @staticmethod
    def _unit_name(job):
        return f"agent-box-secret-job-{job.id}"

    def start(self, job, argv_or_command, shell, secret_values, nonsecret_env, cwd,
              browser=None):
        frame_bytes = encode_worker_frame(argv_or_command, shell, secret_values,
                                          nonsecret_env, cwd, browser)
        cmd = [
            "systemd-run", "--pipe", "--quiet", "--collect",
            f"--unit={self._unit_name(job)}",
            f"--property=User={self.user}",
            "--property=KillMode=control-group",
            "--property=NoNewPrivileges=yes",
            "--property=PrivateTmp=yes",
            "--property=TimeoutStopSec=5",
            "--",
            *([self.python_bin] if self.python_bin else []), self.worker_path,
        ]
        job.handle = spawn_worker(cmd, frame_bytes)
        return job.handle

    def poll(self, job):
        return job.handle.poll()

    def kill(self, job):
        if job.handle is None:
            return
        subprocess.run(["systemctl", "kill", "--signal=SIGKILL", self._unit_name(job)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            job.handle.kill()
        except OSError:
            pass


class Broker:
    # A profile name is cheap for a CALLER to mint (any string matching
    # PROFILE_NAME_RE), and each new one costs this process a directory, a
    # meta.json, a lock fd and a cached Store with its own open dir_fd. None
    # of that is reclaimed on its own, so without a bound the agent user can
    # exhaust this root process's file descriptors just by asking `list` for
    # enough distinct names. Evicting the least-recently-used Store when the
    # cache is full bounds the descriptors; a profile that is actually in use
    # stays resident because it keeps getting touched. Eviction never deletes
    # anything on disk: the persistent namespaces are bounded separately, by
    # SECRET_MAX_NAMESPACES_PER_USER in Store.
    MAX_OPEN_STORES = 64

    def __init__(self, user, uid, store_root, root_key, job_manager):
        self.user = user
        self.uid = uid
        self.store_root = store_root
        self.root_key = root_key
        self.job_manager = job_manager
        self._stores = {}
        self._stores_lock = threading.Lock()

    def _store(self, profile, create):
        """The cached Store for this profile. With create=False (every op
        but `set`) a namespace that does not exist yet is NOT made: the
        answer is None, so a `list` or `exec` naming an invented profile
        costs nothing on disk and no slot of SECRET_MAX_NAMESPACES_PER_USER.
        """
        # Already validated by validate_request (every request names a
        # concrete profile - see resolve_profile's docstring): "profile" is
        # the namespace, with no further resolution needed here.
        namespace = profile
        with self._stores_lock:
            store = self._stores.pop(namespace, None)
            if store is None:
                if not create and not Store.exists(self.store_root, namespace):
                    return None
                store = Store(self.store_root, namespace, self.user, self.uid, self.root_key)
            self._stores[namespace] = store  # re-insert: most-recently-used
            while len(self._stores) > self.MAX_OPEN_STORES:
                evicted_name = next(iter(self._stores))
                if evicted_name == namespace:
                    break
                self._stores.pop(evicted_name).close()
            return store

    def handle(self, req):
        op = validate_request(req)
        profile = req.get("profile")
        # status/cancel only need the job manager, which keys jobs by the
        # profile name; they never touch the store.
        if op == "status":
            return {"ok": True, **self.job_manager.status(profile, req["jobId"])}
        if op == "cancel":
            return {"ok": True, **self.job_manager.cancel(profile, req["jobId"])}
        # Not save-cookies: its job can still be refused (both job slots
        # busy) or fail, and a namespace made for it would keep one of
        # SECRET_MAX_NAMESPACES_PER_USER forever. Its sink creates the
        # namespace only when it has a validated capture to store.
        store = self._store(profile, create=(op in ("set", "generate")))
        if op in ("list", "set", "remove", "generate"):
            if store is None:
                if op == "list":
                    return {"ok": True, "secrets": []}
                raise SecretError("no such secret")
            return handle_request(store, req)
        if op == "exec":
            # A missing namespace resolves no name, so _dispatch reports
            # "no such secret: NAME" for each; with no secretNames the job
            # simply runs.
            resolve = self._exec_resolver(store)
            job_id = self.job_manager.start(profile, req, resolve)
            return {"ok": True, "jobId": job_id}
        if op in ("fill", "save-cookies", "load-cookies"):
            builtin, resolve = self._browser_job(store, profile, req, op)
            job_id = self.job_manager.start(profile, req, resolve, builtin)
            return {"ok": True, "jobId": job_id}
        raise SecretError("unsupported operation")

    @staticmethod
    def _exec_resolver(store):
        """What exec may inject for a name: the value, a TOTP secret's
        current code (never its seed), and nothing at all for a fill-only
        secret - that one goes only to the fill op, onto its own origins."""
        def resolve(name):
            if store is None:
                return None
            # One record version supplies both the permission and the
            # value, so a concurrent replace cannot pair them up wrong.
            snap = store.snapshot(name)
            if snap is None:
                return None
            meta, value = snap
            if meta["fillOnly"]:
                raise SecretError(f"{name} is fill-only: use fill, not exec")
            if meta["kind"] == "totp":
                return totp_code(value)
            return value
        return resolve

    def _browser_job(self, store, profile, req, op):
        """The fixed worker-side CDP job for one browser op. The origins
        that bound it come from the RECORD (fill, load-cookies) or from the
        request that is about to replace the record (save-cookies) - never
        from the page, which is what the worker checks against them."""
        name = req["name"]
        browser = {"mode": op, "port": req["cdpPort"], "targetId": req.get("targetId")}
        if op == "save-cookies":
            browser["origins"] = list(req["origins"])
            meta = record_meta_from_request(req, kind="cookies")
            return ({"secretNames": [], "browser": browser,
                     "capture": self._cookie_sink(profile, name, meta)}, None)
        # The kind and origins that authorize this job and the value it
        # carries come from ONE record version: a save-cookies finishing in
        # the background must not hand the old record's origin policy a new
        # record's value.
        snap = store.snapshot(name) if store is not None else None
        if snap is None:
            raise SecretError(f"no such secret: {name}")
        meta, value = snap
        if not meta["origins"]:
            raise SecretError(f"{name} has no origins: set it again with --origin")
        if op == "fill" and meta["kind"] == "cookies":
            raise SecretError(f"{name} holds cookies: use load-cookies")
        if op == "load-cookies" and meta["kind"] != "cookies":
            raise SecretError(f"{name} does not hold cookies")
        browser["origins"] = meta["origins"]
        browser["secret"] = name
        if op == "fill":
            browser["selector"] = req["selector"]

        def resolve(asked):
            if asked != name:
                return None
            return totp_code(value) if meta["kind"] == "totp" else value
        return {"secretNames": [name], "browser": browser}, resolve

    def _cookie_sink(self, profile, name, meta):
        """Stores what a save-cookies worker printed. Runs on the job's
        drain thread, so it opens a Store of its own rather than borrow the
        cached one, which the serving thread may evict and close meanwhile."""
        def sink(captured):
            value = captured.decode("utf-8")
            if not valid_secret_value(value):
                raise SecretError("captured cookies are empty or too large to store")
            count = len(parse_cookie_state(value))
            store = Store(self.store_root, profile, self.user, self.uid, self.root_key)
            try:
                version = store.set(name, value, meta)
            finally:
                store.close()
            return f"saved {count} cookies as {name} (v{version})\n"
        return sink


def _safe_send(conn, reply):
    """send_frame itself can refuse (SecretError("response too large")): a
    job's own (already-capped) output plus the JSON metadata can pass
    SECRET_MAX_FRAME, and in the pathological case (every byte a control
    character escapes to \\u00NN, a 6x blow-up) by a lot. A reply that
    carries output is shrunk - halving stdout/stderr and marking them
    truncated - until it fits, so the caller still gets the job's state, its
    exit code and what output fits. Only a reply that cannot be made to fit
    at all becomes a refusal, and that one says ok=false."""
    try:
        send_frame(conn, reply)
        return
    except SecretError:
        pass
    shrunk = dict(reply)
    for _ in range(16):
        for key in ("stdout", "stderr"):
            text = shrunk.get(key)
            if isinstance(text, str) and text:
                shrunk[key] = text[:len(text) // 2]
                shrunk[key + "Truncated"] = True
        try:
            send_frame(conn, shrunk)
            return
        except SecretError:
            continue
    send_frame(conn, {"ok": False,
                      "error": "response too large to return in full",
                      "jobId": reply.get("jobId"), "state": reply.get("state")})


def serve_one(listener, broker, expect_uid):
    try:
        conn, _ = listener.accept()
    except OSError:
        return
    with conn:
        conn.settimeout(10)
        try:
            if peer_uid(conn) != expect_uid:
                drain_request(conn)
                _safe_send(conn, {"ok": False, "error": "forbidden"})
                return
            try:
                reply = broker.handle(recv_frame(conn))
            except SecretError as exc:
                reply = {"ok": False, "error": str(exc)}
            except Exception as exc:  # noqa: BLE001 - see comment below
                # Anything else is a bug in this request's handling, not a
                # reason to take every OTHER connection down with it: this
                # is a long-lived root process serving every session of one
                # user, and "the broker died" means every one of that
                # user's in-flight jobs and secrets becomes unreachable
                # until something restarts it. Never let an unanticipated
                # exception propagate out of one connection.
                reply = {"ok": False, "error": f"internal error: {type(exc).__name__}"}
            _safe_send(conn, reply)
        except (OSError, socket.timeout):
            # A peer that vanished mid-exchange must never stop the broker.
            pass


def _sweeper(job_manager):
    while True:
        time.sleep(300)
        try:
            job_manager.sweep(SECRET_JOB_RETENTION_SECONDS)
        except Exception as exc:  # noqa: BLE001 - a daemon thread must not die silently
            sys.stderr.write(f"agent-box-secret-broker: sweep failed: {exc}\n")


def main():
    # Config is environment, not argv, in production - the unit sets
    # AGENT_BOX_SECRET_USER/_STORE_ROOT/_WORKER_BIN from %i and the
    # contract (see units/agent-box-secret-broker@.service and
    # contract/agent-box-secret-broker.json). Explicit flags remain for
    # direct/test invocation, same pattern as secret-cli.py's --socket.
    parser = argparse.ArgumentParser()
    parser.add_argument("--user", default=os.environ.get("AGENT_BOX_SECRET_USER"))
    parser.add_argument("--uid", type=int, default=None,
                        help="defaults to --user's real uid (pwd.getpwnam); pass this "
                             "explicitly only to test the SO_PEERCRED mismatch path")
    parser.add_argument("--store-root", default=os.environ.get("AGENT_BOX_SECRET_STORE_ROOT"),
                        help="this user's own directory, e.g. /var/lib/agent-box-secrets/<user>")
    parser.add_argument("--root-key-path",
                        help="box-wide key file; defaults beside --store-root's parent")
    parser.add_argument("--worker",
                        default=os.environ.get("AGENT_BOX_SECRET_WORKER_BIN",
                                               "/run/current-system/sw/bin/agent-box-secret-worker"),
                        help="path to the fixed worker executable")
    parser.add_argument("--socket", help="bind this path instead of using systemd's fd 3")
    parser.add_argument("--dev-direct-launcher", action="store_true",
                        help="DEV/TEST ONLY: run jobs with the broker's own uid instead of "
                             "systemd User=<agent>. Refused when this process is root (it would "
                             "execute the workload AS ROOT), and refused unless "
                             "AGENT_BOX_SECRET_BROKER_ALLOW_DEV_LAUNCHER=1 is also set.")
    args = parser.parse_args()

    if not args.user or not args.store_root:
        sys.stderr.write(
            "agent-box-secret-broker: --user and --store-root are required "
            "(directly, or via AGENT_BOX_SECRET_USER/AGENT_BOX_SECRET_STORE_ROOT)\n")
        raise SystemExit(2)
    if args.uid is None:
        try:
            args.uid = pwd.getpwnam(args.user).pw_uid
        except KeyError:
            sys.stderr.write(f"agent-box-secret-broker: no such user: {args.user}\n")
            raise SystemExit(2)

    if args.dev_direct_launcher:
        # Two independent gates, not one: a single stray argv flag (a typo'd
        # unit override, a copy-pasted systemd drop-in) must not be enough
        # to make a production broker run every job as ITS OWN uid instead
        # of dropping to the agent user. The env var is the one a real
        # deployment's unit file never sets.
        if os.getuid() == 0:
            sys.stderr.write(
                "agent-box-secret-broker: --dev-direct-launcher refused while running as root "
                "(it would execute jobs as root, defeating the whole feature)\n")
            raise SystemExit(2)
        if os.environ.get("AGENT_BOX_SECRET_BROKER_ALLOW_DEV_LAUNCHER") != "1":
            sys.stderr.write(
                "agent-box-secret-broker: --dev-direct-launcher also needs "
                "AGENT_BOX_SECRET_BROKER_ALLOW_DEV_LAUNCHER=1 in the environment\n")
            raise SystemExit(2)

    if args.socket:
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        listener.bind(args.socket)
        # fchmod on the fd, not chmod on the path: bind() just created this
        # exact file, so there is nothing left for a path-based chmod to buy
        # and no window for it to be tricked by a symlink planted at that
        # path between the two calls.
        os.fchmod(listener.fileno(), 0o660)
        listener.listen(8)
    elif os.environ.get("LISTEN_FDS") == "1" and os.environ.get("LISTEN_PID") == str(os.getpid()):
        listener = socket.socket(fileno=3)
    else:
        sys.stderr.write("agent-box-secret-broker: no listening socket\n")
        raise SystemExit(2)

    root_key_path = args.root_key_path or os.path.join(
        os.path.dirname(os.path.normpath(args.store_root)), ".rootkey")
    root_key = load_root_key(root_key_path)

    if args.dev_direct_launcher:
        launcher = DirectLauncher(args.worker)
    else:
        launcher = SystemdLauncher(args.user, args.worker)
    job_manager = JobManager(launcher, SECRET_MAX_OUTPUT_BYTES, SECRET_MAX_JOBS_PER_USER)
    threading.Thread(target=_sweeper, args=(job_manager,), daemon=True).start()

    broker = Broker(args.user, args.uid, args.store_root, root_key, job_manager)
    while True:
        serve_one(listener, broker, args.uid)


if __name__ == "__main__":
    main()
