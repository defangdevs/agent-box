[Unit]
Description=EC2 Spot interruption handler for agent-box sessions

[Service]
Environment="AGENT_BOX_GRACE=75"
Environment="AGENT_BOX_MSG=⚠️ SPOT INTERRUPTION: AWS will stop this box within ~2 minutes and this in-memory session will be lost (the box restarts later with the SAME disk, IP, and TLS cert). Save any important working context, decisions, and next steps to disk under your home NOW (e.g. update your MEMORY/notes files) so you can resume after restart."
Environment="AGENT_BOX_POLL=5"
Environment="AGENT_BOX_USERS=agent"
Environment="CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt"
Environment="LOCALE_ARCHIVE=/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-glibc-locales-2.44-57/lib/locale/locale-archive"
Environment="NIX_SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt"
Environment="NODE_OPTIONS=--use-openssl-ca"
Environment="PATH=/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-curl-8.22.0-bin/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-tmux-3.8/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-jq-1.8.2-bin/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-util-linux-2.42.4-bin/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-systemd-262/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-coreutils-9.12/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-coreutils-9.12/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-findutils-4.11.0/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-gnugrep-3.12/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-gnused-4.10/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-systemd-262/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-curl-8.22.0-bin/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-tmux-3.8/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-jq-1.8.2-bin/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-util-linux-2.42.4-bin/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-systemd-262/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-coreutils-9.12/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-coreutils-9.12/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-findutils-4.11.0/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-gnugrep-3.12/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-gnused-4.10/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-systemd-262/sbin"
Environment="REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt"
Environment="SSL_CERT_DIR=/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-agent-box-empty-ca-dir"
Environment="SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt"
Environment="TZDIR=/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-tzdata-2026e/share/zoneinfo"
ExecStart=/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-agent-box-spot-monitor
Restart=on-failure
RestartSec=5s
Type=simple

[Install]
WantedBy=multi-user.target

