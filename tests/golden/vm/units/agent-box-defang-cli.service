[Unit]
After=network-online.target
Description=Install the Defang CLI in the background
Wants=network-online.target

[Service]
Environment="CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt"
Environment="LOCALE_ARCHIVE=/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-glibc-locales-2.44-57/lib/locale/locale-archive"
Environment="NIX_SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt"
Environment="NODE_OPTIONS=--use-openssl-ca"
Environment="PATH=/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-coreutils-9.12/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-findutils-4.11.0/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-gnugrep-3.12/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-gnused-4.10/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-systemd-262/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-coreutils-9.12/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-findutils-4.11.0/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-gnugrep-3.12/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-gnused-4.10/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-systemd-262/sbin"
Environment="REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt"
Environment="SSL_CERT_DIR=/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-agent-box-empty-ca-dir"
Environment="SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt"
Environment="TZDIR=/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-tzdata-2026e/share/zoneinfo"
ExecStart=/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-unit-script-agent-box-defang-cli-start/bin/agent-box-defang-cli-start 
IOSchedulingClass=idle
MemoryMax=1536M
Nice=19
OOMScoreAdjust=1000
Restart=on-failure
RestartSec=30s
StartLimitBurst=5
StartLimitIntervalSec=10min
Type=oneshot

[Install]
WantedBy=multi-user.target

# X-Golden-wantedBy: multi-user.target
