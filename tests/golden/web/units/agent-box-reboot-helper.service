[Unit]
Description=agent-box: disk-independent reboot helper

[Service]
Environment="AGENT_BOX_REBOOT_PIN_UNITS=caddy.service agent-box-settings@agent.service"
Environment="AGENT_BOX_REBOOT_SOCKET=/run/agent-box-reboot/reboot.sock"
Environment="AGENT_BOX_REBOOT_USER=agent"
Environment="CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt"
Environment="LOCALE_ARCHIVE=/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-glibc-locales-2.42-84/lib/locale/locale-archive"
Environment="NIX_SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt"
Environment="NODE_OPTIONS=--use-openssl-ca"
Environment="PATH=/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-coreutils-9.11/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-findutils-4.11.0/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-gnugrep-3.12/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-gnused-4.10/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-systemd-261.2/bin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-coreutils-9.11/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-findutils-4.11.0/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-gnugrep-3.12/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-gnused-4.10/sbin:/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-systemd-261.2/sbin"
Environment="REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt"
Environment="SSL_CERT_DIR=/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-agent-box-empty-ca-dir"
Environment="SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt"
Environment="TZDIR=/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-tzdata-2026c/share/zoneinfo"
ExecStart=/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-agent-box-reboot-helper/bin/agent-box-reboot-helper
LimitMEMLOCK=infinity
OOMScoreAdjust=-900
Restart=always
RestartSec=5s
RuntimeDirectory=agent-box-reboot
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target

# X-Golden-wantedBy: multi-user.target
