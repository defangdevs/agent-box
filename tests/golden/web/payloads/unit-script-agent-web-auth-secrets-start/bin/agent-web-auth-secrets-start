#!/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-bash-5.3p9/bin/bash
set -e

set -euo pipefail
umask 077
tmp="$(mktemp /run/agent-box-web/env.XXXXXX)"
if [ ! -s /var/lib/agent-box-web/cookie-secret-agent ]; then
  openssl rand -hex 32 > /var/lib/agent-box-web/cookie-secret-agent
fi
hash="$(cat /var/lib/agent-box-web/password-hash-agent)"
case "$hash" in
  '$argon2id$'*) algorithm=argon2id ;;
  '$2a$'*|'$2b$'*|'$2y$'*) algorithm=bcrypt ;;
  *) echo "unsupported password hash for agent" >&2; exit 1 ;;
esac
{
  printf 'WEB_COOKIE_SECRET_AGENT=%s\n' "$(cat /var/lib/agent-box-web/cookie-secret-agent)"
  printf 'WEB_PASSWORD_ALGORITHM_AGENT=%s\n' "$algorithm"
  printf 'WEB_PASSWORD_HASH_AGENT=%s\n' "$hash"
} >> "$tmp"
if [ ! -s /var/lib/agent-box-web/cookie-secret-robot ]; then
  openssl rand -hex 32 > /var/lib/agent-box-web/cookie-secret-robot
fi
hash="$(cat /var/lib/agent-box-web/password-hash-robot)"
case "$hash" in
  '$argon2id$'*) algorithm=argon2id ;;
  '$2a$'*|'$2b$'*|'$2y$'*) algorithm=bcrypt ;;
  *) echo "unsupported password hash for robot" >&2; exit 1 ;;
esac
{
  printf 'WEB_COOKIE_SECRET_ROBOT=%s\n' "$(cat /var/lib/agent-box-web/cookie-secret-robot)"
  printf 'WEB_PASSWORD_ALGORITHM_ROBOT=%s\n' "$algorithm"
  printf 'WEB_PASSWORD_HASH_ROBOT=%s\n' "$hash"
} >> "$tmp"
chmod 0600 "$tmp"
mv "$tmp" /run/agent-box-web/env


